---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import {site} from '../data/site';

const {title,description,image='/images/social-card.jpg',schema=[]}=Astro.props;
const canonical=new URL(Astro.url.pathname,site.url);
const schemas=Array.isArray(schema)?schema:[schema];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    <link rel="icon" href="/favicon.png">
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={new URL(image,site.url)}>
    <meta name="twitter:card" content="summary_large_image">
    {schemas.filter(Boolean).map((s)=><script type="application/ld+json" is:inline set:html={JSON.stringify(s)}></script>)}
  </head>
  <body>
    <div class="seasonal-banner" data-holiday-banner hidden aria-label="Holiday entertainment announcement">
      Planning a holiday party? Four Dogs + Santa Jim can entertain the whole crowd. <a href="/christmas/">Explore holiday entertainment →</a>
    </div>
    <Header/>
    <main id="main"><slot/></main>
    <Footer/>
    <script is:inline>
      (() => {
        const now = new Date();

        const banner = document.querySelector('[data-holiday-banner]');
        if (banner) {
          const month = now.getMonth();
          if (month >= 8 && month <= 11) banner.hidden = false;
        }

        const parts = new Intl.DateTimeFormat('en-US', {
          timeZone: 'America/New_York',
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
        }).formatToParts(now);
        const part = (type) => parts.find((item) => item.type === type)?.value ?? '';
        const today = `${part('year')}-${part('month')}-${part('day')}`;

        document.querySelectorAll('[data-event-date]').forEach((item) => {
          const date = item.getAttribute('data-event-date');
          if (date && date < today) item.hidden = true;
        });

        document.querySelectorAll('[data-event-list]').forEach((list) => {
          const max = Number(list.getAttribute('data-max-visible') || 0);
          if (!max) return;
          const visible = Array.from(list.querySelectorAll('[data-event-date]')).filter((item) => !item.hidden);
          visible.slice(max).forEach((item) => { item.hidden = true; });
        });
      })();
    </script>
  </body>
</html>
