---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PackPopup from '../components/PackPopup.astro';
import '../styles/global.css';
import '../styles/premium-motion.css';
import {site} from '../data/site';

const {title,description,image='/images/social-card-statewide.jpg',schema=[],noindex=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,site.url);
const schemas=Array.isArray(schema)?schema:[schema];
const slickTextTag = `<!-- Begin SlickText Tag -->
<script>
window.sTagConfig = window.sTagConfig || [];
function sTag(){window.sTagConfig.push(arguments);}
sTag('bid', 36547);
sTag('bsk', 'c0409dfadbd35f6b3a29a58ad4257e92');
</script>
<script async src="https://static.slicktext.com/s-tag/init.js" type="module"></script>
<!-- End SlickText Tag -->`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    {noindex && <meta name="robots" content="noindex,follow"/>}
    <link rel="canonical" href={canonical}>
    <link rel="icon" href="/favicon.png">
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={new URL(image,site.url)}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Four Dogs Entertainment based in South Carolina and serving South Carolina, North Carolina, and Georgia">
    <meta name="twitter:image" content={new URL(image,site.url)}>
    <meta name="twitter:card" content="summary_large_image">
    {schemas.filter(Boolean).map((s)=><script type="application/ld+json" is:inline set:html={JSON.stringify(s).replace(/</g, '\\u003c')}></script>)}
  </head>
  <body class:list={{'event-surface': Astro.url.pathname.startsWith('/events/')}}>
    <div class="seasonal-banner" data-holiday-banner hidden aria-label="Holiday entertainment announcement">
      Planning a holiday party? Four Dogs + Santa Jim can entertain the whole crowd. <a href="/christmas/">Explore holiday entertainment →</a>
    </div>
    <Header/>
    <main id="main"><slot/></main>
    <Footer/>
    <script src="../scripts/action-tracking.ts"></script>
    <script src="../scripts/premium-motion.ts"></script>
    <PackPopup/>
    <script is:inline>
      (() => {
        const now = new Date();

        const banner = document.querySelector('[data-holiday-banner]');
        if (banner) {
          const month = now.getMonth();
          if (month >= 8 && month <= 11) banner.hidden = false;
        }


      })();
    </script>
    <Fragment set:html={slickTextTag} />
  </body>
</html>
