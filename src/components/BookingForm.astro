---
import {services} from '../data/services';
import { site } from '../data/site';
---
<form name="booking" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field">
  <input type="hidden" name="form-name" value="booking">
  <input type="hidden" name="entry-channel">
  <input type="hidden" name="entry-page">
  <input type="hidden" name="entry-referrer">
  <input type="hidden" name="utm-source"><input type="hidden" name="utm-medium">
  <input type="hidden" name="utm-campaign"><input type="hidden" name="utm-content">
  <input type="hidden" name="utm-term"><input type="hidden" name="inquiry-id">
  <input type="hidden" name="test-inquiry">
  <p hidden><label>Don’t fill this out: <input name="bot-field"></label></p>

  <div class="booking-progress" hidden>
    <label for="booking-progress">Booking inquiry progress</label>
    <progress id="booking-progress" max="3" value="0" aria-describedby="booking-progress-note"></progress>
    <p id="booking-progress-note" class="fine">Fill in the required details to send your inquiry. Everything else is optional.</p>
  </div>

  <div class="form-grid">
    <label class="wide">What are you planning? (required)
      <select id="service" name="service" required>
        <option value="">Choose one</option>
        <optgroup label="What you’re planning">
          {services.filter(s => ['weddings','private-corporate-events'].includes(s.slug)).map(s => <option value={s.bookingValue} data-service-slug={s.slug}>{s.slug==='weddings' ? 'Wedding' : 'Private celebration'}</option>)}
          <option value="DJ">DJ entertainment</option>
          <option value="Corporate Event">Company or organization event</option>
          <option value="Venue Entertainment">Weekly venue partnership</option>
          <option>Community Awareness Night</option>
          <option>Christmas / Holiday Entertainment</option>
          <option>Other entertainment inquiry</option>
        </optgroup>
        <optgroup label="A specific entertainment service">
          {services.filter(s => !['weddings','private-corporate-events'].includes(s.slug)).map(s => <option value={s.bookingValue} data-service-slug={s.slug}>{s.bookingValue}</option>)}
        </optgroup>
      </select>
    </label>
    </div>
  <fieldset class="booking-group"><legend>Your contact details</legend><div class="form-grid">
    <label>Name (required) <input name="name" autocomplete="name" required></label>
    <label>Email (required) <input name="email" type="email" autocomplete="email" required></label>
    <label>Preferred contact method
      <select name="contact-method"><option>Email</option><option>Phone call</option><option>Text message</option></select>
    </label>
    <label><span id="phone-label">Phone (optional)</span><input name="phone" type="tel" autocomplete="tel"></label>
  </div></fieldset>
  <details class="booking-optional">
    <summary>Add event details (optional)</summary>
    <fieldset class="booking-group"><legend id="inquiry-heading">Event details</legend><div class="form-grid">
      <label><span id="date-label">Preferred date</span> <input id="preferred-date" name="preferred-date" type="date"></label>
      <label class="wide">Venue / location <input name="venue-location"></label>
      <label data-recurring>Recurring event?
        <select name="recurring"><option value="">Choose if known</option><option>No</option><option>Yes</option><option>Not sure</option></select>
      </label>
      <fieldset class="wide venue-partnership-fields" data-venue-partnership hidden disabled>
        <legend>Weekly venue partnership</legend>
        <p class="fine">A few details will help us shape a recurring plan. No quote or commitment is needed.</p>
        <label>Preferred night
          <select name="preferred-weeknight">
            <option value="">Choose if known</option>
            <option>Monday</option><option>Tuesday</option><option>Wednesday</option><option>Thursday</option><option>Friday</option><option>Saturday</option><option>Flexible</option>
          </select>
        </label>
        <label>What entertainment or recurring events do you already offer?
          <textarea name="existing-programming" rows="2" placeholder="Share the nights, formats, or providers already on your calendar."></textarea>
        </label>
        <label>What would you like a weekly event to help with?
          <select name="venue-business-goal">
            <option value="">Choose if helpful</option>
            <option>Give guests a reason to return on a quieter night</option>
            <option>Build a consistent weekly event</option>
            <option>Reach a new audience</option>
            <option>Add variety to current programming</option>
            <option>Improve awareness of our event calendar</option>
            <option>Other or not sure yet</option>
          </select>
        </label>
      </fieldset>
      <label data-guests>Guest count <input name="guest-count" type="number" min="1"></label>
      <label>City <input name="city" autocomplete="address-level2"></label>
      <label>State <input name="state" placeholder="e.g. SC" autocomplete="address-level1"></label>
      <label class="wide checkbox-row" id="holiday-interest" hidden>
        <input type="checkbox" aria-controls="holiday-options"> This is a holiday party
      </label>
      <fieldset id="holiday-options" class="holiday-options">
        <legend>Holiday Add-On</legend>
        <p>Planning a holiday-season event? Santa Jim can be paired with Four Dogs entertainment so one event can work for families, coworkers, neighbors, and mixed-age groups.</p>
        <label class="checkbox-row">
          <input type="checkbox" name="santa-jim-interest" value="Interested in Santa Jim">
          <span>I’m interested in adding a traditional real-beard Santa appearance with Santa Jim.</span>
        </label>
        <label data-children>Will children be attending?
          <select name="children-attending">
            <option value="">Choose one if helpful</option>
            <option>Yes</option>
            <option>No</option>
            <option>Not sure</option>
          </select>
        </label>
        <p class="fine"><a href="/christmas/">See how Four Dogs + Santa Jim can work together for a holiday event →</a></p>
      </fieldset>

      <label class="wide"><span id="inquiry-prompt">What do you have in mind?</span><textarea name="event-details" rows="3"></textarea></label>
      <label class="wide">How did you hear about Four Dogs?
        <select name="referral-source">
          <option value="">Choose one if you’d like</option>
          <option>Google</option>
          <option>ChatGPT / AI Search</option>
          <option>Facebook</option>
          <option>Instagram</option>
          <option>A Four Dogs Event</option>
          <option>Referral</option>
          <option>Venue / Restaurant</option>
          <option>Other</option>
        </select>
      </label>

    </div></fieldset>
  </details>

  <button class="button" type="submit">Send booking request</button>
  <p class="form-state" role="status" aria-live="polite"></p>
  <button type="button" class="field-jump" hidden>Go to the first field to fix</button>
  <p class="fine">Submitting this form starts a conversation. It does not confirm a booking.</p>
  <p class="fine">Prefer to email us directly? <a href={`mailto:${site.bookingEmail}`}>{site.bookingEmail}</a></p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('form[name="booking"]')!;
  const service = form.querySelector<HTMLSelectElement>('#service')!;
  const holiday = form.querySelector<HTMLFieldSetElement>('#holiday-options')!;
  const holidayInterest = form.querySelector<HTMLInputElement>('#holiday-interest input')!;
  const santa = holiday.querySelector<HTMLInputElement>('[name="santa-jim-interest"]')!;
  const recurring = form.querySelector<HTMLSelectElement>('[name="recurring"]')!;
  const guests = form.querySelector<HTMLInputElement>('[name="guest-count"]')!;
  const venueFields = form.querySelector<HTMLFieldSetElement>('[data-venue-partnership]')!;
  const children = form.querySelector<HTMLSelectElement>('[name="children-attending"]')!;
  const requested = new URLSearchParams(location.search).get('service');
  const choice = [...service.options].find(option => option.value === requested || option.dataset.serviceSlug === requested);
  if (choice && !service.value) service.value = choice.value;

  function showField(control: HTMLInputElement | HTMLSelectElement, visible: boolean) {
    control.closest('label')!.hidden = !visible;
    control.disabled = !visible;
  }

  const phone = form.querySelector<HTMLInputElement>('[name="phone"]')!;
  const date = form.querySelector<HTMLInputElement>('#preferred-date')!;
  const contact = form.querySelector<HTMLSelectElement>('[name="contact-method"]')!;
  const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const state = form.querySelector<HTMLElement>('.form-state')!;
  const contexts: Record<string, [string,string]> = {
    'Wedding DJ / Entertainment': ['Your wedding','Which parts of the day would you like music or hosting for?'],
    'DJ': ['Your DJ inquiry','What kind of party are you planning, and where will we set up?'],
    'Corporate Event': ['Your company event','Who’s coming, and what are you planning for the group?'],
    'Private Event': ['Your celebration','What are you celebrating, and what would your guests enjoy?'],
    'Venue Entertainment': ['Your venue','Anything else we should know about your room or your regulars?'],
  };
  function sync() {
    const venue = service.value === 'Venue Entertainment';
    const canOptIn = ['Private Event', 'Corporate Event'].includes(service.value);
    const [heading, prompt] = contexts[service.value] || ['Event details','What do you have in mind?'];
    form.querySelector('#inquiry-heading')!.textContent = heading;
    form.querySelector('#inquiry-prompt')!.textContent = prompt;
    form.querySelector('#date-label')!.textContent = service.value === 'Wedding DJ / Entertainment' ? 'Wedding date, if known' : 'Preferred date';
    phone.required = ['Phone call','Text message'].includes(contact.value);
    form.querySelector('#phone-label')!.textContent = phone.required ? 'Phone (required for a call or text)' : 'Phone (optional)';
    showField(date, !venue);
    venueFields.hidden = !venue;
    venueFields.disabled = !venue;
    showField(holidayInterest, canOptIn);
    const isHoliday = service.value === 'Christmas / Holiday Entertainment' || (canOptIn && holidayInterest.checked);
    showField(recurring, ['Trivia', 'Music Bingo', 'Karaoke', 'Four Dogs Survey Showdown', 'Are You Smarter Than a Barstool?'].includes(service.value));
    showField(guests, !!service.value && !venue);
    holiday.hidden = !isHoliday;
    holiday.disabled = !isHoliday;
    showField(children, isHoliday && santa.checked);
  }

  form.addEventListener('change', sync);
  const name = form.querySelector<HTMLInputElement>('[name="name"]')!;
  function validateName() {
    name.setCustomValidity(name.value && !name.value.trim() ? 'Enter your name.' : '');
  }
  name.addEventListener('input', validateName);
  const validatePhone = () => phone.setCustomValidity(phone.required && !phone.value.trim() ? 'Enter a phone number so we can contact you.' : '');
  form.addEventListener('input', validatePhone);
  form.addEventListener('change', validatePhone);
  const jump = form.querySelector<HTMLButtonElement>('.field-jump')!;
  jump.addEventListener('click', () => {
    const field = form.querySelector<HTMLElement>('[aria-invalid="true"]');
    const disclosure = field?.closest('details');
    if (disclosure) disclosure.open = true;
    field?.focus();
  });
  function updateFieldError(field: HTMLInputElement | HTMLSelectElement) {
    const errorId = `booking-error-${field.name}`;
    const error = document.getElementById(errorId);
    const descriptions = (field.getAttribute('aria-describedby') || '').split(/\s+/)
      .filter(id => id && id !== errorId);
    if (!field.willValidate || field.validity.valid) {
      error?.remove();
      field.removeAttribute('aria-invalid');
      if (descriptions.length) field.setAttribute('aria-describedby', descriptions.join(' '));
      else field.removeAttribute('aria-describedby');
      return;
    }
    const message = error || document.createElement('span');
    message.id = errorId;
    message.className = 'field-error';
    // Referenced descriptions are announced separately from the enclosing label.
    message.setAttribute('aria-hidden', 'true');
    message.textContent = field.validationMessage;
    if (!error) field.closest('label')?.append(message);
    field.setAttribute('aria-invalid', 'true');
    field.setAttribute('aria-describedby', [...descriptions, errorId].join(' '));
  }
  form.addEventListener('invalid', event => {
    const field = event.target;
    if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement) {
      const disclosure = field.closest('details');
      if (disclosure) disclosure.open = true;
      updateFieldError(field);
      jump.hidden = false;
      state.dataset.validation = 'true';
      state.textContent = 'Check the highlighted fields before sending.';
    }
  }, true);
  function refreshErrors() {
    form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[aria-invalid="true"]').forEach(updateFieldError);
    jump.hidden = !form.querySelector('[aria-invalid="true"]');
    if (jump.hidden && state.dataset.validation) {
      state.textContent = '';
      delete state.dataset.validation;
    }
  }
  form.addEventListener('input', refreshErrors);
  form.addEventListener('change', refreshErrors);
  form.addEventListener('submit', async event => {
    event.preventDefault();
    if (submit.disabled) return;
    const body = new URLSearchParams();
    for (const [key,value] of new FormData(form)) if (typeof value === 'string') body.append(key,value.trim());
    submit.disabled = true;
    submit.textContent = 'Sending…';
    state.textContent = 'Sending your inquiry.';
    const controller = new AbortController();
    const timer = window.setTimeout(() => controller.abort(),20000);
    try {
      const response = await fetch(form.action, {method:'POST',body,signal:controller.signal});
      if (!response.ok) throw new Error('Submission was not confirmed');
      window.dispatchEvent(new Event('fourdogs:booking-accepted'));
      window.location.assign(form.action);
    } catch {
      state.textContent = 'We couldn’t confirm receipt. Your details are still here. You can try again or email us below.';
      submit.disabled = false;
      submit.textContent = 'Try sending again';
    } finally {
      clearTimeout(timer);
    }
  });
  window.addEventListener('pageshow', () => {
    submit.disabled = false;
    submit.textContent = 'Send booking request';
    state.textContent = '';
    validateName();
  });
  window.addEventListener('pageshow', () => {
    sync();
    validatePhone();
    refreshErrors();
  });
  const progressGroup = form.querySelector<HTMLElement>('.booking-progress')!;
  const progress = form.querySelector<HTMLProgressElement>('#booking-progress')!;
  const progressNote = form.querySelector<HTMLElement>('#booking-progress-note')!;
  function updateProgress() {
    const required = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input[required], select[required]')]
      .filter(field => !field.disabled && field.willValidate);
    const completed = required.filter(field => field.value.trim() !== '' && field.validity.valid).length;
    progress.max = Math.max(required.length, 1);
    progress.value = completed;
    progressNote.textContent = completed === required.length
      ? 'Required details ready. Add anything else you would like us to know, then send your request.'
      : completed + ' of ' + required.length + ' required details ready. Other fields are optional.';
    progressGroup.hidden = false;
  }
  form.addEventListener('input', updateProgress);
  form.addEventListener('change', updateProgress);
  window.addEventListener('pageshow', updateProgress);
  sync();
  validateName();
  validatePhone();
  updateProgress();
</script>

<style>
  :global(.field-error) { color:#852b18; font-weight:600; font-size:.9rem; }
  .field-jump { min-height:var(--fd-target); background:transparent; color:var(--navy); text-decoration:underline; border:0; cursor:pointer; font:inherit; }
  .field-jump[hidden] { display:none; }
  .booking-progress { margin-bottom: 1.25rem; }
  .booking-progress label { display: block; font-weight: 700; }
  .booking-progress progress { display: block; width: 100%; height: 0.75rem; margin: .5rem 0; }
  .booking-progress .fine { margin-top: .25rem; }
  .booking-optional { margin-bottom:1rem; }
  .booking-optional summary { padding-block: .8rem; text-decoration: underline; }
  .booking-optional[open] summary { margin-bottom: .65rem; }
  [hidden] { display: none !important; }
</style>
