---
import {services} from '../data/services';
---
<form name="booking" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field"><input type="hidden" name="form-name" value="booking"><p hidden><label>Don’t fill this out: <input name="bot-field"></label></p><div class="form-grid"><label>Name <input name="name" autocomplete="name" required></label><label>Phone <input name="phone" type="tel" autocomplete="tel" required></label><label>Email <input name="email" type="email" autocomplete="email" required></label><label>Preferred date <input name="preferred-date" type="date"></label><label>Service <select id="service" name="service" required><option value="">Choose one</option>{services.map(s=><option value={s.bookingValue} data-service-slug={s.slug}>{s.bookingValue}</option>)}<option>Corporate Event</option><option>Venue Entertainment</option><option>Christmas / Holiday Entertainment</option></select></label><label>City <input name="city" autocomplete="address-level2"></label><label>State <input name="state" value="SC" autocomplete="address-level1"></label><label>Guest count <input name="guest-count" type="number" min="1"></label><label>Recurring event? <select name="recurring"><option>No</option><option>Yes</option><option>Not sure</option></select></label><label>Preferred contact method <select name="contact-method"><option>Email</option><option>Phone call</option><option>Text message</option></select></label><label class="wide">Venue / location <input name="venue-location"></label><label class="wide">How did you hear about Four Dogs? <select name="referral-source"><option>Google</option><option>ChatGPT / AI Search</option><option>Facebook</option><option>Instagram</option><option>A Four Dogs Event</option><option>Referral</option><option>Venue / Restaurant</option><option>Other</option></select></label><label class="wide">Event details <textarea name="event-details" rows="6"></textarea></label></div><button class="button" type="submit">Send booking request</button><p class="fine">Submitting this form starts a conversation—it does not confirm a booking.</p></form>
<script>const p=new URLSearchParams(location.search).get('service');const s=document.querySelector<HTMLSelectElement>('#service');if(p&&s&&[...s.options].some(o=>o.value===p||o.dataset.serviceSlug===p)){const option=[...s.options].find(o=>o.value===p||o.dataset.serviceSlug===p);if(option)s.value=option.value;}</script>
