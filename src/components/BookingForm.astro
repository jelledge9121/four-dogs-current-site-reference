---
import {services} from '../data/services';
---
<form name="booking" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field">
  <input type="hidden" name="form-name" value="booking">
  <p hidden><label>Don’t fill this out: <input name="bot-field"></label></p>

  <div class="form-grid">
    <label>Name <input name="name" autocomplete="name" required></label>
    <label>Phone <input name="phone" type="tel" autocomplete="tel" required></label>
    <label>Email <input name="email" type="email" autocomplete="email" required></label>
    <label>Preferred date <input id="preferred-date" name="preferred-date" type="date"></label>
    <label>Service
      <select id="service" name="service" required>
        <option value="">Choose one</option>
        {services.map(s=><option value={s.bookingValue} data-service-slug={s.slug}>{s.bookingValue}</option>)}
        <option>Corporate Event</option>
        <option>Venue Entertainment</option>
        <option>Christmas / Holiday Entertainment</option>
      </select>
    </label>
    <label>City <input name="city" autocomplete="address-level2"></label>
    <label>State <input name="state" value="SC" autocomplete="address-level1"></label>
    <label>Guest count <input name="guest-count" type="number" min="1"></label>
    <label>Recurring event?
      <select name="recurring"><option>No</option><option>Yes</option><option>Not sure</option></select>
    </label>
    <label>Preferred contact method
      <select name="contact-method"><option>Email</option><option>Phone call</option><option>Text message</option></select>
    </label>
    <label class="wide">Venue / location <input name="venue-location"></label>

    <fieldset id="holiday-options" class="holiday-options" hidden>
      <legend>Holiday Add-On</legend>
      <p>Planning a holiday-season event? Santa Jim can be paired with Four Dogs entertainment so one event can work for families, coworkers, neighbors, and mixed-age groups.</p>
      <label class="checkbox-row">
        <input type="checkbox" name="santa-jim-interest" value="Interested in Santa Jim">
        <span>I’m interested in adding a traditional real-beard Santa appearance with Santa Jim.</span>
      </label>
      <label>Will children be attending?
        <select name="children-attending">
          <option value="">Choose one if helpful</option>
          <option>Yes</option>
          <option>No</option>
          <option>Not sure</option>
        </select>
      </label>
      <p class="fine"><a href="/christmas/">See how Four Dogs + Santa Jim can work together for a holiday event →</a></p>
    </fieldset>

    <label class="wide">How did you hear about Four Dogs?
      <select name="referral-source">
        <option>Google</option>
        <option>ChatGPT / AI Search</option>
        <option>Facebook</option>
        <option>Instagram</option>
        <option>A Four Dogs Event</option>
        <option>Referral</option>
        <option>Venue / Restaurant</option>
        <option>Other</option>
      </select>
    </label>
    <label class="wide">Event details <textarea name="event-details" rows="6"></textarea></label>
  </div>

  <button class="button" type="submit">Send booking request</button>
  <p class="fine">Submitting this form starts a conversation. It does not confirm a booking.</p>
</form>

<script>
  const p = new URLSearchParams(location.search).get('service');
  const service = document.querySelector<HTMLSelectElement>('#service');
  const date = document.querySelector<HTMLInputElement>('#preferred-date');
  const holidayOptions = document.querySelector<HTMLElement>('#holiday-options');

  if (p && service && [...service.options].some((o) => o.value === p || o.dataset.serviceSlug === p)) {
    const option = [...service.options].find((o) => o.value === p || o.dataset.serviceSlug === p);
    if (option) service.value = option.value;
  }

  const syncHolidayOptions = () => {
    if (!service || !holidayOptions) return;
    const holidayService = /christmas|holiday|corporate|private|dj/i.test(service.value);
    const month = date?.value ? Number(date.value.split('-')[1]) : 0;
    const holidayDate = month >= 9 && month <= 12;
    holidayOptions.hidden = !(holidayService || holidayDate);
  };

  service?.addEventListener('change', syncHolidayOptions);
  date?.addEventListener('change', syncHolidayOptions);
  syncHolidayOptions();
</script>
