<div class="pack-popup-overlay" data-pack-popup hidden>
  <section class="pack-popup-card" role="dialog" aria-modal="true" aria-labelledby="pack-popup-title" aria-describedby="pack-popup-description">
    <button class="pack-popup-close" type="button" data-pack-popup-close aria-label="Close text updates pop-up">×</button>
    <img class="pack-popup-logo" src="/images/logo.png" width="190" height="190" alt="Four Dogs Entertainment" loading="lazy" />
    <h2 id="pack-popup-title" class="pack-popup-heading"><span>JOIN</span> <span>THE PACK</span></h2>
    <div class="pack-popup-bubble">
      <p class="pack-popup-instruction">Text <strong>PACK</strong> to</p>
      <a class="pack-popup-phone" data-pack-sms href="sms:+18336315496?body=PACK" aria-label="Text PACK to 833 631 5496">833-631-5496</a>
      <a class="pack-popup-action" data-pack-sms href="sms:+18336315496?body=PACK">Open text message →</a>
    </div>
    <p id="pack-popup-description" class="pack-popup-benefits">
      <span>Event updates</span><i aria-hidden="true"></i><span>Giveaways</span><i aria-hidden="true"></i><span>Special alerts</span>
    </p>
    <p class="pack-popup-disclosure">Recurring promotional texts. Message and data rates may apply. Reply STOP to unsubscribe.</p>
    <button class="pack-popup-later" type="button" data-pack-popup-close>No thanks, maybe later</button>
  </section>
</div>

<style>
  .pack-popup-overlay[hidden] { display: none !important; }
  .pack-popup-overlay { position: fixed; inset: 0; z-index: 5000; display: grid; place-items: center; background: rgba(1, 8, 24, .82); padding: 16px; backdrop-filter: blur(5px); }
  .pack-popup-card { position: relative; isolation: isolate; display: flex; flex-direction: column; align-items: center; width: min(100%, 560px); max-height: calc(100dvh - 32px); overflow-y: auto; overscroll-behavior: contain; padding: 20px 28px 24px; border: 2px solid rgba(41, 196, 220, .4); border-radius: 22px; box-shadow: 0 26px 85px rgba(0, 0, 0, .55); color: #f2f0e8; background: #0c0f26; text-align: center; }
  .pack-popup-card::before { content: ''; position: absolute; z-index: -1; width: 340px; height: 340px; top: -165px; left: calc(50% - 170px); border: 3px solid rgba(41, 196, 220, .17); border-radius: 50%; pointer-events: none; }
  .pack-popup-close { align-self: flex-end; flex: 0 0 auto; display: grid; place-items: center; width: 44px; height: 44px; padding: 0; margin: -10px -14px -16px 0; border: 0; border-radius: 50%; background: rgba(255, 255, 255, .12); color: white; cursor: pointer; font: 400 32px/1 Arial, sans-serif; }
  .pack-popup-close:hover, .pack-popup-close:focus-visible { background: rgba(255, 255, 255, .22); }
  .pack-popup-logo { display: block; flex: 0 0 auto; object-fit: contain; width: min(175px, 44vw); height: auto; max-height: 168px; margin: 0 auto 10px; }
  .pack-popup-heading { font-family: Impact, 'Arial Narrow', 'Arial Black', system-ui, sans-serif; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; column-gap: .2em; font-size: clamp(2.5rem, 7vw, 4.4rem); letter-spacing: -.02em; line-height: 1.05; text-transform: uppercase; margin: 2px 0 18px; font-weight: 900; }
  .pack-popup-heading span:first-child { color: #f2f0e8; }
  .pack-popup-heading span:last-child { color: #29c4dc; }
  .pack-popup-bubble { width: 100%; padding: 17px 14px 18px; border-radius: 26px; background: #29c4dc; color: #08152b; }
  .pack-popup-instruction { font-family: Impact, 'Arial Narrow', 'Arial Black', system-ui, sans-serif; margin: 0 0 3px; font-size: clamp(1.7rem, 5vw, 2.9rem); font-weight: 900; line-height: 1.16; }
  .pack-popup-instruction strong { color: #f2f0e8; -webkit-text-stroke: 1px #0c0f26; text-shadow: 2px 2px 0 #0c0f26; }
  .pack-popup-phone { display: block; width: fit-content; max-width: 100%; margin: 0 auto; font-family: Impact, 'Arial Narrow', 'Arial Black', system-ui, sans-serif; font-size: clamp(1.85rem, 7vw, 3.1rem); font-weight: 900; line-height: 1.2; letter-spacing: -.025em; white-space: nowrap; color: #f2f0e8; text-decoration: none; -webkit-text-stroke: 1.2px #0c0f26; text-shadow: 2px 3px 0 #0c0f26, -2px -1px 0 #0c0f26; }
  .pack-popup-action { display: inline-block; margin-top: 14px; padding: 10px 20px; border-radius: 999px; background: #0c0f26; color: #f2f0e8; font-size: .94rem; font-weight: 800; line-height: 1.2; text-decoration: none; }
  .pack-popup-action:hover, .pack-popup-action:focus-visible { background: #1b3150; color: white; }
  .pack-popup-benefits { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px 12px; margin: 19px 0 7px; font-size: clamp(.88rem, 2.4vw, 1.08rem); font-weight: 800; line-height: 1.25; }
  .pack-popup-benefits i { display: block; width: 8px; height: 8px; background: #29c4dc; border-radius: 50%; }
  .pack-popup-disclosure { margin: 9px 0 0; max-width: 425px; font-size: .74rem; color: #d2d9e4; line-height: 1.45; }
  .pack-popup-later { margin-top: 14px; padding: 7px 12px; border: 0; border-radius: 6px; background: transparent; color: #cad7e4; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; font: 600 .78rem/1.3 system-ui, sans-serif; }
  .pack-popup-later:hover { color: #fff; }
  @media (max-width: 480px) {
    .pack-popup-overlay { padding: 10px; }
    .pack-popup-card { max-height: calc(100dvh - 20px); border-radius: 15px; padding: 12px 15px 15px; }
    .pack-popup-close { margin: -4px -7px -10px 0; width: 40px; height: 40px; }
    .pack-popup-logo { width: min(136px, 40vw); max-height: 136px; margin-bottom: 5px; }
    .pack-popup-heading { margin-bottom: 14px; font-size: clamp(2.3rem, 10.5vw, 3.2rem); }
    .pack-popup-bubble { padding: 14px 7px 16px; border-radius: 20px; }
    .pack-popup-instruction { font-size: clamp(1.8rem, 7.4vw, 2.45rem); }
    .pack-popup-phone { font-size: clamp(1.75rem, 8.25vw, 2.7rem); }
    .pack-popup-benefits { gap: 7px 9px; margin-top: 16px; }
    .pack-popup-disclosure { font-size: .7rem; }
  }
</style>

<script is:inline>
  (() => {
    const overlay = document.querySelector('[data-pack-popup]');
    if (!overlay) return;
    // Skip checkout/confirmation pages and limit the interruption to once every seven days.
    const pathname = window.location.pathname;
    if (/^\/(booking|thank-you)(\/|$)/.test(pathname)) return;
    const key = 'four-dogs-pack-popup-last-seen-v1';
    const sevenDays = 7 * 24 * 60 * 60 * 1000;
    try {
      const lastSeen = Number(window.localStorage.getItem(key));
      if (lastSeen && Date.now() - lastSeen < sevenDays) return;
    } catch (_) {
      // Continue in browsers where local storage is unavailable.
    }

    const isAppleMobile = /iPad|iPhone|iPod/i.test(navigator.userAgent);
    overlay.querySelectorAll('[data-pack-sms]').forEach((link) => {
      link.setAttribute('href', isAppleMobile ? 'sms:+18336315496&body=PACK' : 'sms:+18336315496?body=PACK');
    });

    const closeButtons = Array.from(overlay.querySelectorAll('[data-pack-popup-close]'));
    const focusable = Array.from(overlay.querySelectorAll('button, a[href]'));
    let returnFocus = null;
    let originalOverflow = '';

    const onKeyDown = (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        dismiss();
        return;
      }
      if (event.key !== 'Tab') return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };

    const dismiss = () => {
      overlay.hidden = true;
      document.body.style.overflow = originalOverflow;
      document.removeEventListener('keydown', onKeyDown);
      if (returnFocus instanceof HTMLElement) returnFocus.focus({ preventScroll: true });
    };

    closeButtons.forEach((button) => button.addEventListener('click', dismiss));
    overlay.addEventListener('click', (event) => {
      if (event.target === overlay) dismiss();
    });

    const show = () => {
      if (document.hidden || !overlay.hidden) return;
      returnFocus = document.activeElement;
      originalOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      overlay.hidden = false;
      try { window.localStorage.setItem(key, String(Date.now())); } catch (_) {}
      document.addEventListener('keydown', onKeyDown);
      closeButtons[0]?.focus({ preventScroll: true });
    };
    window.setTimeout(show, 7000);
  })();
</script>