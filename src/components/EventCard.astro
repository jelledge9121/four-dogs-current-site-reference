---
import type { Event } from '../data/events';
import { venueById } from '../data/venues';
import { needsTicket, eventCardDateLabels, formatDate, startIso, statusLabel, categorySlug, phase } from '../lib/event-system';
const { event } = Astro.props as { event: Event };
const venue = venueById(event.venueId);
const { month, weekday } = eventCardDateLabels(event.date);
const status = phase(event);
const attendable = ['upcoming', 'live'].includes(status);
const soldOut = attendable && event.admission.soldOut;
const showTickets = attendable && needsTicket(event) && event.registrationUrl && !soldOut;
const admission = event.admission.verified && event.admission.kind === 'paid'
  ? event.admission.note || `$${event.admission.price} per person`
  : event.admission.verified && event.admission.kind === 'free' ? 'Free admission' : needsTicket(event) ? 'Ticketed event' : 'Check admission details';
---
<article class="event event-row" data-fd-reveal data-event-id={event.id} data-event-status={status}>
  <time class="event-date" datetime={startIso(event)} aria-label={formatDate(event.date)}><span>{month}</span><strong>{Number(event.date.slice(-2))}</strong><span>{weekday} · {event.date.slice(0,4)}</span></time>
  <div class="event-summary"><p class="event-time">{event.startTime || 'Start time to be announced'}{event.endTime ? ` to ${event.endTime}` : ''}{event.startTime && <span>· Eastern Time</span>}</p><h3><a href={`/events/${event.slug}/`}>{event.title}</a></h3><p class="event-place"><a href={`/venues/${venue.slug}/`}>{venue.name}</a><span>{venue.city}, {venue.state}</span></p><p class="event-description">{event.shortDescription}</p><div class="event-meta"><a href={`/events/category/${categorySlug(event.eventType)}/`}>{event.eventType}</a><span>{event.seriesId?'Recurring series':['Comedy','Murder Mystery','Special Event'].includes(event.eventType)?'Special event':''}</span><span>{admission}</span>{(status!=='upcoming' || event.status==='rescheduled') && <strong class="event-change">{statusLabel(event)}</strong>}{soldOut && <strong class="event-change">Sold out</strong>}</div></div>
  <div class="listing-actions">{showTickets && <a class="button" data-event-action="registration_click" href={event.registrationUrl} target="_blank" rel="noopener noreferrer">{event.registrationLabel || 'Get tickets'}</a>}<a class="event-details-link" href={`/events/${event.slug}/`} aria-label={`Event details: ${event.title}`}>Event details <span aria-hidden="true">→</span></a></div>
</article>
