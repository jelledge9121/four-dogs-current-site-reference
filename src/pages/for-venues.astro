---
export const prerender = false;
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { venueOwnerReview } from '../data/reviews';
import VenuePhoto from '../components/VenuePhoto.astro';
import venuePhotos from '../data/venue-photos.json';
import VenueProof from '../components/VenueProof.astro';
import { venues } from '../data/venues';
import { upcomingEvents } from '../data/events';

const crowdPhoto = venuePhotos['top-dawg'].find(photo =>
  photo.src.endsWith('/top-dawg-tavern-sandhill-music-bingo-crowd.webp'))!;
const publicEvents = upcomingEvents();
const upcomingVenueIds = new Set(publicEvents.map((event) => event.venueId));
const activeVenues = venues.filter((venue) => venue.active && upcomingVenueIds.has(venue.id));
---
<Base title="Weekly Entertainment for Restaurants & Bars in SC | Four Dogs" description="Bring weekly trivia, Music Bingo or Survey Showdown to your restaurant, bar or brewery. Meet our venue partners and ask about a recurring night with Four Dogs." schema={{'@context':'https://schema.org','@type':'Service',name:'Weekly hosted venue entertainment',provider:{'@id':'https://4dogsentertainment.com/#organization'},areaServed:'South Carolina',url:'https://4dogsentertainment.com/for-venues/'}}>
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'For Venues' }]} />
  <section class="section dark">
    <div class="container split venue-intro"><div>
      <p class="eyebrow">For restaurants, breweries & bars</p>
      <h1>A reason to put your place on next week’s calendar.</h1>
      <p class="lead">Weekly trivia, Music Bingo and Survey Showdown for your regulars.</p>
      <p class="attendance">Across four Tuesdays in November, our hosts counted 36 to 64 players per night at Top Dawg Tavern in Sandhill.</p>
      <div class="actions">
        <a class="button" data-event-action="venue_partnership_cta" href="/booking/?service=Venue%20Entertainment">Plan a weekly venue night</a>
      </div>
      </div>
      <VenuePhoto photo={crowdPhoto} hero />
    </div>
  </section>
  <section class="section partner-details">
    <div class="container split">
      {venueOwnerReview?.approved && <ReviewCard review={venueOwnerReview} excerpt="forVenues" showFull={true} />}
      <div>
        <h2>How a weekly night works</h2>
        <p><strong>Four Dogs</strong> brings a prepared host, the game, scoring, promotional graphics and any audio support you need.</p>
        <p><strong>Your staff</strong> sets up the room, serves food and drinks, and invites your regulars.</p>
        <p><strong>After you inquire,</strong> we’ll check host availability for your preferred night and talk through the format, price and promotion with you.</p>
      </div>
    </div>
  </section>
  <VenueProof venues={venues} events={publicEvents} />

  <section class="section alt">
    <div class="container">
      <p class="eyebrow">Real local events</p>
      <h2>See Four Dogs working with local venues.</h2>
      <p>These venues have confirmed upcoming public Four Dogs events. Individual dates and game formats can change, so always check our live calendar.</p>
      {activeVenues.length > 0 && <div class="venue-partner-list">
        {activeVenues.map((venue) => (
          <a href={`/venues/${venue.slug}/`}><strong>{venue.name}</strong><span>{venue.city}, {venue.state}</span><span aria-hidden="true">→</span></a>
        ))}
      </div>}
      <div class="actions">
        <a href="/events/">See all confirmed upcoming events →</a>
        <a href="/areas/columbia-sc/">Columbia entertainment →</a>
        <a href="/areas/lexington-sc/">Lexington entertainment →</a>
        <a href="/areas/west-columbia-cayce-sc/">West Columbia & Cayce →</a>
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="container">
      <h2>Let’s build a weekly night for your venue.</h2>
      <p>Tell us which night you want to build, what you already host and how your room is set up.</p>
      <div class="actions">
        <a class="button" data-event-action="venue_partnership_cta" href="/booking/?service=Venue%20Entertainment">Start a venue partnership inquiry</a>
      </div>
      <p class="fine">Bring your people. We’ll bring the Doggone Good Time.</p>
    </div>
  </section>
  <style>
    .venue-intro { align-items:center; }
    .attendance { max-width:48ch; padding-left:1rem; border-left:3px solid var(--gold); }
    .partner-details :global(.testimonial) { margin:0; }
    @media (max-width:800px) { .venue-intro { gap:1.25rem; } }
    .venue-partner-list a:hover strong { text-decoration: underline; }
    .venue-partner-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 0 2rem; margin: 1.25rem 0 1.75rem; }
    .venue-partner-list a { display: flex; gap: .8rem; align-items: baseline; padding: .95rem .15rem; border-bottom: 1px solid var(--rule); text-decoration: none; flex-wrap: wrap; }
    .venue-partner-list a span:nth-child(2) { color: var(--muted); margin-left: auto; }
    @media (max-width: 650px) { .venue-partner-list { grid-template-columns: 1fr; } }
  </style>
</Base>
