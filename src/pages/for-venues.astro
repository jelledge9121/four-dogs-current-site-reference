---
export const prerender = false;
import Base from '../layouts/Base.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { venueOwnerReview } from '../data/reviews';
import { venues } from '../data/venues';
import { upcomingEvents } from '../data/events';

const upcomingVenueIds = new Set(upcomingEvents().map((event) => event.venueId));
const activeVenues = venues.filter((venue) => venue.active && upcomingVenueIds.has(venue.id));
const formats = [
  { name: 'Trivia nights', details: 'General knowledge and themed rounds with a host who keeps teams involved.', href: '/services/trivia/' },
  { name: 'Music Bingo', details: 'Recognizable songs, rotating themes, and a game people can pick up quickly.', href: '/services/music-bingo/' },
  { name: 'Survey Showdown', details: 'An interactive team competition built around popular survey answers.', href: '/services/four-dogs-survey-showdown/' },
  { name: 'Are You Smarter Than a Barstool?', details: 'A playful school-subject challenge and a change of pace from traditional trivia.', href: '/services/are-you-smarter-than-a-barstool/' },
];
---
<Base title="Weekly Entertainment for Restaurants & Bars in SC | Four Dogs" description="Plan weekly entertainment for your restaurant or bar with Four Dogs. Explore trivia, Music Bingo, original game shows, professional hosts and local promotional support.">
  <section class="section dark">
    <div class="container">
      <p class="eyebrow">For restaurant & bar owners</p>
      <h1>Weekly entertainment for your bar or restaurant.</h1>
      <p class="lead">We plan the games, host the night and help get the word out. Choose trivia, Music Bingo or a Four Dogs original that fits your crowd.</p>
      <div class="actions">
        <a class="button" href="/booking/?service=Venue%20Entertainment">Talk about a weekly partnership</a>
        <a class="button secondary" href="/events/">See our venue nights</a>
      </div>
      <p class="fine">No need to have every detail figured out. Tell us about your venue and the night you have in mind.</p>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Hosting and promotion</p>
        <h2>We handle the entertainment so you can run your restaurant.</h2>
        <p>We plan the format, bring a professional host, run the rounds, manage scoring, and keep guests engaged. We also provide promotional graphics and support sharing the event. Your team can stay focused on food, drinks, and hospitality.</p>
        <p>The best recurring night fits the room. We can talk through your audience, what your venue already offers, and whether trivia, Music Bingo, or a rotating game format makes sense.</p>
      </div>
      <img src="/images/optimized/home-crowd-960.webp" srcset="/images/optimized/home-crowd-480.webp 480w, /images/optimized/home-crowd-960.webp 960w, /images/optimized/home-crowd-1440.webp 1440w" sizes="(max-width:800px) calc(100vw - 32px), 46vw" width="960" height="723" alt="Four Dogs Survey Showdown guests at Boze’s Restaurant and Bar in West Columbia with their team sign and prize" loading="lazy" decoding="async" />
    </div>
  </section>

  {venueOwnerReview?.approved && (
    <section class="section">
      <div class="container">
        <p class="eyebrow">From a venue owner</p>
        <h2>What a real Four Dogs partnership looks like.</h2>
        <ReviewCard review={venueOwnerReview} excerpt="forVenues" showFull={true} />
      </div>
    </section>
  )}

  <section class="section alt">
    <div class="container">
      <p class="eyebrow">Choose the right night</p>
      <h2>Original games. Familiar favorites. A format for your crowd.</h2>
      <div class="grid">
        {formats.map((format) => <a class="card" href={format.href}><h3>{format.name}</h3><p>{format.details}</p><p>Explore the format →</p></a>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid">
      <div>
        <h2>What Four Dogs brings</h2>
        <ul>
          <li>A professional, prepared host</li>
          <li>Game questions, materials, pacing, and scoring</li>
          <li>Guest interaction and an organized experience</li>
          <li>Audio support when needed</li>
          <li>Promotional graphics and event-sharing support</li>
        </ul>
      </div>
      <div>
        <h2>What your team handles</h2>
        <ul>
          <li>Food, drinks, and service</li>
          <li>The space and staff for your guests</li>
          <li>Sharing the night with your regulars</li>
          <li>The hospitality that makes your place yours</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <p class="eyebrow">Real local events</p>
      <h2>See Four Dogs working with local venues.</h2>
      <p>These venues have confirmed upcoming public Four Dogs events. Individual dates and game formats can change, so always check our live calendar.</p>
      {activeVenues.length > 0 && <div class="grid">
        {activeVenues.map((venue) => (
          <a class="card" href={`/venues/${venue.slug}/`}>
            <h3>{venue.name}</h3>
            <p>{venue.city}, {venue.state}</p>
            <p>See confirmed dates →</p>
          </a>
        ))}
      </div>}
      <div class="actions">
        <a href="/events/">See all confirmed upcoming events →</a>
        <a href="/areas/columbia-sc/">Columbia entertainment →</a>
        <a href="/areas/lexington-sc/">Lexington entertainment →</a>
        <a href="/areas/west-columbia-cayce-sc/">West Columbia & Cayce →</a>
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="container">
      <h2>Which night fits your venue?</h2>
      <p>Tell us your restaurant's name, location, and a night you'd like to explore. We'll talk through the format and whether a trial date is a fit.</p>
      <div class="actions">
        <a class="button" href="/booking/?service=Venue%20Entertainment">Talk about a weekly partnership</a>
        <a class="button secondary" href="mailto:bookings@4dogsentertainment.com?subject=Venue%20Entertainment%20Inquiry">Email Four Dogs</a>
      </div>
      <p class="fine">Bring your people. We’ll bring the Doggone Good Time.</p>
    </div>
  </section>
</Base>
