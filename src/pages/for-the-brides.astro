.brides *{box-sizing:border-box}.brides button,.brides select,.brides input{font:inherit}.brides-shell{max-width:1180px;padding:0 26px;margin:auto}.brides-hero{background:radial-gradient(circle at 80% 22%,#21485c 0,#0a2132 44%,#071825 100%);color:#fff}.brides-hero-grid{display:grid;grid-template-columns:1.3fr .9fr;gap:45px;align-items:center;min-height:560px;padding-top:78px;padding-bottom:86px}.brides-kicker,.brides-section-label{font-size:11px;font-weight:850;letter-spacing:.17em;color:#078d9c}.brides-kicker{color:#89dfdf;margin-bottom:22px}.brides h1,.brides h2,.brides h3,.brides blockquote{font-family:Georgia,serif;letter-spacing:-.045em}.brides h1{font-size:clamp(3rem,5.6vw,5.5rem);line-height:1.08;margin:0 0 24px;color:#fff}.brides h1 em,.brides h2 em,.brides h3 em,.brides blockquote em{font-weight:400;color:var(--bt)}.brides h1 span{white-space:nowrap;text-decoration:underline;text-decoration-color:var(--bg);text-underline-offset:12px;text-decoration-thickness:3px}.brides-lead{color:#c7d7db;font-size:1.16rem;max-width:600px;line-height:1.75}.brides-tags{display:flex;flex-wrap:wrap;gap:11px;margin:26px 0 34px}.brides-tags span{border:1px solid #ffffff36;border-radius:22px;padding:9px 13px;font-size:11px;letter-spacing:.06em;color:#dbeced}.brides-hero-cta{color:var(--bn)!important;background:#dbccac;padding:16px 21px;border-radius:5px;display:inline-flex;gap:38px;text-decoration:none!important;font-weight:850;font-size:.79rem;letter-spacing:.11em}.brides-hero-art{min-height:380px;border:1px solid #ffffff22;border-radius:44% 44% 12% 12%;position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;background:radial-gradient(ellipse at center,#29586d88 0,#0b2435 65%)}.brides-art-orbit{position:absolute;width:310px;height:310px;border:1px solid #d7be8c55;border-radius:50%;transform:rotate(-20deg)}.brides-art-text{z-index:1;font:italic 64px/1 Georgia,serif;text-align:center;color:#fff7e7;transform:rotate(-8deg)}.brides-art-text i{font-size:107px;color:#e8d9b8}.brides-art-text span{color:var(--bt)}.brides-hero-art small{z-index:1;color:#90e1e8;letter-spacing:.12em;margin-top:25px}.brides-art-seal{position:absolute;right:15px;top:20px;border:2px dotted var(--bg);border-radius:50%;padding:25px 13px;text-align:center;line-height:1.6;transform:rotate(16deg);font-weight:700;font-size:10px;letter-spacing:.11em}.brides-ribbon{overflow:hidden;text-align:center;background:#d7c3a1;color:#0e2b3a;padding:15px 10px;font-size:11px;font-weight:900;letter-spacing:.12em}.brides-studio{padding-top:85px;padding-bottom:85px}.brides h2{font-size:clamp(2.5rem,4.1vw,4.2rem);margin:12px 0 10px;line-height:1.1}.brides-muted{color:#637780;line-height:1.7}.brides-studio-layout{display:grid;grid-template-columns:1.65fr 1fr;gap:25px;align-items:start;margin-top:32px}.brides-form{padding:35px;border:1px solid #e5dfd1;background:white;box-shadow:0 15px 50px #112c3d0c;border-radius:16px}.brides-form-title{display:flex;align-items:center;gap:15px;margin-bottom:30px}.brides-symbol{background:#e7f9fa;color:#168f9e;border-radius:50%;width:52px;height:52px;display:grid;place-items:center;font-size:30px}.brides-form-title strong{display:block;font:700 1.4rem Georgia,serif}.brides-form-title small{color:#71818a}.brides-fields{display:grid;grid-template-columns:1fr 1fr;gap:24px 18px}.brides-fields label,.brides-card-studio label{display:block;font-size:11px;font-weight:850;letter-spacing:.07em;color:#213c4c}.brides-fields label span{color:#d66866}.brides-fields label small{font-size:9px;color:#819197}.brides input:not([type=radio]),.brides select{display:block;width:100%;border:1px solid #d8dfdf;border-radius:8px;background:#fff;padding:13px 12px;margin-top:8px;color:#142c3c;min-height:46px}.brides input:focus-visible,.brides select:focus-visible,.brides button:focus-visible,.brides a:focus-visible{outline:3px solid #24bdcf;outline-offset:3px}.brides-form-rule{height:32px;display:flex;align-items:center;justify-content:center;margin:24px 0}.brides-form-rule:before,.brides-form-rule:after{content:"";height:1px;background:#e3e5e2;flex:1}.brides-form-rule span{margin:0 18px;color:#b79e6f}.brides-vibes{border:0;padding:0;min-width:0}.brides-vibes legend{font-weight:900;font-size:12px;letter-spacing:.07em}.brides-vibes>p{font-size:14px;color:#72818a;margin:10px 0 18px}.brides-vibe-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:11px}.brides-vibe-grid label{position:relative;cursor:pointer;background:#f8faf9;border:1px solid #dfe6e5;border-radius:11px;min-height:116px;padding:13px 9px;display:flex;align-items:center;text-align:center;justify-content:center;flex-direction:column;gap:5px;transition:.2s}.brides-vibe-grid label:has(input:checked){background:#e9f9f9;border-color:#23bdc7;box-shadow:0 0 0 2px #20b9c333}.brides-vibe-grid input{position:absolute;opacity:0}.brides-vibe-grid label:has(input:focus-visible){outline:3px solid #20bdc9}.brides-vibe-grid label>span{font-size:25px;color:#1197a4}.brides-vibe-grid strong{font-size:12px}.brides-vibe-grid small{font-size:10px;color:#6a7f83}.brides-primary{cursor:pointer;background:#25b9ca!important;border:0!important;color:#082635!important;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:17px 22px;border-radius:6px;font-size:12px!important;letter-spacing:.1em;font-weight:900!important;text-decoration:none!important}.brides-form>.brides-primary{width:100%;margin-top:28px}.brides-primary:hover{background:#75e2e9!important}.brides-form-foot{text-align:center;font-size:10px;letter-spacing:.08em;color:#7c9295;margin:15px 0 0}.brides-note{background:#09283a;color:#e9ece8;border-radius:13px;overflow:hidden;box-shadow:0 15px 45px #09283a20}.brides-note-inner{padding:33px}.brides-note .brides-section-label{color:#69d6d9}.brides-note blockquote{font-size:2.15rem;line-height:1.25;margin:30px 0;color:#fff8ed}.brides-note hr{border:0;border-top:1px solid #ffffff40;margin:26px 0}.brides-note p{color:#adc5c9;line-height:1.7}.brides-note i{display:block;margin-top:23px;font:italic 22px Georgia,serif;color:#e7d3ac}.brides-note-footer{background:#16394b;padding:20px;text-align:center;font-size:10px;letter-spacing:.14em}.brides-error{color:#ad2929;font-weight:650}.brides-results{padding:0 26px 96px}.brides-results[hidden]{display:none!important}.brides-results-head{display:flex;justify-content:space-between;align-items:end;gap:25px}.brides-text-btn{border:0;background:transparent;cursor:pointer;color:#057c91;font-weight:800;font-size:12px}.brides-results-toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:26px 0}.brides-results-toolbar>span{border-radius:20px;background:#e8f3f2;padding:9px 15px;font-size:11px;font-weight:800}.brides-results-toolbar>div{display:flex;flex-wrap:wrap;gap:8px}.brides-outline{cursor:pointer;border:1px solid #adc4c9!important;background:transparent!important;color:#0a4f66!important;border-radius:6px;padding:11px 13px;font-weight:850!important;font-size:11px!important;letter-spacing:.05em}.brides-outline:hover{background:#ecf8f9!important}.brides-outline:disabled{opacity:.35;cursor:not-allowed}.brides-results-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.brides-result{border:1px solid #dce6e4;border-radius:12px;padding:19px;background:#fff;min-width:0}.brides-result-top{display:flex;justify-content:space-between;align-items:center;gap:8px}.brides-result-top>span{font-size:10px;font-weight:750;color:#0b8994;letter-spacing:.08em}.brides-heart{font-size:26px!important;color:#198f9c!important;border:0!important;background:none!important;cursor:pointer;padding:0 4px}.brides-result-tag{border:0;background:none;color:#112f40;display:block;text-align:left;font-size:clamp(14px,1.5vw,18px);font-weight:850;overflow-wrap:anywhere;cursor:pointer;margin:22px 0 9px;padding:0}.brides-result>small{color:#708389}.brides-favorites{margin-top:62px;border-top:1px solid #dee6e1;padding-top:43px}.brides h3{font-size:clamp(1.9rem,3vw,3rem);margin:10px 0 23px}.brides-fav-list{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:16px}.brides-fav-chip{display:inline-flex;align-items:center;gap:7px;background:#eaf6f4;color:#075567;padding:9px 10px;border-radius:7px;font-size:12px;font-weight:750}.brides-fav-chip button{cursor:pointer;border:0;background:transparent;color:#08677a;font-weight:bold}.brides-favorites>.brides-outline{margin-right:8px}.brides-card-studio{margin-top:60px;padding:38px;background:#eff6f5;border-radius:14px;display:grid;grid-template-columns:.9fr 1.1fr;gap:32px;align-items:center}.brides-card-studio p{color:#647b83;line-height:1.7}.brides-card-studio label{margin:19px 0}.brides-card-studio small{display:block;margin:12px 0;color:#657e83}.brides-card-preview{min-height:390px;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;flex-direction:column;padding:34px;text-align:center;position:relative;overflow:hidden;border:1px solid #c5b691}.brides-card-preview.midnight{background:radial-gradient(circle,#234659,#091c2d);color:#efdfbb}.brides-card-preview.ivory{background:#f9f4e9;color:#153648}.brides-card-preview.cyan{background:linear-gradient(140deg,#16c4d5,#0b2a45);color:white}.brides-card-preview>div{font-size:10px;letter-spacing:.19em;font-weight:800}.brides-card-preview>strong{font:italic clamp(24px,3vw,43px) Georgia,serif;margin:20px 0}.brides-card-preview>span{font-size:clamp(13px,1.7vw,21px);font-weight:800;overflow-wrap:anywhere;max-width:100%}.brides-card-preview>small{font-size:9px;letter-spacing:.08em;margin-top:24px}.brides-card-preview>footer{font-size:8px;letter-spacing:.14em;position:absolute;bottom:25px}.brides-roast{margin-top:50px;padding:30px;border:1px dashed #c2d8d6;border-radius:14px;display:grid;grid-template-columns:1fr 1fr;gap:32px}.brides-roast p{color:#75878d}.brides-roast select{max-width:330px}.brides-roast button{margin-top:10px}.brides-roast-output{display:grid;place-items:center;text-align:center;border-radius:12px;background:#ebf6f6;color:#095568;padding:23px;font:italic 22px/1.6 Georgia,serif}.brides-convert{background:#092334;color:white;padding:80px 0}.brides-convert-grid{display:grid;grid-template-columns:2fr 1fr;align-items:center;gap:35px}.brides-convert .brides-section-label{color:#7ce1df}.brides-convert h2{color:#fff}.brides-convert p{max-width:640px;line-height:1.8;color:#b7c9d0}.brides-book{display:inline-flex;margin-top:20px}.brides-convert-orbit{border:1px solid #dbcca777;border-radius:50%;width:285px;height:285px;display:grid;place-content:center;text-align:center;font:bold 22px/1.6 Georgia,serif;letter-spacing:.02em;color:#e6d7b5}.brides-toast{position:fixed;z-index:99;bottom:24px;left:50%;transform:translateX(-50%);background:#123b4d;color:white;border-radius:9px;padding:13px 20px;opacity:0;pointer-events:none;transition:opacity .2s;font-weight:750}.brides-toast.show{opacity:1}
@media(max-width:900px){.brides-hero-grid,.brides-studio-layout,.brides-card-studio,.brides-roast,.brides-convert-grid{grid-template-columns:1fr}.brides-hero-grid{padding-top:52px}.brides-hero-art{max-width:560px;min-height:310px;width:100%}.brides-note{display:none}.brides-results-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.brides-convert-orbit{display:none}}@media(max-width:550px){.brides-shell{padding-left:17px;padding-right:17px}.brides-hero-grid{padding-bottom:56px}.brides h1{font-size:clamp(2.5rem,11vw,3.8rem)}.brides-hero-art{min-height:260px}.brides-art-text{font-size:45px}.brides-art-text i{font-size:78px}.brides-art-seal{padding:12px 8px;font-size:8px}.brides-studio{padding-top:57px}.brides-form{padding:23px 16px}.brides-fields{grid-template-columns:1fr}.brides-vibe-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.brides-results-grid{grid-template-columns:1fr}.brides-results-head,.brides-results-toolbar{align-items:start;flex-direction:column}.brides-card-studio{padding:21px}.brides-roast{padding:20px}.brides-results{padding-bottom:60px}}
@media(prefers-reduced-motion:reduce){.brides *{scroll-behavior:auto!important;transition:none!important}}
</style>
<script is:inline>
(function(){
  const root=document.querySelector('.brides'); if(!root)return;
  const el=id=>document.getElementById(id), clean=s=>(s||'').normalize('NFKD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-zA-Z0-9]/g,'');
  const templates={
    romantic:['{ab}Forever','{ab}EverAfter','{a}Found{b}','{a}Loves{b}','{ab}SayIDo','{ab}ToInfinity','{ab}LoveStory','{ab}BetterTogether','{ab}MadeForEachOther','{a}And{b}ForAlways','{ab}WrittenInTheStars','{ab}ToTheMoon','{ab}ForeverStartsNow','{ab}TrueLove','{ab}HeartAndSoul','{ab}FromThisDay'],
    funny:['{ab}Finally','{ab}NoTakeBacks','{ab}OffTheMarket','{ab}MadeItLegal','{ab}DidTheThing','{ab}SignedUpForLife','{ab}WeddingEra','{ab}PlotTwist','{ab}CantReturnThis','{ab}GotHitched','{ab}DibsForLife','{ab}NoRefunds','{ab}SealedTheDeal','{ab}OfficiallyUnavailable','{ab}ItsAboutTime','{ab}SaidYesAgain'],
    punny:['{ab}TieTheKnot','{ab}KnotKidding','{ab}LoveAtFirstSwipe','{ab}RingItOn','{ab}PutARingOnIt','{ab}KnotAnOrdinaryWedding','{ab}RingLeaders','{ab}ThePerfectPair','{ab}LoveLocked','{ab}SealedTheDeal','{ab}IDoCrew','{ab}MatchMade','{ab}HereComesForever','{ab}HeartAndSoul','{ab}KnotYourAverageLove','{ab}TheRealDeal'],
    elegant:['{ab}','{ab}Wedding','{ab}Together','{ab}InLove','{ab}OurDay','{ab}TheBeginning','{ab}Celebrate','{ab}WeddingDay','{ab}Vows','{ab}InBloom','{ab}ForeverMore','{a}Plus{b}','{ab}ToHaveAndToHold','{ab}TheWedding','{ab}Cherished','{ab}Union'],
    party:['{ab}DanceAllNight','{ab}PartyStartsNow','{ab}AfterParty','{ab}HitTheDanceFloor','{ab}RaiseAGlass','{ab}BestNightEver','{ab}TurnItUp','{ab}TheMainEvent','{ab}Celebrate','{ab}LetLoose','{ab}DanceIntoForever','{ab}ReadyToParty','{ab}GoodTimesForever','{ab}GetThisPartyStarted','{ab}PartyOfTheYear','{ab}TheLastDance']
  };
  const wordplay={moore:['LoveYouMoore','ForeverAndMoore'],wright:['TheWrightMatch','LoveDoneWright'],right:['TheRightMatch'],bell:['RingingTheBell','WeddingBellBliss'],king:['RoyallyInLove','KingOfMyHeart'],queen:['TheRoyalWedding'],knight:['OurKnightToRemember','KnightAndDayInLove'],best:['BestDayEver'],young:['ForeverYoung'],lane:['DownLoversLane'],price:['LoveIsPriceless'],rose:['LoveInFullBloom'],hill:['HeadOverHills'],love:['AllAboutLove'],chase:['ChasingForever'],harris:['HappilyEverHarris'],shore:['LoveYouForShore'],reid:['ReidAllAboutIt'],reed:['ReedAllAboutIt'],wood:['WoodYouMarryMe'],page:['OurNextPage'],stone:['SetInStone'],moon:['OverTheMoonInLove'],star:['WrittenInTheStars'],fox:['FoxEverAfter'],banks:['BankingOnForever'],green:['GreenLightToForever'],snow:['SnowMuchLove'],summers:['EndlessSummers'],summer:['SummerOfLove'],walker:['WalkingIntoForever'],wells:['WellsOfLove'],hart:['TwoHeartsOneHart'],white:['WhiteWeddingVibes'],gold:['GoldenTogether'],golden:['GoldenEverAfter'],joy:['JoyToTheNewlyweds'],true:['TrueLoveAlways'],kiss:['SealedWithAKiss'],bond:['LicensedToWed']};
  let state={all:[],shown:[],favorites:new Set(),page:0,first:'',second:'',last:'',year:'',vibe:'mix'};
  let timer;
  function toast(t){const e=el('brides-toast');e.textContent=t;e.classList.add('show');clearTimeout(timer);timer=setTimeout(()=>e.classList.remove('show'),2500)}
  const label={romantic:'SWEET & ROMANTIC',funny:'FUNNY FAVORITE',punny:'PUN INTENDED',elegant:'CLASSIC & CHIC',party:'PARTY READY'};
  function add(list,tag,vibe,note){if(tag.length>50||tag.length<6)return;if(list.some(x=>x.tag===tag))return;list.push({tag:'#'+tag,vibe,note:note||'Made just for you'});}
  function build(){
    const a=state.first,b=state.second,s=state.last,y=state.year,ab=a+'And'+b;const list=[];
    if(s && wordplay[s.toLowerCase()]) wordplay[s.toLowerCase()].forEach(t=>add(list,t,'punny','A little last-name magic'));
    Object.keys(templates).forEach(v=>templates[v].forEach(t=>add(list,t.replace(/\{ab\}/g,ab).replace(/\{a\}/g,a).replace(/\{b\}/g,b),v,'Your names, your vibe')));
    if(s){const plural=/(s|x|z|ch|sh)$/i.test(s)?s+'es':s+'s';[['MeetThe'+plural,'elegant'],[s+'EverAfter','romantic'],['HereComeThe'+plural,'party'],[s+'GotHitched','funny'],[s+'LoveStory','romantic'],[s+'TiesTheKnot','punny'],[s+'PartyOfTwo','party'],[s+'WeddingBash','party'],[s+'Forever','romantic'],[s+'NoGoingBack','funny']].forEach(([tag,v])=>add(list,tag,v,'Last-name inspiration'))}
    if(y){['Forever','EverAfter','Party','Wedding','GotHitched','TieTheKnot'].forEach((tag,i)=>add(list,ab+tag+y,Object.keys(templates)[i%5],'Your special year'));if(s)add(list,s+'Wedding'+y,'elegant','Your special year')}
    let matches=state.vibe==='mix'?list:list.filter(x=>x.vibe===state.vibe);
    if(!matches.length)matches=list;
    const seed=(a+b+s+y+state.vibe).split('').reduce((x,c)=>((x<<5)-x+c.charCodeAt(0))|0,177);
    matches=matches.map((v,i)=>({v,k:((Math.imul(i+1,2654435761)^seed)>>>0)})).sort((x,y)=>x.k-y.k).map(x=>x.v);
    if(state.vibe==='mix' && s && wordplay[s.toLowerCase()]){const specials=matches.filter(x=>wordplay[s.toLowerCase()].some(t=>x.tag==='#'+t));matches=[...specials,...matches.filter(x=>!specials.includes(x))]}
    state.all=matches;state.page=0;state.shown=[];next();
  }
  function next(){
    if(!state.all.length)return;
    const start=(state.page*12)%state.all.length;state.shown=Array.from({length:Math.min(12,state.all.length)},(_,i)=>state.all[(start+i)%state.all.length]);
    state.page++;render();
  }
  function copy(text){if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(text).then(()=>toast('Copied to clipboard!')).catch(()=>fallback(text))}else fallback(text)}
  function fallback(text){const t=document.createElement('textarea');t.value=text;t.style.position='fixed';t.style.opacity='0';document.body.append(t);t.select();try{document.execCommand('copy');toast('Copied to clipboard!')}catch{window.prompt('Copy your hashtag:',text)}t.remove()}
  function makeButton(txt,klass,fn){const b=document.createElement('button');b.type='button';b.className=klass;b.textContent=txt;b.addEventListener('click',fn);return b}
  function render(){
    el('brides-result-count').textContent=state.shown.length+' fresh ideas';
    const grid=el('brides-results-grid');grid.replaceChildren();
    state.shown.forEach(x=>{const item=document.createElement('article');item.className='brides-result';const top=document.createElement('div');top.className='brides-result-top';const style=document.createElement('span');style.textContent=label[x.vibe];const heart=makeButton(state.favorites.has(x.tag)?'♥':'♡','brides-heart',()=>{state.favorites.has(x.tag)?state.favorites.delete(x.tag):state.favorites.add(x.tag);render()});heart.setAttribute('aria-label',(state.favorites.has(x.tag)?'Remove favorite ':'Save favorite ')+x.tag);top.append(style,heart);const tag=makeButton(x.tag,'brides-result-tag',()=>copy(x.tag));tag.title='Copy hashtag';const note=document.createElement('small');note.textContent=x.note;item.append(top,tag,note);grid.append(item)});
    const f=el('brides-favorites-list');f.replaceChildren();state.favorites.forEach(tag=>{const chip=document.createElement('span');chip.className='brides-fav-chip';chip.append(makeButton(tag,'',()=>copy(tag)),makeButton('×','',()=>{state.favorites.delete(tag);render()}));f.append(chip)});
    el('brides-empty').hidden=state.favorites.size>0;el('brides-copy-faves').disabled=!state.favorites.size;el('brides-share-faves').disabled=!state.favorites.size;
    const options=[...new Set([...state.favorites,...state.shown.map(x=>x.tag)])];
    ['brides-card-tag','brides-roast-tag'].forEach(id=>{const select=el(id),old=select.value;select.replaceChildren();options.forEach(tag=>{const o=document.createElement('option');o.value=tag;o.textContent=tag;select.append(o)});if(options.includes(old))select.value=old});
    preview();
  }
  function preview(){const tag=el('brides-card-tag').value;el('brides-preview-names').textContent=state.first+' & '+state.second;el('brides-preview-tag').textContent=tag;el('brides-card-preview').className='brides-card-preview '+el('brides-card-style').value}
  function download(){
    const tag=el('brides-card-tag').value;if(!tag)return;
    const c=document.createElement('canvas');c.width=1200;c.height=1200;const ctx=c.getContext('2d');if(!ctx){toast('Graphic download is unavailable in this browser');return}
    const style=el('brides-card-style').value;const dark=style!=='ivory',bg=style==='midnight'?'#092333':style==='ivory'?'#faf5ea':'#0b6f85',fg=dark?'#f7edda':'#17374a';
    const grad=ctx.createLinearGradient(0,0,1200,1200);grad.addColorStop(0,bg);grad.addColorStop(1,style==='cyan'?'#20cad8':style==='midnight'?'#173e51':'#e9ddc5');ctx.fillStyle=grad;ctx.fillRect(0,0,1200,1200);
    ctx.strokeStyle=dark?'#dcc9a4':'#bbac86';ctx.lineWidth=3;ctx.strokeRect(70,70,1060,1060);ctx.strokeRect(86,86,1028,1028);
    ctx.textAlign='center';ctx.fillStyle=fg;ctx.font='bold 23px Arial';ctx.fillText('✧  THE WEDDING OF  ✧',600,300);
    ctx.font='italic 76px Georgia';const names=state.first+' & '+state.second;ctx.fillText(names.length>22?names.slice(0,21)+'…':names,600,465);
    ctx.strokeStyle=fg;ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(420,522);ctx.lineTo(780,522);ctx.stroke();
    let font=66;while(font>27){ctx.font='bold '+font+'px Arial';if(ctx.measureText(tag).width<990)break;font-=2}ctx.fillText(tag,600,670);
    ctx.font='22px Arial';ctx.fillText('LOVE  •  LAUGHTER  •  HAPPILY EVER AFTER',600,865);ctx.font='bold 18px Arial';ctx.fillText('FOUR DOGS ENTERTAINMENT',600,1060);
    const a=document.createElement('a');a.href=c.toDataURL('image/png');a.download='Four-Dogs-Wedding-'+tag.slice(1)+'.png';document.body.append(a);a.click();a.remove();toast('Share card downloaded!');
  }
  const select=el('brides-year');const current=new Date().getFullYear();for(let year=current;year<=current+8;year++){const o=document.createElement('option');o.value=String(year);o.textContent=year;select.append(o)}
  el('brides-form').addEventListener('submit',event=>{event.preventDefault();state.first=clean(el('brides-first').value);state.second=clean(el('brides-second').value);state.last=clean(el('brides-last').value);state.year=select.value;state.vibe=document.querySelector('input[name="vibe"]:checked').value;const error=el('brides-error');if(!state.first||!state.second){error.hidden=false;error.textContent='Add both first names to generate your hashtags.';return}error.hidden=true;state.favorites.clear();build();el('brides-results').hidden=false;el('brides-results').scrollIntoView({behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'instant':'smooth',block:'start'})});
  el('brides-more').addEventListener('click',()=>{next();toast('Fresh hashtag ideas!')});
  el('brides-copy-all').addEventListener('click',()=>copy(state.shown.map(x=>x.tag).join('\n')));
  el('brides-copy-faves').addEventListener('click',()=>copy([...state.favorites].join('\n')));
  el('brides-share-faves').addEventListener('click',async()=>{const text='Our wedding hashtag favorites:\n'+[...state.favorites].join('\n');if(navigator.share){try{await navigator.share({title:'Our Wedding Hashtags',text,url:location.href})}catch{}}else copy(text)});
  el('brides-edit').addEventListener('click',()=>el('brides-studio').scrollIntoView({behavior:'smooth'}));
  el('brides-card-tag').addEventListener('change',preview);el('brides-card-style').addEventListener('change',preview);
  el('brides-download').addEventListener('click',download);
  el('brides-roast-button').addEventListener('click',()=>{const tag=el('brides-roast-tag').value;if(!tag)return;const jokes=['10/10. The group chat has already approved the assignment.','9/10. This one is getting printed on a welcome sign.','8/10. Cute enough to survive the family Facebook comments.','9/10. The bridesmaids are officially on board.','7/10. Slightly extra. Exactly the right amount of extra.','10/10. We have a winner. Someone tell the DJ.'];const v=tag.split('').reduce((n,ch)=>n+ch.charCodeAt(0),0);el('brides-roast-output').textContent=jokes[v%jokes.length]});
})();
</script>