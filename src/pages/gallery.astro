---
import Base from '../layouts/Base.astro';
import { gallery } from '../data/gallery';
---
<Base title="Real Four Dogs Events | Photo Gallery" description="See authentic Four Dogs Entertainment photos from trivia, Music Bingo, private events, venues, celebrations, crowds, and winners.">
  <section class="section dark">
    <div class="container">
      <p class="eyebrow">Real events</p>
      <h1>Meet us in the middle of the fun.</h1>
      <p class="lead">Real Four Dogs crowds, winners, celebrations, venues, and nights out across South Carolina.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="gallery">
        {gallery.map((photo) => (
          <figure>
            <img src={photo.src} alt={photo.alt} loading="lazy" width="800" height="600" />
            <figcaption>{photo.category}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</Base>
