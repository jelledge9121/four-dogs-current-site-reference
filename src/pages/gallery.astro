---
import Base from '../layouts/Base.astro';
import { gallery } from '../data/gallery';

const categories = ['All', 'Trivia', 'Music Bingo', 'Weddings', 'Private Events', 'Crowds & Winners', 'Venue Events'];
const featured = gallery.filter((item) => item.featured).slice(0, 4);
---
<Base title="Real Four Dogs Events Across South Carolina | Gallery" description="See authentic Four Dogs Entertainment photos and video from trivia, Music Bingo, weddings, venue events, private events, crowds, and winners across South Carolina.">
  <section class="section dark gallery-hero">
    <div class="container">
      <p class="eyebrow">Real people. Real events.</p>
      <h1>This is what a Doggone Good Time looks like.</h1>
      <p class="lead">No stock crowds and no staged event photos. These are real Four Dogs nights, winners, teams, weddings, venues, and celebrations from across South Carolina.</p>
    </div>
  </section>

  <section class="section gallery-featured-section">
    <div class="container">
      <div class="gallery-featured">
        {featured.map((item, index) => (
          <figure class:list={['gallery-featured-card', index === 0 && 'gallery-featured-primary']}>
            {item.type === 'video' ? (
              <video
                src={item.videoSrc}
                poster={item.poster}
                controls
                playsinline
                preload="none"
                aria-label={item.alt}
                width={item.width}
                height={item.height}
              >
                Your browser does not support HTML5 video.
              </video>
            ) : (
              <img src={item.src} alt={item.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" width={item.width} height={item.height} />
            )}
            <figcaption>
              <span>{item.category}</span>
              <strong>{item.title}</strong>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="gallery-heading">
        <div>
          <p class="eyebrow">The Four Dogs gallery</p>
          <h2>Good nights are better with people in them.</h2>
        </div>
        <p>Browse the room, the teams, the winners, the dance floors, and the moments that make each event feel different.</p>
      </div>

      <div class="gallery-filters" aria-label="Filter gallery">
        {categories.map((category) => (
          <button class:list={['gallery-filter', category === 'All' && 'active']} type="button" data-gallery-filter={category}>
            {category}
          </button>
        ))}
      </div>

      <div class="gallery-wall" data-gallery-wall>
        {gallery.map((item) => (
          <figure class="gallery-tile" data-gallery-item data-category={item.category}>
            <div class="gallery-media">
              {item.type === 'video' ? (
                <video
                  src={item.videoSrc}
                  poster={item.poster}
                  controls
                  playsinline
                  preload="none"
                  aria-label={item.alt}
                  width={item.width}
                  height={item.height}
                >
                  Your browser does not support HTML5 video.
                </video>
              ) : (
                <img src={item.src} alt={item.alt} loading="lazy" decoding="async" width={item.width} height={item.height} />
              )}
            </div>
            <figcaption>
              <span>{item.category}</span>
              <strong>{item.title}</strong>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="container split">
      <div>
        <p class="eyebrow">Your people could be next</p>
        <h2>Bring the crowd. We’ll bring the experience.</h2>
        <p>Four Dogs serves weddings, venues, companies, communities, private events, and public game nights across South Carolina.</p>
      </div>
      <div class="actions">
        <a class="button" href="/booking/">Book Four Dogs</a>
        <a class="button secondary" href="/events/">Find an event</a>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const buttons = document.querySelectorAll('[data-gallery-filter]');
      const items = document.querySelectorAll('[data-gallery-item]');
      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const filter = button.getAttribute('data-gallery-filter');
          buttons.forEach((item) => item.classList.remove('active'));
          button.classList.add('active');
          items.forEach((item) => {
            item.hidden = filter !== 'All' && item.getAttribute('data-category') !== filter;
          });
        });
      });
    })();
  </script>
</Base>
