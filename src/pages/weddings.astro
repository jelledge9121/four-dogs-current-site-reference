---
import Base from '../layouts/Base.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { reviews } from '../data/reviews';
const review = reviews.find((item) => item.id === 'susan-leonard-facebook');
const weddingReview = reviews.find((item) => item.id === 'gabrielle-stephen-howland-wedding-google' && item.approved);
---
<Base title="Wedding DJ Services in South Carolina, North Carolina & Georgia | Four Dogs" description="Four Dogs Entertainment provides wedding DJ services and personalized wedding entertainment across South Carolina, North Carolina, and Georgia, including the Almost Married Trivia Experience.">
  <section class="section dark wedding-intro">
    <div class="container wedding-intro-grid">
    <div>
      <h1>The best celebrations feel like the people they’re celebrating.</h1>
      <p class="lead">Four Dogs creates wedding entertainment built around personality, participation, energy, and shared memories.</p>
      <a class="button" href="/booking/?service=Wedding%20DJ%20%2F%20Entertainment">Plan your wedding</a>
    </div><img src="/images/optimized/wedding-floor-800.webp" srcset="/images/optimized/wedding-floor-480.webp 480w, /images/optimized/wedding-floor-800.webp 800w" sizes="(max-width:800px) calc(100vw - 32px), 45vw" width="800" height="532" alt="A full dance floor at a Four Dogs wedding" fetchpriority="high"/>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <h2>Create the energy your people will remember.</h2>
        <p>Music, hosting, pacing, and the moments that make the celebration feel unmistakably yours. Four Dogs serves couples throughout South Carolina and also travels to weddings in North Carolina and Georgia.</p>
      </div>
      <img src="/images/wedding.jpg" alt="A full dance floor at a Four Dogs wedding" />
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <h2>More laughs. More pictures. More memories.</h2>
      <p>Pair your wedding DJ with a professionally attended Four Dogs photo booth. Packages start at $450 for three hours, with instant digital photo sharing and an online gallery included. Prints, backdrops, extra hours, and travel can be added to your quote.</p>
      <a class="button" href="/services/photo-booth/">Explore Photo Booth Rentals</a>
    </div>
  </section>

  <section class="section alt">
    <div class="container split">
      <img src="/images/wedding.jpg" alt="Guests sharing a personalized Four Dogs wedding experience" />
      <div>
        <h2>Meet Almost Married Trivia.</h2>
        <p>Customized trivia about the couple for rehearsal dinners, engagement parties, wedding weekends, showers, and wedding-party gatherings.</p>
        <a class="button" href="/services/almost-married-trivia-experience/">Explore Almost Married</a>
      </div>
    </div>
  </section>

  {weddingReview && (
    <section class="section">
      <div class="container">
        <h2>A wedding night worth talking about.</h2>
        <ReviewCard review={weddingReview} excerpt="homepage" showFull={true} />
      </div>
    </section>
  )}

  {review && (
    <section class="section">
      <div class="container">
        <h2>Planning and communication matter too.</h2>
        <figure class="testimonial">
          <blockquote><p>“{review.excerpts.homepage}”</p></blockquote>
          <figcaption><strong>{review.name}</strong><br />{review.title}</figcaption>
        </figure>
      </div>
    </section>
  )}

  <section class="section alt">
    <div class="container">
      <h2>Explore local wedding entertainment.</h2>
      <div class="grid">
        <a class="card" href="/wedding-dj-columbia-sc/"><h3>Wedding DJ in Columbia</h3><p>Wedding entertainment for Columbia couples, with wedding bookings in South Carolina, North Carolina, and Georgia.</p></a>
        <a class="card" href="/wedding-dj-lexington-sc/"><h3>Wedding DJ in Lexington</h3><p>Wedding entertainment for Lexington couples, with wedding bookings in South Carolina, North Carolina, and Georgia.</p></a>
        <a class="card" href="/services/almost-married-trivia-experience/"><h3>Almost Married Trivia</h3><p>Customized couple trivia for wedding-weekend gatherings.</p></a>
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="container">
      <h2>Your people. Your stories. Your celebration.</h2>
      <p>Tell us your date, venue, guest count, and what you want the celebration to feel like.</p>
      <a class="button" href="/booking/?service=Wedding%20DJ%20%2F%20Entertainment">Plan your wedding</a>
    </div>
  </section>
</Base>
