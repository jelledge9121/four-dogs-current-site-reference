---
import WeddingClip from '../components/WeddingClip.astro';
import Base from '../layouts/Base.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { reviews } from '../data/reviews';
const review = reviews.find((item) => item.id === 'susan-leonard-facebook');
const weddingReview = reviews.find((item) => item.id === 'gabrielle-stephen-howland-wedding-google' && item.approved);
const weddingClips = [
  { src: '/videos/weddings/wedding-dance-floor-dj-lighting.mp4', poster: '/images/weddings/wedding-dance-floor-dj-lighting.webp', title: "A dance floor worth remembering", alt: "Wedding reception guests dancing beneath warm string lights", portrait: false },
  { src: '/videos/weddings/wedding-reception-celebration-ballroom.mp4', poster: '/images/weddings/wedding-reception-celebration-ballroom.webp', title: "A celebration in full swing", alt: "Wedding reception with colorful lighting and guests dancing", portrait: false },
  { src: '/videos/weddings/wedding-dancing-under-string-lights.mp4', poster: '/images/weddings/wedding-dancing-under-string-lights.webp', title: "Everyone's on the dance floor", alt: "Guests dancing together at a wedding reception under decorative lighting", portrait: false },
  { src: '/videos/weddings/wedding-reception-guests-dancing.mp4', poster: '/images/weddings/wedding-reception-guests-dancing.webp', title: "One more song", alt: "Wedding guests sharing the dance floor at an indoor reception", portrait: false },
  { src: '/videos/weddings/wedding-outdoor-tent-dancefloor.mp4', poster: '/images/weddings/wedding-outdoor-tent-dancefloor.webp', title: "An evening under the tent", alt: "Wedding celebration under a tent at night with the DJ setup visible", portrait: true },
  { src: '/videos/weddings/wedding-daytime-dancing.mp4', poster: '/images/weddings/wedding-daytime-dancing.webp', title: "A daytime celebration", alt: "Wedding guests dancing together at an open-sided covered reception", portrait: true },
  { src: '/videos/weddings/wedding-reception-dancing-glow-lights.mp4', poster: '/images/weddings/wedding-reception-dancing-glow-lights.webp', title: "The party keeps going", alt: "Wedding guests dancing with colored reception lighting", portrait: true },
  { src: '/videos/weddings/wedding-glow-stick-dancefloor.mp4', poster: '/images/weddings/wedding-glow-stick-dancefloor.webp', title: "Glow sticks and great songs", alt: "Wedding guests celebrating on a dance floor with colorful glow sticks", portrait: true },
  { src: '/videos/weddings/wedding-guests-dancing-under-lights.mp4', poster: '/images/weddings/wedding-guests-dancing-under-lights.webp', title: "Bring everybody out", alt: "Wedding guests dancing together beneath bright reception lights", portrait: true },
];
const highlights = [weddingClips[0], weddingClips[5]];
const moreClips = weddingClips.filter(clip => !highlights.includes(clip));
---
<Base title="Wedding DJ in Columbia & Lexington SC | Four Dogs Entertainment" description="Looking for a wedding DJ in Columbia or Lexington, SC? Four Dogs brings music planning, professional hosting, DJ entertainment and an energetic dance floor to your celebration.">
  <section class="section dark wedding-intro">
    <div class="container wedding-intro-grid">
    <div>
      <h1>The best celebrations feel like the people they’re celebrating.</h1>
      <p class="lead">Wedding DJ entertainment for Columbia, Lexington, and couples across South Carolina, built around your music, your people, and the moments that matter.</p>
      <a class="button" href="/booking/?service=Wedding%20DJ%20%2F%20Entertainment">Ask about your wedding date</a>
    </div><img src="/images/optimized/wedding-floor-800.webp" srcset="/images/optimized/wedding-floor-480.webp 480w, /images/optimized/wedding-floor-800.webp 800w" sizes="(max-width:800px) calc(100vw - 32px), 45vw" width="800" height="532" alt="A full dance floor at a Four Dogs wedding" fetchpriority="high"/>
    </div>
  </section>

  <section class="section wedding-moments" id="wedding-gallery" aria-labelledby="wedding-gallery-heading">
    <div class="container">
      <div class="wedding-gallery-heading">
        <div>
          <p class="eyebrow">Real weddings. Real moments.</p>
          <h2 id="wedding-gallery-heading">See the celebration.</h2>
        </div>
        <p>From ceremony music and introductions to your last song, we plan the sound and pacing around you.</p>
      </div>
      <figure class="wedding-gallery-feature">
        <a href="/images/weddings/four-dogs-wedding-outdoor-ceremony-under-willow.webp" target="_blank" rel="noopener noreferrer" aria-label="View the outdoor wedding ceremony photo in full size">
          <img src="/images/weddings/four-dogs-wedding-outdoor-ceremony-under-willow.webp" alt="Outdoor wedding ceremony beneath a willow tree with the couple, wedding party and seated guests" width="1440" height="1080" loading="lazy" decoding="async" />
        </a>
        <figcaption><strong>The moments that start it all.</strong> An outdoor ceremony with family and friends gathered close.</figcaption>
      </figure>
      <div class="wedding-photo-pair" aria-label="More real wedding moments">
        <figure>
          <img src="/images/weddings/wedding-reception-guests-dancing.webp" alt="Guests dancing together on the reception dance floor" loading="lazy" decoding="async" width="960" height="540" />
          <figcaption>When the reception gets going.</figcaption>
        </figure>
        <figure>
          <img src="/images/weddings/wedding-outdoor-tent-dancefloor.webp" alt="Outdoor wedding reception and dance floor beneath a tent" loading="lazy" decoding="async" width="540" height="960" />
          <figcaption>A different setting, the same good company.</figcaption>
        </figure>
      </div>
      <div class="wedding-video-heading">
        <h3>Watch the real celebrations.</h3>
        <p>Press play for real wedding reception highlights. Videos only load when you choose to watch.</p>
      </div>
      <div class="wedding-video-grid">
        {highlights.map(clip => <WeddingClip clip={clip} />)}
      </div>
      <div class="wedding-gallery-cta">
        {weddingReview && <ReviewCard review={weddingReview} excerpt="homepage" showFull={true} />}
        <a class="button" href="/booking/?service=Wedding%20DJ%20%2F%20Entertainment">Ask about your wedding date</a>
      </div>
      <details class="more-clips">
        <summary>See the other {moreClips.length} wedding clips</summary>
        <div class="wedding-video-grid">{moreClips.map(clip => <WeddingClip clip={clip} />)}</div>
      </details>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <h2>More laughs. More pictures. More memories.</h2>
      <p>Pair your wedding DJ with a professionally attended Four Dogs photo booth. Packages start at $450 for three hours, with instant digital photo sharing and an online gallery included. Prints, backdrops, extra hours, and travel can be added to your quote.</p>
      <a class="button" href="/services/photo-booth/">Explore Photo Booth Rentals</a>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div>
        <h2>Meet Almost Married Trivia.</h2>
        <p>Customized trivia about the couple for rehearsal dinners, engagement parties, wedding weekends, showers, and wedding-party gatherings.</p>
        <a class="button" href="/services/almost-married-trivia-experience/">Explore Almost Married</a>
      </div>
    </div>
  </section>

  {review && (
    <section class="section">
      <div class="container">
        <h2>Planning and communication matter too.</h2>
        <figure class="testimonial">
          <blockquote><p>“{review.excerpts.homepage}”</p></blockquote>
          <figcaption><strong>{review.name}</strong><br />{review.title}</figcaption>
        </figure>
      </div>
    </section>
  )}

  <section class="section alt">
    <div class="container">
      <h2>Explore local wedding entertainment.</h2>
      <div class="grid">
        <a class="card" href="/wedding-dj-columbia-sc/"><h3>Wedding DJ in Columbia</h3><p>Wedding entertainment for Columbia couples, with wedding bookings in South Carolina, North Carolina, and Georgia.</p></a>
        <a class="card" href="/wedding-dj-lexington-sc/"><h3>Wedding DJ in Lexington</h3><p>Wedding entertainment for Lexington couples, with wedding bookings in South Carolina, North Carolina, and Georgia.</p></a>
        <a class="card" href="/services/almost-married-trivia-experience/"><h3>Almost Married Trivia</h3><p>Customized couple trivia for wedding-weekend gatherings.</p></a>
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="container">
      <h2>Your people. Your stories. Your celebration.</h2>
      <p>Tell us your date, venue, guest count, and what you want the celebration to feel like.</p>
      <a class="button" href="/booking/?service=Wedding%20DJ%20%2F%20Entertainment">Ask about your wedding date</a>
    </div>
  </section>

<style>
  .wedding-moments { background: #f7f8fb; }
  .wedding-gallery-heading { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(250px, .75fr); gap: 2rem; align-items: end; margin-bottom: 2rem; }
  .wedding-gallery-heading .eyebrow { margin-bottom: .65rem; }
  .wedding-gallery-heading p:last-child { margin: 0 0 .75rem; font-size: 1.1rem; max-width: 35rem; }
  .wedding-gallery-feature { overflow: hidden; background: #0c0f26; color: #fff; border-radius: 3px; margin: 0; }
  .wedding-gallery-feature a { display: block; line-height: 0; }
  .wedding-gallery-feature img { display: block; width: 100%; height: auto; max-height: 680px; object-fit: cover; object-position: center 55%; }
  .wedding-gallery-feature figcaption { padding: 1rem 1.3rem 1.2rem; font-size: 1rem; color: #eef3f8; }
  .wedding-gallery-feature figcaption strong { color: #fff; }
  .wedding-photo-pair { display: grid; grid-template-columns: 1.3fr 1fr; gap: 1rem; margin-top: 1rem; }
  .wedding-photo-pair figure { margin: 0; }
  .wedding-photo-pair img { display: block; width: 100%; height: 280px; object-fit: cover; }
  .wedding-photo-pair figcaption { color: #48536a; padding: .55rem 0; font-size: .9rem; }
  .wedding-video-heading { margin: 3.25rem 0 1.4rem; }
  .wedding-video-heading h3 { font-size: clamp(1.6rem, 3vw, 2.3rem); margin-bottom: .4rem; }
  .wedding-video-heading p { margin: 0; color: #465568; }
  .wedding-video-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.25rem; align-items: start; }
  .wedding-gallery-feature a:focus-visible { outline: 3px solid #0C0F26; outline-offset: 3px; }
  .wedding-gallery-cta { margin-top: 2.8rem; padding-top: 1.6rem; border-top: 1px solid #d9e0e9; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; }
  .wedding-gallery-cta p { font-size: 1.15rem; font-weight: 800; margin: 0; }
  @media (max-width: 800px) { .wedding-gallery-heading { grid-template-columns: 1fr; gap: .3rem; } }
  @media (max-width: 550px) { .wedding-video-grid { gap: 1rem; } .wedding-gallery-feature img { max-height: none; } .wedding-gallery-cta { align-items: flex-start; } .wedding-photo-pair { grid-template-columns: 1fr; } .wedding-photo-pair img { height: auto; max-height: 360px; } }
  @media (prefers-reduced-motion: reduce) { .wedding-moments * { scroll-behavior: auto; } }
  .more-clips { margin-top: 2rem; }
  .more-clips summary { padding: 1rem 0; text-decoration: underline; }
</style>

</Base>
