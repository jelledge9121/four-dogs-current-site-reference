---
export const prerender=false;
import Base from '../../layouts/Base.astro';
import { configured, privateHeaders } from '../../lib/registration-auth';
import { registrationByCode } from '../../lib/registration-db';
import { eventDateLabel,easternTime } from '../../lib/registration-core';
import { allEvents } from '../../data/events';
import { venueById } from '../../data/venues';

const code=Astro.url.searchParams.get('code')?.trim().toUpperCase()||'';
if(!configured()) return new Response('Registration confirmation is not available yet.',{status:503,headers:privateHeaders()});
if(!/^FDE-[A-HJ-NP-Z2-9]{12}$/.test(code)) return new Response('Confirmation not found.',{status:404,headers:privateHeaders()});
const record=await registrationByCode(code);
if(!record) return new Response('Confirmation not found.',{status:404,headers:privateHeaders()});
const event=allEvents.find(e=>e.id===record.event_id);
if(!event) return new Response('This event is not available.',{status:404,headers:privateHeaders()});
const venue=venueById(event.venueId);
const eventEnded=event.status==='cancelled'||event.status==='postponed';
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('X-Robots-Tag','noindex,nofollow');
Astro.response.headers.set('Referrer-Policy','no-referrer');
---
<Base title="Your Event Registration Confirmation | Four Dogs" description="Your private Four Dogs event registration confirmation." noindex>
<section class="section"><div class="container"><h1>{record.cancelled_at?'Registration canceled':'Your group RSVP'}</h1>
<h2>{event.title}</h2><p>{venue.name} · {eventDateLabel(event)} · {event.startTime} Eastern</p>
<p>{record.name} · {record.group_size} expected attendees</p><a href={'/events/'+event.slug+'/'}>Event details and ticket information</a>
<p>Bookmark this private page to return. Anyone with the link can manage your RSVP.</p>
{!record.cancelled_at && <div><label>Expected group size <input type="number" id="size" min="1" max="50" value={record.group_size}/></label>
<button id="resize">Update estimate</button> <button id="cancel">Cancel registration</button></div>}
{!eventEnded && !record.cancelled_at && record.reward_kind==='appetizer' && record.voucher_expires && <section><h2>Charter 803 complimentary appetizer</h2><p>One complimentary appetizer per registered group. Expires {easternTime(record.voucher_expires)}.</p><strong>SCREENSHOTS ARE NOT ACCEPTED.</strong><p>You must open your live voucher on the Four Dogs Entertainment website when redeeming your complimentary appetizer. Screenshots, photos, printed copies, and recordings are not valid proof of redemption.</p><canvas id="qr"></canvas><details><summary>Camera fallback</summary><input readonly id="manual" aria-label="Live redemption token"/></details></section>}
<p id="message" role="status"></p></div></section>
<script>
import QRCode from 'qrcode';
const code=new URL(location.href).searchParams.get('code');
const msg=document.querySelector('#message')!;
async function request(action:string){
 const res=await fetch('/api/voucher/',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action,code,size:Number(document.querySelector<HTMLInputElement>('#size')?.value)})});
 const data=await res.json();if(!res.ok)throw Error(data.error);return data;
}
for(const action of ['resize','cancel'])document.getElementById(action)?.addEventListener('click',async()=>{
 if(action==='cancel'&&!confirm('Cancel this group RSVP?'))return;
 try{await request(action);location.reload()}catch(e){msg.textContent=String(e)}
});
const qr=document.querySelector<HTMLCanvasElement>('#qr');
async function refresh(){if(!qr)return;try{const {token}=await request('token');await QRCode.toCanvas(qr,token,{width:260});document.querySelector<HTMLInputElement>('#manual')!.value=token;msg.textContent=''}catch(e){qr.width=0;document.querySelector<HTMLInputElement>('#manual')!.value='';msg.textContent=String(e)}}
if(qr){refresh();setInterval(refresh,12000)}
</script></Base>