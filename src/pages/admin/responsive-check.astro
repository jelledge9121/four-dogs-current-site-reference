---
export const prerender=false;
if(!Astro.url.hostname.startsWith('deploy-preview-') && Astro.url.hostname!=='localhost') return new Response('Not found',{status:404});
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Four Dogs Preview Layout Check</title><style>body{margin:24px;font:16px system-ui;background:#F2F0E8;color:#0C0F26}label{display:block;margin:16px 0}select{font:inherit;padding:8px}iframe{width:390px;height:844px;border:2px solid #0C0F26;background:#fff;max-width:100%}</style></head><body><h1>Preview layout check</h1><p>This preview-only page shows the real calendar in a phone-width browsing frame.</p><label>Phone width <select id="width"><option value="320">320 px</option><option value="390" selected>390 px</option><option value="768">768 px</option></select></label><iframe title="Calendar at phone width" src="/events/"></iframe><script is:inline>document.querySelector('#width').addEventListener('change',event=>{document.querySelector('iframe').style.width=event.target.value+'px';});</script></body></html>
