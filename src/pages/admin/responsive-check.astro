---
export const prerender = false;
if (!Astro.url.hostname.startsWith('deploy-preview-') && Astro.url.hostname !== 'localhost') return new Response('Not found', { status: 404 });
const pages = [['Homepage','/'],['Calendar','/events/'],['Event','/events/spooky-vibes-music-bingo-costume-contest-bozes-2026-10-21/'],['Trivia','/services/trivia/'],['Music Bingo','/services/music-bingo/'],['Weddings','/weddings/'],['Booking','/booking/']];
const requested = Astro.url.searchParams.get('page') || '/';
const path = pages.some(([,path]) => path === requested) ? requested : '/';
const requestedWidth = Astro.url.searchParams.get('width') || '390';
const width = ['320','390','768','1280'].includes(requestedWidth) ? requestedWidth : '390';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Four Dogs Preview Layout Check</title><style>body{margin:16px;font:16px system-ui;background:#F2F0E8;color:#0C0F26}form{display:flex;flex-wrap:wrap;gap:16px;margin-bottom:16px}label{display:grid;gap:4px}select,button{font:inherit;padding:8px}iframe{height:844px;border:1px solid #0C0F26;background:#fff;display:block}h1{font-size:20px}</style></head><body><h1>Four Dogs responsive review</h1><form><label>Page<select name="page">{pages.map(([label,url])=><option value={url} selected={path===url}>{label}</option>)}</select></label><label>Viewport width<select name="width">{['320','390','768','1280'].map(value=><option value={value} selected={width===value}>{value} px</option>)}</select></label><button>Show page</button></form><iframe title="Four Dogs page at review width" src={path} style={`width:${width}px`}></iframe></body></html>
