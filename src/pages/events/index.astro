---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import RangeButton from '../../components/RangeButton.astro';
import EventCard from '../../components/EventCard.astro';
import { events } from '../../data/events';
import { venues } from '../../data/venues';
import { wescoThursdayNotice, showWescoNotice, wescoBingoUrl } from '../../data/announcements';
import { selectEvents, CATEGORIES, addDays, localToday, categorySlug, needsTicket } from '../../lib/event-system';
const q=Astro.url.searchParams;
const today=localToday();
const view=['archive','updates'].includes(q.get('view')||'') ? q.get('view')! : 'upcoming';
const validDate=(value:string|null) => value && /^\d{4}-\d{2}-\d{2}$/.test(value) && !Number.isNaN(Date.parse(value)) && new Date(`${value}T12:00:00Z`).toISOString().slice(0,10)===value ? value : '';
const from=validDate(q.get('from')) || (view==='upcoming' ? today : '');
const to=validDate(q.get('to')) || (view==='upcoming' ? addDays(today,29) : '');
const filters={view,from,to,city:q.get('city')||'',venue:q.get('venue')||'',category:q.get('category')||'',price:q.get('price')||''};
const matches=selectEvents(events,venues,filters);
// Keep old venue links usable, but omit retired venues from normal calendar choices.
const visibleVenues=venues.filter(v=>v.active || (view==='archive' && v.id===filters.venue));
const cities=[...new Set(venues.map(v=>v.city))].sort();
const hasFilters = !!(filters.city || filters.venue || filters.category || filters.price || q.has('from') || q.has('to'));
const monthStart = today.slice(0, 8) + '01';
const nextMonthStart = addDays(monthStart, 32).slice(0, 8) + '01';
const monthEnd = addDays(nextMonthStart, -1);
// The local calendar week runs Monday through Sunday, including across month and year boundaries.
const weekday = new Date(today + 'T12:00:00Z').getUTCDay();
const monday = addDays(today, -((weekday + 6) % 7));
const shortcuts = [
  {label:'Today', start:today, end:today},
  {label:'This Week', start:monday, end:addDays(monday,6)},
  {label:'Next Week', start:addDays(monday,7), end:addDays(monday,13)},
  {label:'This Month', start:monthStart, end:monthEnd},
];
const quickRange = shortcuts.some(range => from === range.start && to === range.end);
const advanced = !!(view !== 'upcoming' || filters.category || filters.venue || filters.price || (!quickRange && (q.has('from') || q.has('to'))));
const rangeFilters = ['city','venue','category','price'].flatMap(name => {
  const value = q.get(name);
  return value ? [{name,value}] : [];
});
const longRanges = [
  {label:'Next 7 days',start:today,end:addDays(today,6)},
  {label:'Next 30 days',start:today,end:addDays(today,29)},
  {label:'Explore the following 60 days',start:addDays(today,30),end:addDays(today,89)},
];
const featured = view === 'upcoming' && !hasFilters ? matches.find(event => event.id !== matches[0]?.id && event.featured && needsTicket(event) && event.registrationUrl) : undefined;
const shortDate = (date:string) => new Intl.DateTimeFormat('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'America/New_York'}).format(new Date(`${date}T12:00:00Z`));
const rangeLabel = from && to ? `${shortDate(from)} to ${shortDate(to)}` : '';
const selectedLabels = [filters.city, venues.find(v=>v.id===filters.venue)?.name, filters.category, filters.price==='free'?'Free admission':filters.price==='paid'?'Ticketed events':''].filter(Boolean);

---
<Base noindex={hasFilters || view !== 'upcoming'} title="Trivia, Music Bingo & Local Events in South Carolina | Four Dogs" description="Find confirmed Four Dogs trivia, Music Bingo, karaoke, and special events by date, city, venue, or activity. Exact times, admission details, and ticket links.">
<section class="calendar-intro"><div class="container"><h1>Find your next night out.</h1><p>South Carolina game nights and special events. All times Eastern.</p></div></section>
<section class="section calendar-body"><div class="container">
{view==='upcoming' && <nav class="date-shortcuts" aria-label="Quick date ranges">
  {shortcuts.slice(0,2).map(range => <RangeButton {...range} filters={rangeFilters} current={from===range.start && to===range.end}/>)}
</nav>}
<div class="discovery-form calendar-controls">
  <div class="location-picker">
    <label>Location<select name="city" form="calendar-filters"><option value="">All cities</option>{cities.map(city=><option value={city} selected={filters.city===city}>{city}</option>)}</select></label>
    <button class="button" form="calendar-filters" type="submit">Show events</button>
  </div>
  <details class="filter-disclosure" open={advanced}>
    <summary>Filter events</summary>
    <form id="calendar-filters" method="get" action="/events/#event-results" aria-label="Filter public events">
      <input type="hidden" name="view" value={view}/>
      <div class="discovery-advanced">
        <label>Entertainment type<select name="category"><option value="">All types</option>{CATEGORIES.map(c=><option value={c} selected={filters.category===c}>{c}</option>)}</select></label>
      <label>Venue<select name="venue"><option value="">All venues</option>{visibleVenues.map(v=><option value={v.id} selected={filters.venue===v.id}>{v.name}</option>)}</select></label>
      <label>Admission<select name="price"><option value="">Any admission</option><option value="free" selected={filters.price==='free'}>Free admission</option><option value="paid" selected={filters.price==='paid'}>Ticketed events</option></select></label>
      <label>From<input type="date" name="from" value={from}/></label><label>Through<input type="date" name="to" value={to}/></label>
      </div>
      <div class="actions"><button class="button" type="submit">Apply filters</button></div>
    </form>
    {view==='upcoming' && <nav class="date-shortcuts" aria-label="More date ranges">
      {shortcuts.slice(2).map(range => <RangeButton {...range} filters={rangeFilters} current={from===range.start && to===range.end}/>)}
    </nav>}
    <nav class="event-tabs" aria-label="Event listings"><a href="/events/" aria-current={view==='upcoming'?'page':undefined}>Upcoming events</a><a href="/events/?view=updates" aria-current={view==='updates'?'page':undefined}>Cancellations & updates</a><a href="/events/?view=archive" aria-current={view==='archive'?'page':undefined}>Past events</a></nav>
  </details>
  {hasFilters && <a href={view==='upcoming'?'/events/':'/events/?view='+view}>Clear filters</a>}
</div>
<div class="calendar-results-heading"><h2 id="event-results" tabindex="-1">{view==='archive'?'Past Four Dogs events':view==='updates'?'Schedule changes':'Coming up'}</h2>
<p>{selectedLabels.length>0 && selectedLabels.join(' · ')+' · '}{matches.length} {matches.length===1?'event':'events'}{rangeLabel ? ` · ${rangeLabel}` : ''}</p></div>
{from && to && from>to ? <p role="alert">Choose a “Through” date on or after the “From” date.</p> : matches.length ? <div class="event-list">{matches.map(event=><EventCard event={event}/>)}</div> : <div class="empty-events"><h3>No matching events are currently confirmed.</h3><p>Try another city, activity, or date range. New dates appear here once confirmed.</p><a href="/events/">See the next 30 days</a></div>}
{view === 'upcoming' && <div class="actions">{longRanges.map(range=><RangeButton {...range} filters={rangeFilters} current={from===range.start && to===range.end}/>)}</div>}
{featured && <aside class="calendar-note"><strong>Featured ticketed event</strong><p><a href={`/events/${featured.slug}/`}>{featured.title}</a> · {shortDate(featured.date)} · {featured.startTime} Eastern</p></aside>}
{view === 'upcoming' && filters.venue === 'wesco' && showWescoNotice(today) && <aside class="calendar-note"><strong>Thursday at WesCo</strong><p>{wescoThursdayNotice} <a href={wescoBingoUrl}>See Music Bingo dates</a></p></aside>}
<details><summary>Browse by activity</summary><div class="actions">{CATEGORIES.map(c=><a href={`/events/category/${categorySlug(c)}/`}>{c}</a>)}</div></details>
</div></section>
<section class="section dark"><div class="container"><h2>Bring your people. We’ll bring the Doggone Good Time.</h2><a class="button" href="/booking/">Plan your own event</a></div></section>
<style>
  .location-picker { display:flex; align-items:end; flex-wrap:wrap; gap:.55rem; }
  .location-picker label { flex:1 1 10rem; max-width:25rem; }
  .calendar-controls { padding:.7rem 0 .2rem; }
  .calendar-controls details { margin:.15rem 0 0; }
  .calendar-controls summary { min-height:44px; }
  .calendar-controls form .actions { margin-block:1rem; }
  @media (max-width:600px) {
    .calendar-body { padding-top:.25rem; }
    .calendar-body .date-shortcuts { margin:.5rem 0; }
    .calendar-results-heading { margin:.75rem 0; }
    .calendar-intro { padding-block:1rem; }
  }
</style>
</Base>
