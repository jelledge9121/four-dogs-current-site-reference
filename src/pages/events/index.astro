---
import Base from '../../layouts/Base.astro'; import EventCard from '../../components/EventCard.astro'; import {upcomingEvents} from '../../data/events'; import {venues} from '../../data/venues'; const upcoming=upcomingEvents();
---
<Base title="Upcoming Events | Four Dogs Entertainment" description="See weekly Four Dogs trivia, Music Bingo, and interactive game nights in Columbia and Lexington, South Carolina."><section class="section dark"><div class="container"><p class="eyebrow">Find an event</p><h1>Come play with the pack.</h1><p class="lead">First, find the weekly night that fits. Then see which special themes are coming up.</p></div></section><section class="section alt"><div class="container"><h2>Play every week</h2><div class="grid">{venues.map(v=>v.weeklySchedule.map(s=><article class="card"><p class="eyebrow">{s.day}</p><h3><a href={`/venues/${v.slug}/`}>{v.name}</a></h3><p>{s.format}<br><strong>{s.time}</strong><br>{v.city}</p></article>))}</div></div></section><section class="section"><div class="container"><h2>Coming up</h2>{upcoming.length?<div class="grid">{upcoming.map(e=><EventCard event={e}/>)}</div>:<p>No dated events are currently listed. Check the weekly schedule above and follow Four Dogs for theme announcements.</p>}</div></section></Base>
