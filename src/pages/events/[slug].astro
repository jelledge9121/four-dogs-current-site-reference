---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { allEvents } from '../../data/events';
import { venueById } from '../../data/venues';
import { categorySlug, eventSchema, formatDate, isPublic, phase, startIso, statusLabel } from '../../lib/event-system';
const event=allEvents.find(e=>e.slug===Astro.params.slug && e.visibility==='public' && e.publicationStatus!=='draft');
if(!event) return new Response('Event not found',{status:404,headers:{'Content-Type':'text/plain; charset=utf-8','X-Robots-Tag':'noindex'}});
const venue=venueById(event.venueId);
const published=isPublic(event);
const state=phase(event);
const canAttend=published && ['upcoming','live'].includes(state);
const admissionText=event.admission.verified ? event.admission.note || (event.admission.kind==='free'?'Free admission.':`$${event.admission.price} per person.`) : 'Contact the venue for admission details.';
const previousDate=event.previousStartDate ? new Intl.DateTimeFormat('en-US',{dateStyle:'long',timeStyle:'short',timeZone:'America/New_York'}).format(new Date(event.previousStartDate)) : '';
const title=event.seoTitle || `${event.title} | ${event.date} | Four Dogs Entertainment`;
const description=event.metaDescription || `${event.title} at ${venue.name}, ${venue.city}, SC. ${formatDate(event.date)}${event.startTime ? ` at ${event.startTime}` : ''}. ${admissionText} See event details.`;
---
<Base title={title} description={description} image={event.image} schema={eventSchema(event,venue)} noindex={!published}>
<Breadcrumbs items={[{name:'Home',href:'/'},{name:'Events',href:'/events/'},{name:event.title}]}/>
<section class="section dark"><div class="container"><p class="eyebrow">{event.eventType}</p><h1>{event.title}</h1><p class="lead"><time datetime={startIso(event)}>{formatDate(event.date)}</time><br/>{event.startTime || 'Start time to be confirmed'}{event.endTime?` to ${event.endTime}`:''}{event.endDate && event.endDate!==event.date?` (${formatDate(event.endDate)})`:''} · Eastern Time<br/><a href={`/venues/${venue.slug}/`}>{venue.name}</a> · {venue.city}, {venue.state}</p><p class="event-status" role="status">{published ? statusLabel(event) : 'Details are being confirmed. Check back before making plans.'}</p>{event.status==='rescheduled' && <p>Previously scheduled for {previousDate} Eastern Time.</p>}</div></section>
<section class="section"><div class="container split"><div><h2>{canAttend?'Come play':'Event details'}</h2><p>{event.description}</p><h3>Where to go</h3><address>{venue.name}<br/>{venue.address}<br/>{venue.city}, {venue.state} {venue.zip}</address><h3>Admission</h3><p>{admissionText}</p><h3>How to join</h3><p>{event.status==='cancelled' ? 'This event is canceled. Contact Four Dogs for any ticket or registration updates.' : event.status==='postponed' ? 'The replacement date has not been confirmed. Contact Four Dogs for ticket and registration updates.' : event.instructions}</p><div class="actions">{canAttend && event.registrationUrl && <a class="button" href={event.registrationUrl} target="_blank" rel="noopener noreferrer">{event.registrationLabel || 'Registration details'}</a>}<a href={venue.mapUrl} target="_blank" rel="noopener noreferrer">Get directions</a><a href={`/venues/${venue.slug}/`}>More at {venue.name}</a><a href={`/events/category/${categorySlug(event.eventType)}/`}>More {event.eventType}</a><a href="/events/">All events</a></div><p class="fine">Event details updated <time datetime={event.lastUpdated}>{new Intl.DateTimeFormat('en-US',{dateStyle:'long',timeZone:'America/New_York'}).format(new Date(event.lastUpdated))}</time>.</p></div><img src={event.image} alt={event.imageAlt || 'Four Dogs Entertainment event photograph'} width="1200" height="800" loading="lazy"/></div></section>
</Base>
