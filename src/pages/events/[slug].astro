---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { events, type Event } from '../../data/events';
import { venueById } from '../../data/venues';

type Props = {
  event: Event;
};

export function getStaticPaths() {
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props as Props;
const venue = venueById(event.venueId);
const past = event.date < new Date().toISOString().slice(0, 10);
const isoTime = new Date(`${event.date} ${event.startTime}`).toISOString();

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  startDate: isoTime,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: venue.name,
    address: {
      '@type': 'PostalAddress',
      streetAddress: venue.address,
      addressLocality: venue.city,
      addressRegion: venue.state,
      postalCode: venue.zip,
      addressCountry: 'US',
    },
  },
  organizer: {
    '@type': 'Organization',
    name: 'Four Dogs Entertainment',
    url: 'https://4dogsentertainment.com',
  },
};
---
<Base
  title={`${event.title} — ${event.date} | Four Dogs Entertainment`}
  description={`${event.title} at ${venue.name} in ${venue.city}, SC on ${event.date} at ${event.startTime}.`}
  schema={schema}
>
  <Breadcrumbs
    items={[
      { name: 'Home', href: '/' },
      { name: 'Events', href: '/events/' },
      { name: event.title },
    ]}
  />

  <section class="section dark">
    <div class="container">
      <p class="eyebrow">{past ? 'Event archive' : event.eventType}</p>
      <h1>{event.title}</h1>
      <p class="lead">
        {event.date} · {event.startTime}<br />
        {venue.name} · {venue.city}, {venue.state}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <h2>{past ? 'This event has passed' : 'Come play'}</h2>
        <p>{event.description}</p>
        <p>
          {venue.address}
          {venue.zip && <>, {venue.zip}</>}
        </p>
        <div class="actions">
          <a class="button" href={venue.mapUrl} target="_blank" rel="noopener noreferrer">Get directions</a>
          <a href="/events/">See all events</a>
        </div>
      </div>
      <img src={event.image} alt={`Four Dogs entertainment at ${venue.name}`} />
    </div>
  </section>
</Base>
