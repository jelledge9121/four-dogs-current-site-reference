---
import { easternToday, localIsoDateTime } from '../../lib/event-time.mjs';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { events, type Event } from '../../data/events';
import { venueById } from '../../data/venues';

type Props = {
  event: Event;
};

export function getStaticPaths() {
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props as Props;
const venue = venueById(event.venueId);
const locationName = event.locationName ?? venue.name;
const isPast = event.date < easternToday();
const eventbrite = {
  charterTrivia: 'https://www.eventbrite.com/e/trivia-at-charter-803-hosted-by-four-dogs-entertainment-tickets-1998508023296?aff=oddtdtcreator',
  topDawgTrivia: 'https://www.eventbrite.com/e/weekly-trivia-at-top-dawg-tavern-ne-hosted-by-four-dogs-entertainment-tickets-1998507457604?aff=oddtdtcreator',
  charterMusicBingo: 'https://www.eventbrite.com/e/music-bingo-at-charter-803-hosted-by-four-dogs-entertainment-tickets-1998507656198?aff=oddtdtcreator',
  wescoTrivia: 'https://www.eventbrite.com/e/weekly-trivia-at-wesco-brew-and-bowl-hosted-by-four-dogs-entertainment-tickets-1998507141659?aff=oddtdtcreator',
};

function eventbriteUrlFor(event: Event) {
  if (event.ticketed) return undefined;

  if (event.venueId === 'top-dawg') {
    return event.eventType === 'Trivia' ? eventbrite.topDawgTrivia : undefined;
  }

  if (event.venueId === 'wesco') {
    return event.eventType === 'Trivia' ? eventbrite.wescoTrivia : undefined;
  }

  if (event.venueId === 'charter-803') {
    if (event.eventType === 'Music Bingo') return eventbrite.charterMusicBingo;
    if (event.eventType === 'Trivia') return eventbrite.charterTrivia;
  }

  return undefined;
}


const registrationUrl = event.registrationUrl ?? eventbriteUrlFor(event);
const eventUrl = new URL(Astro.url.pathname, 'https://4dogsentertainment.com').toString();
const imageUrl = new URL(event.image, 'https://4dogsentertainment.com').toString();

const statusMap = {
  scheduled: 'https://schema.org/EventScheduled',
  cancelled: 'https://schema.org/EventCancelled',
  postponed: 'https://schema.org/EventPostponed',
} as const;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  startDate: localIsoDateTime(event.date, event.startTime),
  ...(event.endTime ? { endDate: localIsoDateTime(event.date, event.endTime) } : {}),
  eventStatus: statusMap[event.status],
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  url: eventUrl,
  image: [imageUrl],
  description: event.description,
  location: {
    '@type': 'Place',
    name: locationName,
    ...(!event.locationName ? { address: {
      '@type': 'PostalAddress',
      streetAddress: venue.address,
      addressLocality: venue.city,
      addressRegion: venue.state,
      postalCode: venue.zip,
      addressCountry: 'US',
    } } : {}),
  },
  ...(registrationUrl
    ? {
        offers: {
          '@type': 'Offer',
          url: registrationUrl,
        },
      }
    : {}),
  organizer: {
    '@type': 'Organization',
    name: 'Four Dogs Entertainment',
    url: 'https://4dogsentertainment.com',
  },
};
---
<Base
  title={`${event.title} — ${event.date} | Four Dogs Entertainment`}
  description={`${event.title} at ${locationName}${event.locationName ? '' : ` in ${venue.city}, SC`} on ${event.date}${event.startTime ? ` at ${event.startTime}` : ''}.`}
  schema={isPast ? [] : schema}
>
  <div data-event-archive-date={event.date}>
  <Breadcrumbs
    items={[
      { name: 'Home', href: '/' },
      { name: 'Events', href: '/events/' },
      { name: event.title },
    ]}
  />

  <section class="section dark" data-event-detail-date={event.date}>
    <div class="container">
      <p class="eyebrow"><span data-future-only hidden={isPast}>{event.eventType}</span><span data-past-only hidden={!isPast}>Event archive</span></p>
      <h1>{event.title}</h1>
      <p class="lead">
        {event.date}{event.startTime ? ` · ${event.startTime}` : ' · Time TBA'}<br />
        {locationName}{!event.locationName && <> · {venue.city}, {venue.state}</>}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <h2><span data-future-only hidden={isPast}>Come play</span><span data-past-only hidden={!isPast}>This event has passed</span></h2>
        <p>{event.description}</p>
        {!event.locationName && <p>
          {venue.address}
          {venue.zip && <>, {venue.zip}</>}
        </p>}
        <div class="actions">
          {!isPast && registrationUrl && (
            <a class="button" data-future-only hidden={isPast} href={registrationUrl} target="_blank" rel="noopener noreferrer">
              {event.registrationLabel ?? (event.ticketed ? 'Get tickets' : 'View event details')}
            </a>
          )}
          {!isPast && event.ticketed && !registrationUrl && <span class="tag" data-future-only hidden={isPast}>Ticket details coming soon</span>}
          {!event.locationName && <a class={registrationUrl ? undefined : 'button'} href={venue.mapUrl} target="_blank" rel="noopener noreferrer">Get directions</a>}
          <a href="/events/">See all events</a>
        </div>
      </div>
      <img loading="lazy" decoding="async" width="800" height="600" src={event.image} alt="Guests at a Four Dogs Entertainment event" />
    </div>
  </section>
  </div>
</Base>
