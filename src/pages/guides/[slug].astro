---
import Base from '../../layouts/Base.astro';
import guides from '../../data/guides.json';
import EventList from '../../components/EventList.astro';
import { venueById } from '../../data/venues';
export const prerender = false;
const guide = guides.find(item => item.slug === Astro.params.slug);
if (!guide) return new Response('Guide not found', {status:404});
const schedules: Record<string, [string, string]> = {
  'where-to-play-music-bingo-lexington-sc': ['charter-803','Music Bingo'],
  'music-bingo-in-lexington-sc': ['charter-803','Music Bingo'],
  'best-trivia-nights-lexington-sc': ['charter-803','Trivia'],
  'where-to-play-trivia-fountain-inn-sc': ['the-mill',''],
  'are-you-smarter-than-a-barstool-game-night': ['the-mill','Are You Smarter Than a Barstool?'],
};
const schedule = schedules[guide.slug];
const venue = schedule && venueById(schedule[0]);
const guideService = guide.slug.includes('wedding') ? 'Wedding DJ / Entertainment'
  : guide.slug.includes('restaurant') || guide.slug.includes('slow-tuesday') || guide.slug.includes('why-trivia-nights-fail') ? 'Venue Entertainment'
  : guide.slug.includes('music-bingo') ? 'Music Bingo' : guide.slug.includes('dj-services') ? 'DJ'
  : guide.slug.includes('private-event') ? 'Private Event' : guide.slug.includes('barstool') ? 'Are You Smarter Than a Barstool?' : 'Trivia';
const articleSchema={'@context':'https://schema.org','@type':'Article',headline:guide.title,description:guide.description,mainEntityOfPage:new URL(Astro.url.pathname,'https://4dogsentertainment.com').toString(),...(guide.published?{datePublished:guide.published,dateModified:guide.published}:{}),author:{'@type':'Organization',name:'Four Dogs Entertainment'},publisher:{'@type':'Organization',name:'Four Dogs Entertainment',url:'https://4dogsentertainment.com'}};
---
<Base title={`${guide.title} | Four Dogs Entertainment`} description={guide.description} schema={articleSchema}>
  <section class="section dark"><div class="container"><p class="eyebrow">{guide.category ?? 'Four Dogs guide'}</p><h1>{guide.title}</h1><p class="lead">{guide.description}</p>{guide.published && <p class="fine">Published {new Date(`${guide.published}T12:00:00`).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}</p>}</div></section>
  {venue && <section class="section alt" aria-labelledby="guide-dates"><div class="container">
    <h2 id="guide-dates">Coming up at {venue.name}</h2>
    <EventList venue={venue.id} category={schedule[1]} limit={3} days={90}/>
    <div class="actions"><a href={`/venues/${venue.slug}/`}>Full {venue.name} schedule →</a><a href="/events/">All Four Dogs events</a></div>
  </div></section>}
  <article class="section"><div class="container prose">
    {guide.blocks.slice(2).map((block) => block.tag === 'h2' ? <h2>{block.text}</h2> : block.tag === 'h3' ? <h3>{block.text}</h3> : block.tag === 'li' ? <ul><li>{block.text}</li></ul> : <p>{block.text}</p>)}
    {(guide.relatedLinks ?? []).length > 0 && (
      <aside class="card" style="margin-top:2rem">
        <p class="eyebrow">Keep exploring</p>
        <h2>Plan your next Four Dogs night.</h2>
        <div class="actions">{(guide.relatedLinks ?? []).map((link) => <a href={link.href}>{link.label} →</a>)}</div>
      </aside>
    )}
    <div class="actions"><a class="button" href={`/booking/?service=${encodeURIComponent(guideService)}`}>Plan an event</a><a href="/guides/">More guides</a></div>
  </div></article>
</Base>
