---
import Base from '../../layouts/Base.astro';
import guides from '../../data/guides.json';
export function getStaticPaths(){return guides.map(guide=>({params:{slug:guide.slug},props:{guide}}))}
const {guide}=Astro.props;
const articleSchema={'@context':'https://schema.org','@type':'Article',headline:guide.title,description:guide.description,mainEntityOfPage:new URL(Astro.url.pathname,'https://4dogsentertainment.com').toString(),...(guide.published?{datePublished:guide.published,dateModified:guide.published}:{}),author:{'@type':'Organization',name:'Four Dogs Entertainment'},publisher:{'@type':'Organization',name:'Four Dogs Entertainment',url:'https://4dogsentertainment.com'}};
---
<Base title={`${guide.title} | Four Dogs Entertainment`} description={guide.description} schema={articleSchema}>
  <section class="section dark"><div class="container"><p class="eyebrow">{guide.category ?? 'Four Dogs guide'}</p><h1>{guide.title}</h1><p class="lead">{guide.description}</p>{guide.published && <p class="fine">Published {new Date(`${guide.published}T12:00:00`).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}</p>}</div></section>
  <article class="section"><div class="container prose">
    {guide.blocks.slice(2).map((block) => block.tag === 'h2' ? <h2>{block.text}</h2> : block.tag === 'h3' ? <h3>{block.text}</h3> : block.tag === 'li' ? <ul><li>{block.text}</li></ul> : <p>{block.text}</p>)}
    {guide.relatedLinks?.length > 0 && (
      <aside class="card" style="margin-top:2rem">
        <p class="eyebrow">Keep exploring</p>
        <h2>Plan your next Four Dogs night.</h2>
        <div class="actions">{guide.relatedLinks.map((link) => <a href={link.href}>{link.label} →</a>)}</div>
      </aside>
    )}
    <div class="actions"><a class="button" href="/booking/">Plan an event</a><a href="/guides/">More guides</a></div>
  </div></article>
</Base>
