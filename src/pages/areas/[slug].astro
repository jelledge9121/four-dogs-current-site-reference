        { name: 'Weddings', description: 'Wedding DJ entertainment and interactive wedding-weekend options.', href: '/wedding-dj-lexington-sc/' },
        { name: 'Venue entertainment', description: 'Recurring hosted programming for bars and restaurants.', href: '/for-venues/' },
      ],
      nearby: ['Lexington', 'Lake Murray area', 'West Columbia', 'Cayce', 'Irmo', 'Columbia and surrounding Midlands communities'],
      venueIds: ['charter-803'],
      faqs: [
        { question: 'Where can I find recurring Four Dogs events in Lexington?', answer: 'Charter 803 Bar & Grill currently hosts Wednesday Music Bingo and Thursday trivia or specialty game nights. Check the Events page for the current schedule.' },
        { question: 'Can I book Four Dogs for a Lexington wedding or private party?', answer: 'Yes. Four Dogs offers wedding DJ entertainment, private-event DJ services, Trivia, Music Bingo, Karaoke, and interactive game formats.' },
        { question: 'Does Four Dogs work with Lexington restaurants and bars?', answer: 'Yes. Four Dogs works with venue partners on recurring hosted entertainment and one-time events.' },
      ],
    },
    {
      slug: 'columbia-sc',
      name: 'Columbia',
      title: 'Columbia SC Entertainment | Trivia, DJ & Events | Four Dogs',
      description: 'Four Dogs Entertainment provides trivia, DJ entertainment, weddings, private events, corporate events, and venue programming in Columbia, South Carolina.',
      lead: 'Public trivia plus bookable DJ, wedding, private, corporate, community, and venue entertainment across Columbia.',
      intro: [
        'Four Dogs Entertainment serves Columbia with recurring public programming and bookable entertainment for venues, businesses, organizations, weddings, and private events.',
        'Top Dawg Tavern at Village at Sandhill currently hosts Four Dogs trivia and rotating game experiences on Tuesdays at 6:30 PM. Public dates and themes should always be confirmed on the Events page.',
      ],
      services: [
        { name: 'Trivia in Columbia', description: 'Recurring public trivia plus private and venue-hosted options.', href: '/trivia-night-columbia-sc/' },
        { name: 'Music Bingo in Columbia', description: 'Bookable Music Bingo for venues, businesses, and private groups.', href: '/music-bingo-columbia-sc/' },
        { name: 'DJ services', description: 'DJ entertainment for celebrations, formals, organizations, and private events.', href: '/dj-services-columbia-sc/' },
        { name: 'Weddings', description: 'Wedding DJ entertainment and Almost Married Trivia options.', href: '/wedding-dj-columbia-sc/' },
        { name: 'Restaurant entertainment', description: 'Recurring hosted programming for Columbia bars and restaurants.', href: '/restaurant-entertainment-columbia-sc/' },
        { name: 'Corporate events', description: 'Interactive entertainment for companies and organizations.', href: '/corporate-event-entertainment-columbia-sc/' },
      ],
      nearby: ['Columbia', 'Northeast Columbia', 'Forest Acres area', 'West Columbia', 'Cayce', 'Lexington and surrounding Midlands communities'],
      venueIds: ['top-dawg'],
      faqs: [
        { question: 'Where can I play Four Dogs trivia in Columbia?', answer: 'Top Dawg Tavern at Village at Sandhill currently hosts Four Dogs trivia and rotating game experiences on Tuesdays at 6:30 PM.' },
        { question: 'Does Four Dogs offer DJ and wedding entertainment in Columbia?', answer: 'Yes. Four Dogs offers DJ entertainment for weddings, private events, formals, businesses, organizations, and community gatherings.' },
        { question: 'Can a Columbia restaurant book recurring entertainment?', answer: 'Yes. Four Dogs works with bars and restaurants on recurring trivia, Music Bingo, and compatible specialty game formats.' },
      ],
    },
    {
      slug: 'irmo-chapin-sc',
      name: 'Irmo & Chapin',
      title: 'Irmo & Chapin SC Event Entertainment | Four Dogs Entertainment',
      description: 'Book Four Dogs Entertainment for DJ events, trivia, Music Bingo, weddings, private parties, communities, organizations, and venue entertainment in Irmo and Chapin, South Carolina.',
      lead: 'Bookable Four Dogs entertainment for celebrations, organizations, communities, and venues in the Irmo and Chapin area.',
      intro: [
        'Four Dogs offers entertainment booking options for Irmo and Chapin events, including DJ entertainment, Trivia, Music Bingo, Karaoke, weddings, private events, corporate events, and interactive specialty formats.',
