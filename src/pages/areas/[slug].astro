      ],
    },
    {
      slug: 'west-columbia-cayce-sc',
      name: 'West Columbia & Cayce',
      title: 'West Columbia & Cayce SC Trivia & Event Entertainment | Four Dogs',
      description: 'Find weekly Four Dogs trivia at WesCo Brew & Bowl in Cayce and book Four Dogs Entertainment for DJ events, Music Bingo, private parties, companies, communities, and venue entertainment in West Columbia and Cayce, South Carolina.',
      lead: 'Weekly trivia in Cayce plus entertainment for West Columbia and Cayce private events, communities, organizations, celebrations, and venue partners.',
      intro: [
        'Four Dogs provides recurring and bookable entertainment throughout West Columbia and Cayce, including Trivia, DJ services, Music Bingo, Karaoke, weddings, private events, community events, and interactive specialty games.',
        'WesCo Brew & Bowl at 3040 Charleston Highway in Cayce, located in the former Piggly Wiggly, hosts Four Dogs Trivia every Tuesday at 6:30 PM beginning September 8, 2026. Check the Events page for the current weekly themes and exact dates.',
      ],
      services: [
        { name: 'Trivia', description: 'Weekly Cayce trivia plus traditional, themed, and specialty hosted trivia for venues and groups.', href: '/services/trivia/' },
