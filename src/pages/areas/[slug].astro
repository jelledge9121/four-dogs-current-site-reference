      ],
      services: [
        { name: 'Private & corporate events', description: 'Interactive entertainment for companies, organizations, communities, and parties.', href: '/services/private-corporate-events/' },
        { name: 'Weddings', description: 'Wedding DJ entertainment and personalized wedding-weekend options.', href: '/weddings/' },
        { name: 'Trivia', description: 'Hosted general knowledge, themed trivia, and specialty formats.', href: '/services/trivia/' },
