        { question: 'Can a West Columbia or Cayce venue ask about recurring Trivia or Music Bingo?', answer: 'Yes. Venue partners can use the booking form to discuss recurring programming or a test event.' },
        { question: 'Where can I see current public events?', answer: 'The Events page lists the current Four Dogs public schedule, including the WesCo Brew & Bowl Tuesday lineup.' },
      ],
    },
  ];

  return areas.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}

const { area } = Astro.props as Props;
const areaVenues = venues.filter((venue) => area.venueIds.includes(venue.id));
const areaEvents = upcomingEvents().filter((event) => area.venueIds.includes(event.venueId)).slice(0, 4);
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: area.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---
<Base title={area.title} description={area.description} schema={faqSchema}>
  <section class="section dark">
    <div class="container">
      <p class="eyebrow">South Carolina entertainment</p>
      <h1>{area.name}</h1>
      <p class="lead">{area.lead}</p>
      <div class="actions">
        <a class="button" href="/events/">Find an event</a>
        <a class="button secondary" href="/booking/">Book Four Dogs</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="prose">{area.intro.map((paragraph) => <p>{paragraph}</p>)}</div>
      <img src="/images/hero.jpg" alt={`Four Dogs Entertainment in ${area.name}, South Carolina`} loading="lazy" />
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <p class="eyebrow">Entertainment options</p>
      <h2>Ways to bring people together in {area.name}.</h2>
      <div class="grid">
        {area.services.map((service) => (
          <a class="card" href={service.href}><h3>{service.name}</h3><p>{service.description}</p><p>Learn more →</p></a>
        ))}
      </div>
    </div>
  </section>

  {areaVenues.length > 0 && (
    <section class="section">
      <div class="container">
        <p class="eyebrow">Current venue partners</p>
        <h2>See Four Dogs in the room.</h2>
        <div class="grid">
          {areaVenues.map((venue) => (
            <a class="card" href={`/venues/${venue.slug}/`}>
              <h3>{venue.name}</h3>
              <p>{venue.description}</p>
              {venue.weeklySchedule.map((schedule) => <p><strong>{schedule.day} at {schedule.time}</strong><br />{schedule.format}</p>)}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {areaEvents.length > 0 && (
    <section class="section alt">
      <div class="container">
        <p class="eyebrow">Coming up</p>
        <h2>Upcoming Four Dogs events in {area.name}.</h2>
        <div class="grid">{areaEvents.map((event) => <EventCard event={event} />)}</div>
        <div class="actions"><a class="button" href="/events/">See all events</a></div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Service area</p>
        <h2>Serving {area.name} and nearby Midlands communities.</h2>
      </div>
      <ul>{area.nearby.map((place) => <li>{place}</li>)}</ul>
    </div>
  </section>

  <section class="section alt">
    <div class="container holiday-callout">
      <p class="eyebrow">Seasonal add-on</p>
      <h2>Looking for traditional holiday magic in {area.name}?</h2>
      <p>Pair Four Dogs DJ entertainment, Music Bingo, trivia, or hosted games with a traditional real-beard Santa Jim appearance for company parties, HOA celebrations, community events, and family-friendly gatherings.</p>
      <div class="actions">
        <a class="button" href="/christmas/">Explore Christmas & Santa Jim</a>
        <a href="/booking/?service=Christmas%20%2F%20Holiday%20Entertainment">Plan a holiday event →</a>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <p class="eyebrow">Frequently asked questions</p>
      <h2>Planning entertainment in {area.name}.</h2>
      <div class="prose">
        {area.faqs.map((faq) => <section><h3>{faq.question}</h3><p>{faq.answer}</p></section>)}
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="container">
      <h2>Bring your people. We’ll bring the Doggone Good Time.</h2>
      <p>Tell us what you are planning in {area.name}.</p>
      <a class="button" href="/booking/">Book Four Dogs</a>
    </div>
  </section>
</Base>
