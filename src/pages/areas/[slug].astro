        { name: 'DJ entertainment', description: 'Music and hosting for celebrations and private events.', href: '/private-event-dj-midlands-sc/' },
        { name: 'Music Bingo', description: 'Interactive music-based entertainment for venues and groups.', href: '/services/music-bingo/' },
      ],
      nearby: ['West Columbia', 'Cayce', 'Lexington', 'Columbia', 'Lake Murray area and surrounding Midlands communities'],
      venueIds: ['wesco'],
      faqs: [
