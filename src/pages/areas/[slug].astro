      ],
      nearby: ['Irmo', 'Chapin', 'Lake Murray area', 'Lexington', 'Columbia and surrounding Midlands communities'],
      venueIds: [],
      faqs: [
        { question: 'Can Four Dogs come to an Irmo or Chapin private event?', answer: 'Yes. Four Dogs books private, community, company, wedding, and organizational entertainment throughout the Midlands.' },
