---
import Base from '../../layouts/Base.astro';
import EventCard from '../../components/EventCard.astro';
import { venues } from '../../data/venues';
import { upcomingEvents } from '../../data/events';

type Area = {
  slug: string;
  name: string;
  title: string;
  description: string;
  lead: string;
  intro: string[];
  services: { name: string; description: string; href: string }[];
  nearby: string[];
  venueIds: string[];
  faqs: { question: string; answer: string }[];
};

type Props = { area: Area };

export function getStaticPaths() {
  const areas: Area[] = [
    {
      slug: 'lexington-sc',
      name: 'Lexington',
      title: 'Lexington SC Entertainment | Trivia, Music Bingo & DJ | Four Dogs',
      description: 'Four Dogs Entertainment provides trivia, Music Bingo, DJ entertainment, weddings, private events, and venue programming in Lexington, South Carolina.',
      lead: 'Recurring public events and bookable entertainment for Lexington venues, couples, businesses, communities, and private groups.',
      intro: [
        'Four Dogs Entertainment is active in Lexington with recurring public events plus wedding, private-event, community, and venue entertainment throughout the area.',
