---
export const prerender=false;
import Base from '../../layouts/Base.astro';
import { configured, readSession } from '../../lib/registration-auth';
import { activeHost } from '../../lib/registration-db';
const staff=readSession(Astro.request);
if(!configured() || !staff) return Astro.redirect('/staff/',302);
if(staff.role==='host'){
  try { if(!await activeHost(staff.staffId)) return Astro.redirect('/staff/',302); }
  catch { return Astro.redirect('/staff/',302); }
}
---
<Base title="Voucher scanner | Four Dogs" description="Staff voucher scanner" noindex><section class="section"><div class="container"><h1>Scan a live voucher</h1><video playsinline muted autoplay style="width:min(100%,500px)"></video><p id="result" role="status"></p><button id="camera">Start camera</button><details><summary>Manual scan</summary><label>Live token <input id="manual"/></label><button id="redeem">Redeem</button></details></div></section>
<script>
import jsQR from 'jsqr';
const video=document.querySelector('video')!,canvas=document.createElement('canvas'),ctx=canvas.getContext('2d',{willReadFrequently:true})!;
const result=document.querySelector<HTMLElement>('#result')!;
let busy=false,last='',timer=0;
async function redeem(token:string){
 if(busy||!token)return;busy=true;last=token;
 try{const r=await fetch('/api/voucher/',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'redeem',token})});const data=await r.json();
 result.textContent=r.ok?'VALID. REWARD REDEEMED.':data.error;result.style.background=r.ok?'#126030':'#922121';result.style.color='white';result.style.padding='1rem';if(r.ok)navigator.vibrate?.(90);
 }catch{result.textContent='Connection lost. Scan again to verify.'}finally{setTimeout(()=>{busy=false},1200)}
}
async function start(){
 try{if(video.srcObject)return;video.srcObject=await navigator.mediaDevices.getUserMedia({video:{facingMode:{ideal:'environment'}},audio:false});await video.play();
 timer=window.setInterval(()=>{if(busy||!video.videoWidth)return;canvas.width=480;canvas.height=Math.round(480*video.videoHeight/video.videoWidth);ctx.drawImage(video,0,0,canvas.width,canvas.height);const pixels=ctx.getImageData(0,0,canvas.width,canvas.height);const qr=jsQR(pixels.data,pixels.width,pixels.height);if(!qr)last='';else if(qr.data!==last)redeem(qr.data)},200);
 }catch{result.textContent='Allow camera access and tap Start camera, or use Manual scan.'}
}
document.querySelector('#camera')!.addEventListener('click',start);document.querySelector('#redeem')!.addEventListener('click',()=>redeem(document.querySelector<HTMLInputElement>('#manual')!.value.trim()));start();
window.addEventListener('pagehide',()=>{clearInterval(timer);(video.srcObject as MediaStream|null)?.getTracks().forEach(t=>t.stop())});
</script></Base>