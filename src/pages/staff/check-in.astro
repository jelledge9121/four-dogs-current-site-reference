---
export const prerender=false;
import Base from '../../layouts/Base.astro';
---
<Base title="Four Dogs Host Check-in" description="Private mobile event check-in for Four Dogs hosts." noindex>
<section class="section dark"><div class="container"><p class="eyebrow">Four Dogs staff</p><h1>Host check-in</h1><p class="lead">Find the group, verify the code, check them in, hand over the physical reward.</p></div></section>
<section class="section"><div class="container"><div class="host-console">
<div class="host-toolbar"><a href="/staff/owner/" id="owner-link" hidden>Owner dashboard</a><button id="staff-signout" class="staff-link" type="button">Sign out</button></div>
<div class="host-card">
<label for="host-event">Your assigned event</label><select id="host-event"><option value="">Choose your event</option></select>
<p id="host-event-info" class="fine"></p>
<div class="host-stats" aria-live="polite"><div><strong id="host-registered">0</strong><span>Registered groups</span></div><div><strong id="host-expected">0</strong><span>Expected people</span></div><div><strong id="host-checked">0</strong><span>Checked-in groups</span></div><div><strong id="host-actual">0</strong><span>Checked-in people</span></div></div>
</div>
<div class="host-card">
<h2>Verify a registration</h2>
<label for="host-search">Confirmation code or name</label>
<div class="host-search"><input id="host-search" placeholder="FDE-… or registered name" autocomplete="off" autocapitalize="characters"/><button id="host-find" class="button" type="button">Find group</button></div>
<div id="host-results" aria-live="polite"></div>
<div id="host-match" class="host-match" hidden>
<h3 id="host-match-name"></h3>
<p id="host-match-details"></p>
<p id="host-match-status"></p>
<button id="host-checkin" class="button" type="button">Check in and issue reward</button>
</div>
<p id="host-message" role="status" aria-live="polite"></p>
</div>
<p class="fine">Your confirmation code is identification, not a coupon. Issue a physical appetizer coupon or raffle ticket only after a successful server-verified check-in. A code can be checked in only once.</p>
</div></div></section>
<style>
.host-console{max-width:760px}
.host-toolbar{display:flex;gap:22px;justify-content:flex-end;align-items:center;margin-bottom:1rem}
.staff-link{border:0;background:transparent;color:#13617a;text-decoration:underline;font:inherit;cursor:pointer}
.host-card{background:#fff;border:1px solid #c6cdd3;border-radius:6px;padding:clamp(16px,3vw,24px);margin-bottom:1.2rem}
.host-card h2{margin:0 0 .6rem;font-size:1.4rem}
.host-card label{font-weight:700;display:block;margin-bottom:.45rem}
.host-card input,.host-card select{font:inherit;padding:.9rem;border:1px solid #66748c;background:white;color:#132035;border-radius:4px;min-height:50px;box-sizing:border-box;width:100%}
.host-search{display:flex;gap:10px;align-items:stretch}
.host-search input{flex:1;min-width:0}.host-search button{min-height:50px}
.host-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:18px 0 5px}
.host-stats div{background:#f2f6f6;padding:13px 8px;text-align:center;display:grid;gap:4px}
.host-stats strong{font-size:1.55rem}.host-stats span{font-size:.79rem;color:#3c4b5d}
.host-match{padding:18px;border:1px solid #8ab7be;background:#eef7f6;margin-top:15px}
.host-match h3{font-size:1.2rem;margin:0 0 5px}.host-match p{margin:5px 0 12px}
.host-match button{width:100%;min-height:57px;font-size:1.05rem;margin-top:6px}
#host-results button{display:block;width:100%;text-align:left;border:1px solid #bac5ce;background:#f9faf9;padding:12px;margin:8px 0;color:#182438;cursor:pointer;font:inherit}
#host-message{font-weight:700}
@media(max-width:560px){.host-stats{grid-template-columns:repeat(2,1fr)}.host-search{flex-direction:column}.host-search button{width:100%}}
</style>
<script>
type Reg = {id:string;name:string;groupSize:number;teamName:string|null;code:string;reward:'appetizer'|'raffle'|'none';checkedInAt:string|null;rewardIssued:boolean};
type EventOption={id:string;title:string;venue:string;date:string;dateLabel:string;startTime:string};
let events:EventOption[]=[];
let registrations:Reg[]=[];
let current:Reg|null=null;
const byId=(id:string)=>document.getElementById(id)!;
const select=byId('host-event') as HTMLSelectElement;
const finder=byId('host-search') as HTMLInputElement;
const message=byId('host-message');
const matches=byId('host-results');
const detail=byId('host-match');
const checkButton=byId('host-checkin') as HTMLButtonElement;
async function loadJSON(url:string,options?:RequestInit){
 const r=await fetch(url,options);const d=await r.json();
 if(r.status===401){location.assign('/staff/');throw Error('Sign-in required')}
 if(!r.ok)throw Error(d.error||'The check-in request failed.');
 return d;
}
const post=(value:unknown)=>loadJSON('/api/staff/',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(value)});
async function loadEvents(){
 try{
  const data=await loadJSON('/api/staff/?mode=events');
  events=data.events;
  byId('owner-link').hidden=data.role!=='owner';
  for(const event of events){
    const option=document.createElement('option');option.value=event.id;
    option.textContent=event.dateLabel+' · '+event.startTime+' · '+event.venue;
    select.append(option);
  }
  const today=new Intl.DateTimeFormat('en-CA',{timeZone:'America/New_York',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
  select.value=events.find(e=>e.date===today)?.id||events[0]?.id||'';
  if(select.value)await loadRegistrations();
  else message.textContent='No assigned events yet. Ask the owner to add your event.';
 }catch(error){message.textContent=error instanceof Error?error.message:'Events unavailable.'}
}
async function loadRegistrations(){
 current=null;detail.hidden=true;matches.replaceChildren();finder.value='';
 const item=events.find(e=>e.id===select.value);
 byId('host-event-info').textContent=item?item.title+' · '+item.venue+' · '+item.dateLabel+' at '+item.startTime+' Eastern':'';
 if(!select.value)return;
 try{
  const data=await loadJSON('/api/staff/?mode=registrations&eventId='+encodeURIComponent(select.value));
  registrations=data.registrations;
  byId('host-registered').textContent=data.totals.registeredGroups;
  byId('host-expected').textContent=data.totals.expectedPeople;
  byId('host-checked').textContent=data.totals.checkedInGroups;
  byId('host-actual').textContent=data.totals.checkedInPeople;
  message.textContent='';
 }catch(error){message.textContent=error instanceof Error?error.message:'Registrations unavailable.'}
}
function showMatch(reg:Reg){
 current=reg;detail.hidden=false;
 byId('host-match-name').textContent=reg.name;
 byId('host-match-details').textContent=reg.groupSize+(reg.groupSize===1?' person':' people')
   +(reg.teamName?' · Team: '+reg.teamName:'')+' · '+reg.code;
 const reward=reg.reward==='appetizer'?'ONE physical appetizer coupon':reg.reward==='raffle'?'ONE physical extra raffle ticket':'No reward';
 byId('host-match-status').textContent=reg.checkedInAt?'ALREADY CHECKED IN. Do not issue another reward.':'Not checked in. Reward: '+reward;
 checkButton.disabled=!!reg.checkedInAt;
 checkButton.textContent=reg.checkedInAt?'Already checked in':'Check in and issue '+(reg.reward==='appetizer'?'appetizer coupon':reg.reward==='raffle'?'raffle ticket':'no reward');
 detail.scrollIntoView({behavior:'smooth',block:'nearest'});
}
async function findGroup(){
 matches.replaceChildren();detail.hidden=true;current=null;
 const term=finder.value.trim();
 if(!term){message.textContent='Enter a name or confirmation code.';return}
 try{
  message.textContent='';
  if(/^FDE-/i.test(term)){
   const data=await loadJSON('/api/staff/?mode=verify&eventId='+encodeURIComponent(select.value)+'&code='+encodeURIComponent(term));
   showMatch(data.registration);return;
  }
  const found=registrations.filter(r=>r.name.toLocaleLowerCase().includes(term.toLocaleLowerCase())).slice(0,15);
  if(!found.length){message.textContent='No matching registered group for this event.';return}
  for(const reg of found){
    const button=document.createElement('button');button.type='button';
    button.textContent=reg.name+' · '+reg.groupSize+' people · '+(reg.checkedInAt?'Checked in':'Not checked in');
    button.addEventListener('click',()=>showMatch(reg));matches.append(button);
  }
  if(found.length===1)showMatch(found[0]);
 }catch(error){message.textContent=error instanceof Error?error.message:'Code verification failed.'}
}
select.addEventListener('change',loadRegistrations);
byId('host-find').addEventListener('click',findGroup);
finder.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();findGroup()}});
checkButton.addEventListener('click',async()=>{
 if(!current||!select.value)return;
 checkButton.disabled=true;message.textContent='Verifying and saving check-in…';
 try{
  const r=await post({action:'checkin',eventId:select.value,code:current.code});
  message.textContent='Verified and checked in. '+(r.checkin.reward==='appetizer'?'Give ONE physical appetizer coupon.':r.checkin.reward==='raffle'?'Give ONE extra physical raffle ticket.':'No physical reward applies.');
  const verifiedName=current.name;
  await loadRegistrations();
  finder.value=verifiedName;
 }catch(error){message.textContent=error instanceof Error?error.message:'Check-in failed.';checkButton.disabled=false}
});
byId('staff-signout').addEventListener('click',async()=>{try{await post({action:'logout'})}finally{location.assign('/staff/')}});
loadEvents();
</script>
</Base>
