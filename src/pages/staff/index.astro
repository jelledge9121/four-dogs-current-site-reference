---
export const prerender=false;
import Base from '../../layouts/Base.astro';
---
<Base title="Four Dogs Staff Sign In" description="Private staff sign in for Four Dogs event check-in." noindex>
<section class="section dark"><div class="container"><p class="eyebrow">Four Dogs staff</p><h1>Event check-in</h1><p class="lead">Private access for Four Dogs hosts and management.</p></div></section>
<section class="section"><div class="container"><div class="staff-login">
<form id="staff-login">
 <h2>Sign in</h2>
 <label for="staff-username">Username</label><input id="staff-username" name="username" autocomplete="username" required maxlength="64" />
 <label for="staff-password">Password</label><input id="staff-password" name="password" type="password" autocomplete="current-password" required />
 <button class="button" type="submit">Sign in securely</button>
 <p id="staff-status" role="status" aria-live="polite"></p>
 <p class="fine">Four Dogs staff only. Never share host passwords or confirmation-code lists with venue employees.</p>
</form></div></div></section>
<style>
.staff-login{max-width:450px}.staff-login form{display:grid;gap:.85rem}
.staff-login input{font:inherit;padding:.9rem;border:1px solid #68748a;background:white;color:#142238;border-radius:4px;width:100%;box-sizing:border-box}
.staff-login label{font-weight:700}.staff-login button{margin-top:10px;min-height:48px}
</style>
<script>
const form=document.querySelector<HTMLFormElement>('#staff-login');
form?.addEventListener('submit',async event=>{
 event.preventDefault();
 const status=document.getElementById('staff-status')!;
 const button=form.querySelector<HTMLButtonElement>('button')!;
 button.disabled=true;status.textContent='Signing in…';
 const data=new FormData(form);
 try{
  const response=await fetch('/api/staff/',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'login',username:data.get('username'),password:data.get('password')})});
  const result=await response.json();
  if(!response.ok)throw new Error(result.error||'Could not sign in.');
  location.assign(result.role==='owner'?'/staff/owner/':'/staff/check-in/');
 }catch(error){status.textContent=error instanceof Error?error.message:'Sign-in unavailable.';button.disabled=false}
});
</script>
</Base>
