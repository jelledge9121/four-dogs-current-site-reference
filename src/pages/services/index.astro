---
import Base from '../../layouts/Base.astro'; import {services} from '../../data/services';
---
<Base title="Entertainment Services | Four Dogs Entertainment" description="Explore Four Dogs trivia, Music Bingo, karaoke, weddings, private and corporate entertainment, and original game experiences."><section class="section dark"><div class="container"><p class="eyebrow">Services</p><h1>One team. A lot of ways to bring people together.</h1></div></section>{services.map((s,i)=><section class={`section ${i%2?'alt':''}`}><div class="container split"><div><p class="eyebrow">Experience {String(i+1).padStart(2,'0')}</p><h2>{s.name}</h2><p class="lead">{s.summary}</p><p>{s.description}</p><div class="actions"><a class="button" href={`/services/${s.slug}/`}>Learn more</a><a href={`/booking/?service=${encodeURIComponent(s.bookingValue)}`}>Book this experience →</a></div></div><img src={s.slug==='weddings'?'/images/wedding.jpg':'/images/hero.jpg'} alt={`A Four Dogs ${s.name} experience`} loading="lazy"></div></section>)}</Base>
