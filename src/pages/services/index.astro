---
import Base from '../../layouts/Base.astro'; import {services, servicePhotos} from '../../data/services';
---
<Base title="Entertainment Services | Four Dogs Entertainment" description="Explore Four Dogs trivia, Music Bingo, karaoke, wedding DJs, photo booth rentals starting at $450, private and corporate entertainment, and original game experiences.">
<section class="section dark"><div class="container"><p class="eyebrow">Services</p><h1>Different ways to give people a reason to come together.</h1><p class="lead">Choose the Four Dogs experience that fits your people, your room, and your occasion.</p></div></section>
{services.map((s,i)=><section class={`section ${i%2?'alt':''}`}><div class="container split"><div><h2>{s.name}</h2><p class="lead">{s.summary}</p><p>{s.description}</p><div class="actions"><a class="button" href={s.slug === 'weddings' ? '/weddings/' : `/services/${s.slug}/`}>Learn more</a><a href={`/booking/?service=${encodeURIComponent(s.bookingValue)}`}>Book this experience →</a></div></div><img src={servicePhotos[s.slug].src} alt={servicePhotos[s.slug].alt} loading="lazy"></div></section>)}
<section class="section dark"><div class="container"><h2>Bring your people. We’ll bring the Doggone Good Time.</h2><div class="actions"><a class="button" href="/booking/">Book Four Dogs</a><a class="button secondary" href="/events/">Find an event</a></div></div></section>
</Base>
