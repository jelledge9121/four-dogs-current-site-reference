---
import Base from '../../layouts/Base.astro'; import {services} from '../../data/services';
---
<Base title="Entertainment Services | Four Dogs Entertainment" description="Explore Four Dogs trivia, Music Bingo, karaoke, weddings, private and corporate entertainment, and original game experiences.">
<section class="section dark"><div class="container"><p class="eyebrow">Services</p><h1>Different ways to give people a reason to come together.</h1><p class="lead">Choose the Four Dogs experience that fits your people, your room, and your occasion.</p></div></section>
{services.map((s,i)=><section class={`section ${i%2?'alt':''}`}><div class="container split"><div><p class="eyebrow">Experience {String(i+1).padStart(2,'0')}</p><h2>{s.name}</h2><p class="lead">{s.summary}</p><p>{s.description}</p><div class="actions"><a class="button" href={`/services/${s.slug}/`}>Learn more</a><a href={`/booking/?service=${encodeURIComponent(s.bookingValue)}`}>Book this experience →</a></div></div><img src={s.slug==='weddings'?'/images/wedding.jpg':'/images/hero.jpg'} alt={`A Four Dogs ${s.name} experience`} loading="lazy"></div></section>)}
<section class="section dark"><div class="container"><h2>Bring your people. We’ll bring the Doggone Good Time.</h2><div class="actions"><a class="button" href="/booking/">Book Four Dogs</a><a class="button secondary" href="/events/">Find an event</a></div></div></section>
</Base>
