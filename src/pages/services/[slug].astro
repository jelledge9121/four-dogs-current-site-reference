      { question: 'Where can I see upcoming Survey Showdown dates?', answer: 'Check the Four Dogs Events page for scheduled public events.' },
    ],
    related: [
      { label: 'Upcoming events', href: '/events/' },
      { label: 'Private & corporate events', href: '/services/private-corporate-events/' },
      { label: 'For venue owners', href: '/for-venues/' },
      { label: 'Columbia entertainment', href: '/areas/columbia-sc/' },
    ],
    reviewId: 'arif-charter-803-business-owner',
  },
  'are-you-smarter-than-a-barstool': {
    title: 'Are You Smarter Than a Barstool? | Four Dogs Entertainment',
    description: 'Are You Smarter Than a Barstool? is a Four Dogs school-subject-inspired trivia and game-night experience for venues, companies, private events, and communities.',
