    ],
    audiences: ['Rehearsal dinners', 'Engagement parties', 'Wedding weekends', 'Wedding showers', 'Couples and wedding parties', 'Friends and family gatherings'],
    includes: ['Customized couple questions', 'Professional hosting', 'Story-driven rounds', 'Planning around supplied couple details', 'An interactive alternative or addition to traditional wedding-weekend entertainment'],
    faqs: [
      { question: 'Is the trivia customized to the couple?', answer: 'Yes. The experience is built from information and stories supplied during planning.' },
      { question: 'When can Almost Married Trivia be used?', answer: 'It can work for rehearsal dinners, engagement parties, showers, wedding weekends, and other pre-wedding gatherings.' },
      { question: 'Can it be combined with other Four Dogs wedding entertainment?', answer: 'Yes. Couples can discuss combining it with wedding DJ or other Four Dogs entertainment depending on the event schedule.' },
    ],
    related: [
      { label: 'Wedding entertainment', href: '/weddings/' },
      { label: 'Wedding DJ in Columbia', href: '/wedding-dj-columbia-sc/' },
