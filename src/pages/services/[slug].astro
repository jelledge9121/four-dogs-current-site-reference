  },
};

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props as Props;
const detail = details[service.slug];
const review = detail.reviewId ? reviews.find((item) => item.id === detail.reviewId) : undefined;
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  description: detail.description,
  provider: { '@type': 'Organization', name: 'Four Dogs Entertainment', url: 'https://4dogsentertainment.com' },
  areaServed: ['Lexington, South Carolina', 'Columbia, South Carolina', 'South Carolina Midlands'],
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: detail.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---
<Base title={detail.title} description={detail.description} schema={[serviceSchema, faqSchema]}>
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Services', href: '/services/' }, { name: service.name }]} />

  <section class="section dark">
    <div class="container">
      <p class="eyebrow">Four Dogs experience</p>
      <h1>{service.name}</h1>
      <p class="lead">{service.summary}</p>
      <div class="actions">
        <a class="button" href={`/booking/?service=${encodeURIComponent(service.bookingValue)}`}>Book {service.name}</a>
        <a class="button secondary" href="/events/">Find an event</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="prose">{detail.intro.map((paragraph) => <p>{paragraph}</p>)}</div>
      <img src={service.slug === 'weddings' || service.slug === 'almost-married-trivia-experience' ? '/images/wedding.jpg' : '/images/hero.jpg'} alt={`Guests enjoying ${service.name} with Four Dogs Entertainment`} loading="lazy" />
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <p class="eyebrow">Who it works for</p>
      <h2>Built around the group in the room.</h2>
      <div class="grid">{detail.audiences.map((audience) => <article class="card"><h3>{audience}</h3></article>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">What Four Dogs provides</p>
        <h2>A hosted experience from planning through the event.</h2>
      </div>
      <ul>{detail.includes.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  {review && (
    <section class="section alt">
      <div class="container">
        <p class="eyebrow">Real feedback</p>
        <h2>What people say about Four Dogs.</h2>
        <figure class="testimonial">
          <blockquote><p>“{review.excerpts.homepage}”</p></blockquote>
          <figcaption><strong>{review.name}</strong><br />{review.title}</figcaption>
        </figure>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <p class="eyebrow">Frequently asked questions</p>
      <h2>What to know before you book.</h2>
      <div class="prose">{detail.faqs.map((faq) => <section><h3>{faq.question}</h3><p>{faq.answer}</p></section>)}</div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <p class="eyebrow">Related Four Dogs pages</p>
      <h2>Keep exploring.</h2>
      <div class="grid">{detail.related.map((link) => <a class="card" href={link.href}><h3>{link.label}</h3><p>Learn more →</p></a>)}</div>
    </div>
  </section>

  <section class="section dark">
    <div class="container">
      <h2>Bring your people. We’ll bring the Doggone Good Time.</h2>
      <p>Tell us about your date, location, group, and the kind of experience you want to create.</p>
      <a class="button" href={`/booking/?service=${encodeURIComponent(service.bookingValue)}`}>Book {service.name}</a>
    </div>
  </section>
</Base>
