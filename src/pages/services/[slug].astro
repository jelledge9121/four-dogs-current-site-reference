  },
  'music-bingo': {
    title: 'Music Bingo in Columbia & Lexington SC | Four Dogs Entertainment',
    description: 'Four Dogs Entertainment provides hosted Music Bingo for bars, restaurants, private events, companies, communities, and celebrations throughout Columbia, Lexington, and the South Carolina Midlands.',
    intro: [
