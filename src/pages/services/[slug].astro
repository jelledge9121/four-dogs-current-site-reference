    intro: [
      'Four Dogs Survey Showdown turns the room into teams competing to identify popular survey answers in a familiar, fast-moving game-show-style format.',
      'It is designed for participation and works for recurring venue nights, companies, private groups, and community events. Four Dogs Survey Showdown is a Four Dogs experience and is not affiliated with Family Feud.',
    ],
    audiences: ['Bars and restaurants', 'Companies and organizations', 'Private parties', 'Communities', 'Public game nights', 'Groups that want team competition'],
