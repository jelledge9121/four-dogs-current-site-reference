---
import Base from '../../layouts/Base.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import EventCard from '../../components/EventCard.astro'; import {venues} from '../../data/venues'; import {eventsForVenue} from '../../data/events'; export function getStaticPaths(){return venues.map(venue=>({params:{slug:venue.slug},props:{venue}}))} const {venue}=Astro.props; const events=eventsForVenue(venue.id);
---
<Base title={`${venue.name} Four Dogs Events | ${venue.city}, SC`} description={`${venue.description} See the weekly schedule and upcoming Four Dogs events at ${venue.name}.`}><Breadcrumbs items={[{name:'Home',href:'/'},{name:'Events',href:'/events/'},{name:venue.name}]}/><section class="section dark"><div class="container"><p class="eyebrow">Four Dogs venue</p><h1>{venue.name}</h1><p class="lead">{venue.address}<br>{venue.city}, {venue.state} {venue.zip}</p></div></section><section class="section alt"><div class="container"><h2>Play every week</h2><div class="grid">{venue.weeklySchedule.map(s=><article class="card"><p class="eyebrow">{s.day}</p><h3>{s.format}</h3><p>{s.time}</p></article>)}</div></div></section><section class="section"><div class="container"><h2>Coming up here</h2>{events.length?<div class="grid">{events.map(e=><EventCard event={e}/>)}</div>:<p>No dated themes are currently listed. The weekly schedule above remains the place to start.</p>}<div class="actions"><a class="button" href={venue.mapUrl} target="_blank" rel="noopener noreferrer">Directions</a><a href="/events/">All events</a></div></div></section></Base>
