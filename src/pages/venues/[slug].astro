---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VenuePhoto from '../../components/VenuePhoto.astro';
import venuePhotos from '../../data/venue-photos.json';
import EventList from '../../components/EventList.astro';
import { venues } from '../../data/venues';
import { eventsForVenue } from '../../data/events';
import { wescoThursdayNotice, showWescoNotice } from '../../data/announcements';
const venue=venues.find(v=>v.slug===Astro.params.slug);
if(!venue) return new Response('Venue not found',{status:404});
const upcoming=eventsForVenue(venue.id);
const formats=[...new Set(upcoming.map(e=>e.eventType))];
const photos = venuePhotos[venue.id as keyof typeof venuePhotos] || [];
const title=venue.active ? `Four Dogs Events at ${venue.name}, ${venue.city} SC` : `Past Four Dogs Music Bingo at ${venue.name}, ${venue.city} SC`;
const description=venue.active
  ? `Find confirmed Four Dogs dates at ${venue.name} in ${venue.city}, South Carolina. Event times, themes, admission information, and directions.`
  : `Four Dogs hosted a limited-run Music Bingo series at ${venue.name} in ${venue.city}, South Carolina, during October and November 2026. See past events and current Columbia entertainment.`;
const schema={'@context':'https://schema.org','@type':'Place',name:venue.name,url:new URL(Astro.url.pathname,'https://4dogsentertainment.com').href,address:{'@type':'PostalAddress',streetAddress:venue.address,addressLocality:venue.city,addressRegion:venue.state,postalCode:venue.zip,addressCountry:'US'}};
---
<Base title={title} description={description} schema={schema}>
<Breadcrumbs items={[{name:'Home',href:'/'},{name:'Events',href:'/events/'},{name:venue.name}]}/>
<section class="section dark"><div class="container"><p class="eyebrow">{venue.active ? 'Four Dogs venue' : 'Past Four Dogs event location'}</p><h1>{venue.name}</h1><p class="lead">{venue.address}<br/>{venue.city}, {venue.state} {venue.zip}</p><p>{venue.description}</p>{venue.id==='wesco' && showWescoNotice() && <p class="event-update" role="note">{wescoThursdayNotice}</p>}</div></section>
{venue.active ? (
  <>
<section class="section"><div class="container"><h2>Coming up here</h2><p>{formats.length?`Current confirmed formats: ${formats.join(', ')}.`:'New public dates will appear when confirmed.'} Check the individual event for its exact time and participation details.</p><EventList venue={venue.id} limit={12} days={60}/><div class="actions"><a class="button" href={venue.mapUrl} target="_blank" rel="noopener noreferrer">Directions</a>{venue.website && <a href={venue.website} target="_blank" rel="noopener noreferrer">Venue website →</a>}<a href={`/events/?venue=${venue.id}`}>Full venue calendar</a></div></div></section>
<section class="section alt"><div class="container prose"><h2>Before you come</h2><h3>When does Four Dogs start?</h3><p>Each confirmed date has its own start time. Schedule exceptions and special events appear in the calendar above.</p><h3>Is admission free?</h3><p>Admission depends on the event. Open the date you plan to attend for free admission details, ticket links, or reservation instructions.</p><h3>Do I need a reservation?</h3><p>Check your event page for registration and seating instructions before attending.</p><h3>What if the schedule changes?</h3><p>Check the event page before heading out for any cancellations or updated dates.</p><a href={`/areas/${venue.areaSlug}/`}>More entertainment in the {venue.city} area →</a></div></section>

  </>
) : (
  <section class="section">
    <div class="container prose">
      <h2>The Music Bingo trial has ended.</h2>
      <p>Four Dogs hosted four Music Bingo nights at Aura Kitchen &amp; Bar on October 22, October 29, November 5, and November 12, 2026. We are not currently hosting events at this location.</p>
      <p>Looking for a game night? See <a href="/events/">confirmed upcoming Four Dogs events</a> or explore <a href="/music-bingo-columbia-sc/">Music Bingo in Columbia</a>.</p>
      <p><a href={`/events/?view=archive&venue=${venue.id}`}>View the four past event listings</a></p>
    </div>
  </section>
)}

{photos.length > 0 && (
  <section class="section" aria-labelledby="venue-gallery-heading">
    <div class="container">
      <h2 id="venue-gallery-heading">Game nights at {venue.name}</h2>
      <div class="gallery-feature"><VenuePhoto photo={photos[0]} /></div>
      <details class="venue-gallery">
        <summary>See {photos.length - 1} more photos from {venue.name}</summary>
        <div class="venue-photo-grid">{photos.slice(1).map(photo => <VenuePhoto photo={photo} />)}</div>
      </details>
    </div>
  </section>
)}
<style>
  .gallery-feature { max-width:32rem; }
  .venue-gallery summary { min-height:44px; padding-block:1rem; font-weight:700; }
  .venue-photo-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,17rem),1fr)); gap:1.5rem; align-items:start; }
</style>
</Base>
