---
import Base from '../layouts/Base.astro'; import ReviewCard from '../components/ReviewCard.astro'; import EventCard from '../components/EventCard.astro'; import {upcomingEvents} from '../data/events'; import {venues} from '../data/venues'; import {services} from '../data/services'; import {gallery} from '../data/gallery'; import {site} from '../data/site'; import {featuredReviews} from '../data/reviews';
const upcoming=upcomingEvents().slice(0,6); const org={'@context':'https://schema.org','@type':'Organization',name:site.name,url:site.url,logo:`${site.url}/images/logo.png`,sameAs:[site.facebook,site.instagram]};
---
<Base title="Four Dogs Entertainment | Events, Weddings & Game Nights" description="Find a Four Dogs event or book hosted entertainment for your venue, wedding, company, community, or private celebration in South Carolina." schema={org}><section class="hero"><div class="container"><p class="eyebrow">Four Dogs Entertainment</p><h1>Entertainment Built to <span>Bring People Together</span></h1><p>Trivia, Music Bingo, interactive game nights, weddings, karaoke, private events, and corporate entertainment across South Carolina.</p><div class="actions"><a class="button" href="/events/">Find an event</a><a class="button secondary" href="/booking/">Book Four Dogs</a></div></div></section><section class="section alt"><div class="container"><p class="eyebrow">This week with Four Dogs</p><h2>Play every week</h2><div class="grid">{venues.map(v=>v.weeklySchedule.map(s=><article class="card"><p class="eyebrow">{s.day}</p><h3>{v.name}</h3><p>{s.format}<br><strong>{s.time}</strong><br>{v.city}</p></article>))}</div>{upcoming.length>0&&<><h2 style="margin-top:3rem">Coming up</h2><div class="grid">{upcoming.map(event=><EventCard event={event}/>)}</div></>}</div></section><section class="section"><div class="container"><p class="eyebrow">Who are you planning for?</p><h2>There’s a Four Dogs path for your people.</h2><div class="grid">{[['Bar & restaurant owners','/for-venues/'],['Brides & couples','/weddings/'],['Businesses & organizations','/services/private-corporate-events/'],['Private parties & communities','/services/private-corporate-events/'],['People looking for something fun','/events/']].map(x=><a class="card" href={x[1]}><h3>{x[0]}</h3><p>Explore your options →</p></a>)}</div></div></section><section class="section dark"><div class="container"><p class="eyebrow">Four Dogs experiences</p><h2>Pick your kind of night.</h2><div class="grid">{services.map(s=><article class="card"><h3>{s.name}</h3><p>{s.summary}</p><a href={`/services/${s.slug}/`}>Explore {s.name} →</a></article>)}</div></div></section><section class="section"><div class="container"><p class="eyebrow">Real events</p><h2>Good nights look like this.</h2><div class="gallery">{gallery.slice(0,6).map(p=><figure><img src={p.src} alt={p.alt} loading="lazy" width="800" height="600"><figcaption>{p.category}</figcaption></figure>)}</div><a class="button" href="/gallery/">See the gallery</a></div></section><section class="section alt"><div class="container"><p class="eyebrow">From a venue partner</p><h2>Built on collaboration.</h2>{featuredReviews[0] && <ReviewCard review={featuredReviews[0]} excerpt="homepage" />}</div></section><section class="section alt"><div class="container split"><div><p class="eyebrow">For venues</p><h2>Turn a slow night into a local tradition.</h2><p>Recurring hosted entertainment gives customers a reason to put your venue on their weekly calendar.</p><a class="button" href="/for-venues/">See the venue model</a></div><img src="/images/hero.jpg" alt="Guests gathered for a Four Dogs venue event" loading="lazy"></div></section><section class="section dark"><div class="container"><p class="eyebrow">Follow the pack</p><h2>See where Four Dogs goes next.</h2><div class="actions"><a class="button" href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram</a><a class="button secondary" href={site.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></div></div></section><section class="section"><div class="container"><h2>Bring Four Dogs to your next night.</h2><div class="actions"><a class="button" href="/events/">Find an event</a><a class="button secondary" style="color:var(--navy)" href="/booking/">Book Four Dogs</a></div></div></section></Base>
