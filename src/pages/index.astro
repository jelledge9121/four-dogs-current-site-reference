---
export const prerender = false;
import Base from '../layouts/Base.astro';
import ReviewCard from '../components/ReviewCard.astro';
import EventCard from '../components/EventCard.astro';
import { upcomingEvents } from '../data/events';
import { services } from '../data/services';
import { gallery } from '../data/gallery';
import { site } from '../data/site';
import { wescoThursdayNotice, showWescoNotice, wescoBingoUrl } from '../data/announcements';
import { guestReviews, venueOwnerReview } from '../data/reviews';
const upcoming = upcomingEvents().slice(0,3);
// Curated across six real event types, rather than six items from the gallery's source order.
const homePhotoPaths = [
  '/images/gallery/four-dogs-trivia-friends-long-table.webp',
  '/images/gallery/music-bingo-charter-friends.webp',
  '/images/gallery/four-dogs-wedding-ceremony-crowd.webp',
  '/images/gallery/four-dogs-karaoke-wesco-duet.webp',
  '/images/gallery/four-dogs-private-event-dance-floor-02-poster.webp',
  '/images/gallery/four-dogs-survey-showdown-bozes-group.jpg',
];
const homepageGallery = homePhotoPaths.flatMap((src) => gallery.filter((item) => item.type === 'image' && item.src === src));
const org = {'@context':'https://schema.org','@type':'Organization','@id':site.url+'/#organization',name:site.name,url:site.url,logo:`${site.url}/images/logo.png`,sameAs:[site.facebook,site.instagram,site.tiktok,site.meetup],areaServed:[{'@type':'State',name:'South Carolina'},{'@type':'State',name:'North Carolina'},{'@type':'State',name:'Georgia'}]};
---
<Base title="Trivia, Music Bingo & DJ Entertainment in SC, NC & GA | Four Dogs" description="Find Four Dogs trivia, Music Bingo, and local events in Lexington, Columbia, West Columbia, Cayce, and Fountain Inn. Book DJs, weddings, and private entertainment in South Carolina, North Carolina, and Georgia." schema={org}>
<section class="home-intro">
  <div class="container home-intro-grid">
    <div class="home-intro-copy">
      <p class="home-location">Four Dogs Entertainment · South Carolina</p>
      <h1>Bring your people. <span>We’ll bring the Doggone Good Time.</span></h1>
      <p class="lead">Meet your team for trivia or sing along at Music Bingo in the Midlands and Fountain Inn. Planning your own party? We bring the music and games to you.</p>
      <div class="actions"><a class="button" href="/events/">Find a public show</a><a class="button secondary" href="/booking/">Book entertainment</a></div>
      <a class="venue-intent" href="/for-venues/" data-event-action="venue_partnership_cta">Explore a weekly venue partnership <span aria-hidden="true">→</span></a>
    </div>
    <figure class="home-intro-photo">
      <img src="/images/optimized/home-crowd-960.webp" srcset="/images/optimized/home-crowd-480.webp 480w, /images/optimized/home-crowd-800.webp 800w, /images/optimized/home-crowd-960.webp 960w, /images/optimized/home-crowd-1440.webp 1440w" sizes="(max-width:800px) calc(100vw - 32px), 46vw" width="2048" height="1542" alt="Friends at Four Dogs Survey Showdown at Boze’s, holding their team sign and prize" fetchpriority="high"/>
      <figcaption>Survey Showdown at Boze’s · West Columbia, SC</figcaption>
    </figure>
  </div>
</section>
<section class="section home-upcoming" aria-labelledby="upcoming-title">
  <div class="container">
    <div class="section-heading" data-fd-reveal><div><h2 id="upcoming-title">Your next night out.</h2></div><a class="text-action" href="/events/">See the full calendar →</a></div>
    {upcoming.length ? <div class="event-list">{upcoming.map(event=><EventCard event={event}/>)}</div> : <p>No upcoming public dates are currently confirmed. <a href="/events/">Check the calendar</a> for updates.</p>}
    {showWescoNotice() && <aside class="calendar-note"><strong>Thursday at WesCo</strong><p>{wescoThursdayNotice} <a href={wescoBingoUrl}>See WesCo Music Bingo dates</a></p></aside>}
  </div>
</section>
<section class="section alt home-services">
  <div class="container">
    <div class="section-heading"><div><h2>What are you planning?</h2><p>Weddings, private parties and company events in South Carolina, North Carolina, and Georgia.</p></div></div>
    <div class="planning-links">
      <a href="/weddings/"><strong>Your wedding</strong><span>Ceremony music, introductions and a dance floor for your people.</span></a>
      <a href="/services/private-corporate-events/"><strong>A party or company event</strong><span>Pick music and games that work for the people in the room.</span></a>
      <a href="/for-venues/"><strong>A weekly night at your venue</strong><span>Give regulars a standing invitation. We bring the host and run the game.</span></a>
    </div>
    <details class="experience-index"><summary>Explore entertainment and Four Dogs original games</summary>
    <p><a href="/services/">All entertainment</a></p>
    <div class="service-directory">{services.filter(s=>!s.featured).map(s=><a data-fd-reveal href={s.slug==='weddings'?'/weddings/':`/services/${s.slug}/`}><h3>{s.name}</h3><p>{s.summary}</p><span aria-hidden="true">→</span></a>)}<a data-fd-reveal href="/dj-services-columbia-sc/"><h3>DJ entertainment</h3><p>Music and hosting for parties, communities, and celebrations.</p><span aria-hidden="true">→</span></a></div>
    <section class="original-games"><h2>Four Dogs original games</h2><div class="service-directory">{services.filter(s=>s.featured).map(s=><a data-fd-reveal href={`/services/${s.slug}/`}><h3>{s.name}</h3><p>{s.summary}</p><span aria-hidden="true">→</span></a>)}</div></section>
    </details>
  </div>
</section>
<section class="section">
  <div class="container"><div class="section-heading" data-fd-reveal><h2>Photos from Four Dogs events</h2><a class="text-action" href="/gallery/">See the gallery →</a></div><div class="home-photo-grid">{homepageGallery.map(photo=><figure data-fd-reveal><img src={photo.src} srcset={photo.srcSet} sizes={photo.srcSet ? "(max-width:800px) 50vw, (max-width:1212px) 33vw, 380px" : undefined} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async"/><figcaption>{photo.title}</figcaption></figure>)}</div></div>
</section>
<section class="section alt home-reviews">
  <div class="container">
    <h2 data-fd-reveal>What guests and partners say</h2>
    {guestReviews[0] && <ReviewCard review={guestReviews[0]} excerpt="homepage"/>}
    <details class="more-reviews">
      <summary>Read more reviews</summary>
      <div class="review-grid">{guestReviews.slice(1).map(review => (
        <article class="review-card" data-fd-reveal>
          <p class="review-quote">“{review.excerpts.homepage}”</p>
          <p class="review-attribution"><strong>{review.name}</strong><br/>{review.title}</p>
        </article>
      ))}</div>
      {venueOwnerReview && <ReviewCard review={venueOwnerReview} excerpt="homepage"/>}
    </details>
  </div>
</section>
<section class="local-ownership" aria-label="Local ownership">
  <div class="container local-ownership-inner">
    <p>Proudly locally owned and operated in South Carolina.</p>
    <img src="/images/badges/american-operator-locally-owned.png" alt="Locally Owned &amp; Operated, Certified by American Operator" width="450" height="76" loading="lazy" decoding="async" />
  </div>
</section>
<style>
  .local-ownership { padding: 2.25rem 0; background: #fff; border-block: 1px solid #edf0f2; }
  .local-ownership-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .local-ownership p { margin: 0; font-size: clamp(1rem, 1.5vw, 1.2rem); font-weight: 750; }
  .local-ownership img { display: block; width: min(100%, 360px); height: auto; }
  @media (max-width: 650px) {
    .local-ownership-inner { justify-content: center; text-align: center; }
  }
</style>
<section class="section home-local"><div class="container split"><div><h2>Find game nights near you</h2><p>Choose your area for local trivia, Music Bingo and upcoming shows.</p></div><div class="local-links"><a href="/areas/lexington-sc/">Lexington</a><a href="/areas/columbia-sc/">Columbia</a><a href="/areas/west-columbia-cayce-sc/">West Columbia & Cayce</a><a href="/areas/irmo-chapin-sc/">Irmo & Chapin</a><a href="/areas/fountain-inn-sc/">Fountain Inn</a><a href="/trivia-nights-columbia-lexington-sc/">Local trivia nights</a><a href="/music-bingo-columbia-lexington-sc/">Local Music Bingo</a></div></div></section>
<section class="section alt" id="four-dogs-song"><div class="container split"><div><h2>The Four Dogs Entertainment Song</h2></div><div><audio style="width:100%" controls preload="none" src="/audio/four-dogs-song.mp3">Your browser does not support the audio player.</audio><p><a href="/bury-me-in-garnet/">Hear Bury Me in Garnet, our Gamecock fan song series →</a></p></div></div></section>
<section class="section dark"><div class="container split"><div><h2>Plan your event</h2><p>Tell us your date, your people, and what you have in mind.</p><div class="actions"><a class="button fd-booking-button" href="/booking/">Book Four Dogs</a><a class="button secondary" href="/events/">Find an event</a></div></div><div><h3>Follow the pack.</h3><div class="social-links"><a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram</a><a href={site.facebook} target="_blank" rel="noopener noreferrer">Facebook</a><a href={site.tiktok} target="_blank" rel="noopener noreferrer">TikTok</a><a href={site.meetup} target="_blank" rel="noopener noreferrer">Meetup</a></div><p><button class="button secondary" type="button" data-pack-open>Get event text updates</button></p></div></div></section>
</Base>
