---
export const prerender = false;
import Base from '../layouts/Base.astro';
import EventList from '../components/EventList.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { localSeoPages, type LocalSeoPage } from '../data/localSeoPages';
import { reviews } from '../data/reviews';

type Props = { page: LocalSeoPage };

const page=localSeoPages.find(p=>p.slug===Astro.params.localSeo);
if(!page) return new Response('Page not found',{status:404});
const eventCity=page.slug.includes('lexington') && page.slug.includes('columbia') ? ['Lexington','Columbia'] : page.slug.includes('lexington') ? 'Lexington' : page.slug.includes('columbia') ? 'Columbia' : undefined;
const eventCategory=page.slug.includes('music-bingo') ? 'Music Bingo' : page.slug.includes('trivia') ? 'Trivia' : undefined;
const review = page.reviewId ? reviews.find((item) => item.id === page.reviewId) : undefined;
const seoTitle = page.slug === 'music-bingo-columbia-lexington-sc'
  ? 'Music Bingo in Columbia & Lexington SC | Local Guide | Four Dogs'
  : page.title;
const seoImage = page.slug.includes('wedding') ? {
  src: '/images/weddings/wedding-reception-guests-dancing.webp',
  alt: 'Guests enjoying the dance floor at a Four Dogs wedding reception',
  caption: 'A real Four Dogs wedding reception',
} : page.slug.includes('music-bingo') ? {
  src: '/images/gallery/music-bingo-charter-friends.webp',
  alt: 'Friends playing Four Dogs Music Bingo at Charter 803',
  caption: 'Four Dogs Music Bingo at Charter 803',
} : page.slug.includes('trivia') ? {
  src: '/images/venues/four-dogs-top-dawg-trivia-crowd-2026.webp',
  alt: 'Trivia teams playing a Four Dogs event at Top Dawg Tavern',
  caption: 'A trivia night at Top Dawg Tavern',
} : page.slug.includes('corporate') || page.slug.includes('private') ? {
  src: '/images/gallery/four-dogs-private-event-dance-floor-02-poster.webp',
  alt: 'Guests on the dance floor at a Four Dogs private event',
  caption: 'Guests at a Four Dogs private event',
} : {
  src: '/images/gallery/four-dogs-survey-showdown-bozes-group.jpg',
  alt: 'Four Dogs Survey Showdown guests at Boze’s in West Columbia',
  caption: 'Four Dogs at Boze’s in West Columbia',
};
const holidayEligible = [
  'private-event-dj-midlands-sc',
  'corporate-event-entertainment-columbia-sc',
  'dj-services-columbia-sc',
  'dj-services-lexington-sc',
].includes(page.slug);
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: page.h1,
  description: page.description,
  provider: {
    '@type': 'Organization',
    name: 'Four Dogs Entertainment',
    url: 'https://4dogsentertainment.com',
  },
  areaServed: ['South Carolina', 'Lexington, South Carolina', 'Columbia, South Carolina'],
};
---
<Base title={seoTitle} description={page.description} schema={[serviceSchema, faqSchema]}>
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: page.h1 }]} />

  <section class="section dark">
    <div class="container">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.h1}</h1>
      <p class="lead">{page.lead}</p>
      <div class="actions">
        <a class="button" href={`/booking/?service=${encodeURIComponent(page.bookingValue)}`}>Book Four Dogs</a>
        <a class="button secondary" href="/events/">Find an event</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="prose">
        {page.intro.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <figure class="local-seo-photo">
        <img src={seoImage.src} alt={seoImage.alt} loading="lazy" decoding="async" />
        <figcaption>{seoImage.caption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {eventCategory ? <>
        <h2>Find a confirmed {eventCategory} night.</h2>
        <EventList city={eventCity} category={eventCategory}/>
        <a href="/events/">Browse the full calendar →</a>
      </> : <>
        <h2>See Four Dogs at real events.</h2>
        <p>Browse the photos and videos before you ask us about your own date.</p>
        <div class="actions"><a href="/gallery/">See our gallery →</a><a href="/events/">View current public events →</a></div>
      </>}
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <p class="eyebrow">What Four Dogs provides</p>
      <h2>What to expect.</h2>
      <ul class="local-seo-highlights">
        {page.highlights.map((highlight) => <li>{highlight}</li>)}
      </ul>
    </div>
  </section>

  {holidayEligible && (
    <section class="section">
      <div class="container holiday-callout">
        <p class="eyebrow">Planning a holiday event?</p>
        <h2>Looking for traditional holiday magic too?</h2>
        <p>Pair Four Dogs entertainment with a traditional real-beard Santa Jim appearance for company parties, private celebrations, HOA events, community gatherings, and mixed-age holiday crowds.</p>
        <div class="actions">
          <a class="button" href="/christmas/">Explore Christmas & Santa Jim</a>
          <a href="/booking/?service=Christmas%20%2F%20Holiday%20Entertainment">Plan a holiday event →</a>
        </div>
      </div>
    </section>
  )}

  {review && (
    <section class="section">
      <div class="container">
        <p class="eyebrow">Real feedback</p>
        <h2>What people say after a Four Dogs event.</h2>
        <figure class="testimonial">
          <blockquote><p>“{review.excerpts.homepage}”</p></blockquote>
          <figcaption><strong>{review.name}</strong><br />{review.title}</figcaption>
        </figure>
      </div>
    </section>
  )}

  <section class="section alt">
    <div class="container">
      <p class="eyebrow">Frequently asked questions</p>
      <h2>Helpful details before you plan your night.</h2>
      <div class="prose">
        {page.faqs.map((faq) => (
          <section>
            <h3>{faq.question}</h3>
            <p>{faq.answer}</p>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Keep exploring</p>
      <h2>More about the options.</h2>
      <nav class="local-seo-related" aria-label="Related local entertainment pages">
        {page.relatedLinks.map((link) => <a href={link.href}>{link.label}<span aria-hidden="true">→</span></a>)}
      </nav>
    </div>
  </section>

  <section class="section dark">
    <div class="container">
      <h2>Bring your people. We’ll bring the Doggone Good Time.</h2>
      <p>Tell us what you are planning and we will help identify the right Four Dogs format.</p>
      <a class="button" href={`/booking/?service=${encodeURIComponent(page.bookingValue)}`}>Plan your event</a>
    </div>
  </section>
  <style>
    .local-seo-photo { margin: 0; }
    .local-seo-photo img { width:100%; display:block; aspect-ratio:4/3; object-fit:cover; }
    .local-seo-photo figcaption { margin-top:.6rem; font-size:.9rem; color:var(--muted); }
    .local-seo-highlights { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0 2rem; padding:0; list-style:none; border-top:1px solid var(--rule); }
    .local-seo-highlights li { padding:1rem .2rem; border-bottom:1px solid var(--rule); font-weight:650; }
    .local-seo-related { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0 2rem; border-top:1px solid var(--rule); }
    .local-seo-related a { display:flex; justify-content:space-between; gap:1rem; padding:1rem .1rem; border-bottom:1px solid var(--rule); font-weight:700; text-decoration:none; }
    .local-seo-related a:hover { text-decoration:underline; }
    @media(max-width:650px){ .local-seo-highlights,.local-seo-related { grid-template-columns:1fr; } }
  </style>
</Base>
