---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Thanks | Four Dogs Entertainment" description="Thank you for contacting Four Dogs Entertainment." noindex>
  <section class="section dark">
    <div class="container">
      <h1>Thanks for reaching out!</h1>
      <p class="lead">You're one step closer to a Doggone Good Time.</p>
      <p>If you've just sent an inquiry, we'll use your preferred contact details to talk through your plans and availability. An inquiry is not a confirmed booking.</p>
      <p>Need to add a detail? Email <a href={`mailto:${site.bookingEmail}`}>{site.bookingEmail}</a>.</p>
      <a class="button" href="/events/">Find your next night out</a>
      <p><a href="/">Back home</a></p>
    </div>
  </section>
</Base>
