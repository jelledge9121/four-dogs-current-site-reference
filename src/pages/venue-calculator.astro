---
import Base from '../layouts/Base.astro';
---
<Base title="Trivia & Music Bingo Venue Calculator | Four Dogs" description="A planning calculator for venue operators considering a recurring Four Dogs trivia or Music Bingo night."><section class="section dark"><div class="container"><p class="eyebrow">Fun tools for venues</p><h1>Venue Calculator</h1><p class="lead">Think through traffic, guest spend, food and drink cost, labor, prizes, and event fees. This is a conversation starter—not a guarantee.</p></div></section><section class="section alt"><div class="container calculator split"><form id="calculator"><h2>Your estimates</h2><label>Expected guests <input type="number" name="guests" min="0" value="48"></label><label>Average guest spend ($) <input type="number" name="spend" min="0" step=".01" value="25"></label><label>Food and drink cost (%) <input type="number" name="costPercent" min="0" max="100" value="30"></label><label>Extra labor cost ($) <input type="number" name="labor" min="0" step=".01" value="200"></label><label>Prize cost ($) <input type="number" name="prizes" min="0" step=".01" value="50"></label><label>Four Dogs event fee ($) <input type="number" name="fee" min="0" step=".01" value="150"></label><label>Frequency <select name="frequency"><option value="52">Weekly</option><option value="104">Twice weekly</option><option value="12">Monthly</option></select></label></form><section class="card" aria-live="polite"><p class="eyebrow">Estimated result</p><h2 id="net">$440</h2><p>Estimated net per event after the entered costs.</p><dl><dt>Gross sales</dt><dd id="gross">$1,200</dd><dt>Estimated cost</dt><dd id="cost">$760</dd><dt>Monthly equivalent</dt><dd id="monthly">$1,907</dd><dt>Yearly equivalent</dt><dd id="yearly">$22,880</dd></dl><p class="fine">Estimates are not promised revenue, profit, attendance, or ROI. Actual results and costs vary.</p><a class="button" href="/booking/?service=Venue%20Entertainment">Ask about a test night</a></section></div></section>
<script>
const form=document.querySelector<HTMLFormElement>('#calculator'); const money=new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0});
function update(){if(!form)return;const data=new FormData(form);const n=(k:string)=>Number(data.get(k))||0;const gross=n('guests')*n('spend');const cost=gross*n('costPercent')/100+n('labor')+n('prizes')+n('fee');const net=gross-cost;const yearly=net*n('frequency');const values:{[key:string]:number}={gross,cost,net,monthly:yearly/12,yearly};for(const [id,value] of Object.entries(values))document.querySelector(`#${id}`)!.textContent=money.format(value)}form?.addEventListener('input',update);update();
</script></Base>
