---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---
<Base title="Venue Event Planning Calculator | Four Dogs" description="Estimate the sales and costs you enter for a recurring entertainment night. Four Dogs does not publish venue fees or promise attendance, revenue, or profit.">
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'For Venues', href: '/for-venues/' }, { name: 'Venue Calculator' }]} />
  <section class="section dark">
    <div class="container">
      <p class="eyebrow">Plan a weekly venue night</p>
      <h1>Venue Calculator</h1>
      <p class="lead">Use your own estimates to think through sales, food and drink cost, labor, prizes, and the entertainment quote you receive.</p>
      <p>This tool does not include a Four Dogs rate. Enter a quote privately in your browser; nothing is saved or sent.</p>
    </div>
  </section>
  <section class="section alt">
    <div class="container calculator-layout">
      <form id="calculator" aria-describedby="calculator-note">
        <h2>Your estimates</h2>
        <label>Expected guests <input type="number" name="guests" min="0" value="48" inputmode="numeric"></label>
        <label>Average guest spend ($) <input type="number" name="spend" min="0" step=".01" value="25" inputmode="decimal"></label>
        <label>Food and drink cost (%) <input type="number" name="costPercent" min="0" max="100" value="30" inputmode="decimal"></label>
        <label>Extra labor cost ($) <input type="number" name="labor" min="0" step=".01" value="200" inputmode="decimal"></label>
        <label>Prize cost ($) <input type="number" name="prizes" min="0" step=".01" value="50" inputmode="decimal"></label>
        <label>Your quoted entertainment fee ($) <input type="number" name="fee" min="0" step=".01" placeholder="Enter your quote" inputmode="decimal"></label>
        <label>Frequency <select name="frequency"><option value="52">Weekly</option><option value="104">Twice weekly</option><option value="12">Monthly</option></select></label>
        <p class="fine" id="calculator-note">Estimates run only in this page. They are not saved or submitted with a venue inquiry.</p>
      </form>
      <section class="card calculator-result" aria-live="polite" aria-atomic="true" aria-labelledby="calculator-result-title">
        <p class="eyebrow">Estimated result</p>
        <h2 id="calculator-result-title">$590</h2>
        <p id="net-note">Estimated net before your quoted entertainment fee.</p>
        <dl>
          <dt>Gross sales</dt><dd id="gross">$1,200</dd>
          <dt>Estimated costs</dt><dd id="cost">$610</dd>
          <dt>Monthly equivalent</dt><dd id="monthly">$2,557</dd>
          <dt>Yearly equivalent</dt><dd id="yearly">$30,680</dd>
        </dl>
        <p class="fine">This is a planning estimate, not promised attendance, revenue, profit, or return on investment. Actual results and costs vary.</p>
        <a class="button" data-event-action="venue_partnership_cta" href="/booking/?service=Venue%20Entertainment">Discuss a weekly partnership</a>
        <p class="fine"><a href="/for-venues/">See venue examples and compare formats.</a></p>
      </section>
    </div>
  </section>
  <script>
    const form=document.querySelector<HTMLFormElement>('#calculator');
    const money=new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0});
    function update(){
      if(!form)return;
      const data=new FormData(form);
      const n=(key:string)=>Number(data.get(key))||0;
      const gross=n('guests')*n('spend');
      const fee=n('fee');
      const cost=gross*n('costPercent')/100+n('labor')+n('prizes')+fee;
      const net=gross-cost;
      const yearly=net*n('frequency');
      const values:{[key:string]:number}={gross,cost,net,monthly:yearly/12,yearly};
      for(const [id,value] of Object.entries(values)){
        const target=document.querySelector<HTMLElement>(`#${id==='net'?'calculator-result-title':id}`);
        if(target)target.textContent=money.format(value);
      }
      const note=document.querySelector<HTMLElement>('#net-note');
      if(note)note.textContent=fee>0?'Estimate includes the entertainment fee you entered.':'Estimated net before your quoted entertainment fee.';
    }
    form?.addEventListener('input',update);
    update();
  </script>
  <style>
    .calculator-layout { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,.9fr); gap:2rem; align-items:start; }
    #calculator { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
    #calculator h2,#calculator-note { grid-column:1/-1; }
    #calculator label { min-width:0; }
    .calculator-result { position:sticky; top:6.5rem; }
    .calculator-result h2 { font-size:clamp(2rem,4vw,3rem); margin:.3rem 0; }
    .calculator-result dl { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:.4rem 1rem; }
    .calculator-result dt,.calculator-result dd { border-bottom:1px solid var(--rule); margin:0; padding:.5rem 0; }
    .calculator-result dd { font-weight:800; font-variant-numeric:tabular-nums; }
    @media(max-width:800px) { .calculator-layout { grid-template-columns:1fr; } .calculator-result { position:static; } }
    @media(max-width:520px) { #calculator { grid-template-columns:1fr; } #calculator h2,#calculator-note { grid-column:auto; } }
  </style>
</Base>
