---
import Base from '../layouts/Base.astro';
---
<Base title="Bury Me in Garnet | South Carolina Gamecock Fan Songs | Four Dogs Entertainment" description="Listen to the original Bury Me in Garnet Gamecock fan songs and the latest Florida and Kentucky editions. An original South Carolina football music series by Four Dogs Entertainment.">
  <div class="bmig">
    <section class="bmig-hero" aria-labelledby="bmig-heading">
      <div class="bmig-inner bmig-hero-grid">
        <div>
          <p class="bmig-kicker">FOUR DOGS ENTERTAINMENT PRESENTS · THE GAMECOCK FAN SONG SERIES</p>
          <h1 id="bmig-heading">Bury Me<br>in <em>Garnet.</em></h1>
          <p class="bmig-intro">For the fans who swear they're done on Saturday and find themselves right back at Williams-Brice the next week.</p>
          <div class="bmig-tags"><span class="bmig-new">NEW · FLORIDA EDITION</span><span>Three songs. One familiar feeling.</span></div>
          <a class="bmig-hero-link" href="#listen">Hear the latest edition ↓</a>
        </div>
        <div class="bmig-record" role="img" aria-label="Bury Me in Garnet album-style artwork showing vinyl record grooves in dark garnet and cream">
          <span class="bmig-cover-eyebrow">AN ORIGINAL FOUR DOGS MUSIC SERIES</span>
          <div class="bmig-vinyl"><span></span></div>
          <span class="bmig-cover-name">BURY ME<br><em>IN GARNET</em></span>
          <span class="bmig-cover-foot">THE SONGS OF SATURDAY</span>
        </div>
      </div>
    </section>
    <section class="bmig-music" id="listen" aria-labelledby="bmig-listen">
      <div class="bmig-inner">
        <div class="bmig-section-head">
          <div><p class="bmig-kicker">THE MUSIC</p><h2 id="bmig-listen">Pick a Saturday. Press play.</h2></div>
          <p>Free to listen · Full-length tracks · No account needed</p>
        </div>
        <div class="bmig-listening" data-bmig>
          <section class="bmig-player" aria-label="Full length music player">
            <div class="bmig-player-top"><span>NOW PLAYING</span><span class="bmig-sound">♪ THE LATEST EDITION</span></div>
            <div class="bmig-player-main">
              <span class="bmig-artist">Bury Me in Garnet</span>
              <h3 data-title>Florida Edition</h3>
              <p data-subtitle>October 10, 2026 · Gamecock football</p>
              <div class="bmig-embed">
                <iframe data-bmig-frame title="Suno player for Bury Me in Garnet Florida Edition" src="https://suno.com/embed/889f70df-b662-4115-a5cb-2c58faa77315" allow="autoplay; encrypted-media" loading="eager" referrerpolicy="strict-origin-when-cross-origin"></iframe>
              </div>
              <p class="bmig-player-note">Choose a song, then press play in the embedded player.</p>
              <div class="bmig-extras"><button type="button" class="bmig-share" data-share>Share this series ↗</button></div>
              <p class="bmig-alert" role="status" data-status aria-live="polite"></p>
              <a class="bmig-suno" data-suno href="https://suno.com/song/889f70df-b662-4115-a5cb-2c58faa77315" target="_blank" rel="noopener noreferrer">Listen on Suno ↗</a>
            </div>
          </section>
          <aside class="bmig-tracks" aria-label="Choose an edition">
            <div class="bmig-tracks-heading"><h3>The tracklist</h3><p>Latest release first. Choose a song to listen.</p></div>
            <button type="button" data-track="0" class="bmig-track bmig-selected" aria-pressed="true"><span class="bmig-number">03</span><span class="bmig-tracktext"><strong>Florida Edition</strong><small>Still believing · Oct 10, 2026</small></span><span class="bmig-length">4:11</span></button>
            <button type="button" data-track="1" class="bmig-track" aria-pressed="false"><span class="bmig-number">02</span><span class="bmig-tracktext"><strong>Kentucky Edition</strong><small>Heartbreak in overtime · Oct 2026</small></span><span class="bmig-length">4:18</span></button>
            <button type="button" data-track="2" class="bmig-track" aria-pressed="false"><span class="bmig-number">01</span><span class="bmig-tracktext"><strong>The Original</strong><small>Where it started · Sep 26, 2026</small></span><span class="bmig-length">3:44</span></button>
            <div class="bmig-tracks-foot">Made for the fans who know exactly how this goes, and still show up next Saturday.<br><strong>Music by @djjoeyelledge</strong></div>
          </aside>
        </div>
      </div>
    </section>
    <section class="bmig-story">
      <div class="bmig-inner bmig-story-grid">
        <div><p class="bmig-kicker">THE STORY</p><h2>A love song to impossible optimism.</h2><p>Every new week brings a reason to believe. Every Saturday gives us another story. <strong>Bury Me in Garnet</strong> is an original country music series about the hope, heartbreak, and humor of being a South Carolina football fan.</p></div>
        <div class="bmig-cta"><strong>Know someone who needs this song?</strong><p>Send them the latest edition, and follow Four Dogs for the next chapter after the next game.</p><a href="https://www.tiktok.com/@4dogsentertainment" target="_blank" rel="noopener noreferrer">Follow on TikTok ↗</a><small>Independent fan-created music. Not affiliated with or endorsed by the University of South Carolina.</small></div>
      </div>
    </section>
  </div>
</Base>
<style is:global>
  .bmig{--bmig-garnet:#7d1734;--bmig-rose:#c63e60;--bmig-cream:#f7eee0;--bmig-ivory:#fffaf0;--bmig-dark:#141222;--bmig-gold:#edc690;font-family:Inter,system-ui,sans-serif;background:var(--bmig-dark);color:var(--bmig-cream)}
  .bmig *{box-sizing:border-box}.bmig button,.bmig input{font:inherit}.bmig-inner{width:min(1140px,calc(100% - 36px));margin:0 auto}
  .bmig h1,.bmig h2,.bmig h3{font-family:Georgia,serif;letter-spacing:-.035em;line-height:1.06}.bmig h2{font-size:clamp(2.2rem,4vw,3.5rem)}.bmig p{line-height:1.7}
  .bmig-kicker{font-size:.74rem!important;letter-spacing:.18em;font-weight:900;text-transform:uppercase;color:var(--bmig-gold);line-height:1.5!important}
  .bmig-hero{background:radial-gradient(ellipse at 83% 32%,#a72d4d69,transparent 42%),linear-gradient(135deg,#210d1a,#481026 52%,#191522);padding:clamp(64px,9vw,125px) 0;overflow:hidden}
  .bmig-hero-grid{display:grid;grid-template-columns:1.2fr .8fr;align-items:center;gap:clamp(32px,6vw,90px)}
  .bmig-hero h1{font-size:clamp(4.15rem,8vw,8rem);color:#fffaf1;margin:18px 0 22px}.bmig-hero h1 em{color:#ebacbb;font-weight:400;font-style:italic}
  .bmig-intro{font-size:clamp(1.05rem,1.8vw,1.35rem);max-width:540px;color:#efe3df}
  .bmig-tags{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin:26px 0;color:#ead1cb;font-size:.84rem}
  .bmig-new{background:#f1c791;color:#321528;border-radius:4px;padding:8px 11px;font-weight:900;letter-spacing:.06em;font-size:.72rem}
  .bmig-hero-link{display:inline-block;color:#fffaf0;text-underline-offset:5px;font-weight:800;margin-top:10px}
  .bmig-record{position:relative;aspect-ratio:1;border:1px solid #ffe4c656;border-radius:9px;box-shadow:0 30px 65px #0b071d9e, inset 0 0 85px #250b1d;background:radial-gradient(circle at 70% 15%,#c7797966,transparent 32%),linear-gradient(145deg,#751c38,#200e20 70%);overflow:hidden;padding:25px;display:flex;flex-direction:column;justify-content:space-between}
  .bmig-cover-eyebrow,.bmig-cover-foot{position:relative;z-index:1;font-size:.65rem;letter-spacing:.2em;font-weight:900;color:#f4d9b3}
  .bmig-cover-foot{text-align:right}.bmig-vinyl{position:absolute;width:92%;aspect-ratio:1;left:29%;top:13%;border-radius:50%;background:repeating-radial-gradient(circle at center,#19101d 0px,#251924 2px,#100d18 4px,#3a2730 5px);box-shadow:0 0 55px #0009}
  .bmig-vinyl span{position:absolute;inset:35%;border-radius:50%;background:#a3294b;border:9px solid #f1c994;box-shadow:0 0 0 6px #220d21}
  .bmig-cover-name{position:relative;z-index:1;font-size:clamp(1.7rem,3.7vw,3.5rem);line-height:1.08;font-family:Georgia,serif;font-weight:900;color:#fff9ef;text-shadow:0 3px 10px #160c1ae8}.bmig-cover-name em{font-weight:400;color:#f4c3c7}
  .bmig-music{padding:clamp(64px,8vw,100px) 0;background:var(--bmig-ivory);color:#201820}
  .bmig-music .bmig-kicker{color:var(--bmig-garnet)}.bmig-section-head{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:29px}
  .bmig-section-head h2{margin:4px 0}.bmig-section-head>p{margin:0 0 9px;color:#685764;font-size:.9rem}
  .bmig-listening{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(0,.98fr);gap:22px;align-items:stretch}
  .bmig-player{background:linear-gradient(160deg,#451227 0%,#1b1626 95%);border-radius:13px;box-shadow:0 22px 55px #1d0d2233;color:#fff6ed;overflow:hidden}
  .bmig-player-top{background:#ffffff12;padding:14px 25px;display:flex;gap:10px;justify-content:space-between;color:#f9d7b9;font-size:.72rem;letter-spacing:.12em;font-weight:850}
  .bmig-sound{color:#e6bca7}.bmig-player-main{padding:clamp(25px,4vw,42px)}
  .bmig-artist{font-size:.77rem;text-transform:uppercase;letter-spacing:.2em;color:#efbfaa}
  .bmig-player h3{font-size:clamp(2.5rem,4.4vw,4.1rem);color:white;margin:12px 0 8px}.bmig-player-main>p[data-subtitle]{margin:0 0 44px;color:#cabbc4}
  .bmig-timeline input{width:100%;accent-color:#f5c58d;cursor:pointer}.bmig-time{display:flex;justify-content:space-between;font-size:.79rem;color:#d6c2cb;margin-top:3px}
  .bmig-buttons{display:flex;align-items:center;justify-content:center;gap:25px;margin:24px 0}
  .bmig-buttons button{display:grid;place-items:center;width:46px;height:46px;background:#ffffff18;color:#fff;cursor:pointer;border:1px solid #ffffff22;border-radius:50%;transition:transform .2s}
  .bmig-buttons button:hover:not(:disabled){transform:scale(1.07)}.bmig-buttons button:disabled{opacity:.25;cursor:not-allowed}
  .bmig-buttons .bmig-primary{height:77px;width:77px;background:#f0c895;color:#311329;border:0}
  .bmig-buttons svg{height:24px;width:24px;fill:currentColor}.bmig-buttons .bmig-primary svg{height:34px;width:34px}
  .bmig-extras{display:flex;align-items:center;justify-content:space-between;gap:20px;border-top:1px solid #ffffff25;padding-top:19px}
  .bmig-extras label{font-size:.79rem;display:flex;align-items:center;gap:11px;color:#e3cdd0;white-space:nowrap}.bmig-extras input{width:90px;accent-color:#f3c68f}
  .bmig-share{background:transparent;border:0;color:#f6d5b1;text-decoration:underline;text-underline-offset:4px;cursor:pointer;font-size:.84rem}
  .bmig-alert{min-height:1.2em;color:#ffe4b1;font-size:.79rem;margin:12px 0 2px!important}
  .bmig-suno{font-size:.78rem;color:#e1bac3;text-underline-offset:3px}
  .bmig-tracks{background:white;border:1px solid #e9dfe2;box-shadow:0 15px 35px #2d1b1b12;border-radius:13px;overflow:hidden}
  .bmig-tracks-heading{padding:26px 28px 22px}.bmig-tracks h3{font-size:1.9rem;margin:0 0 4px}.bmig-tracks-heading p{margin:0;font-size:.84rem;color:#685f62}
  .bmig-track{display:flex;align-items:center;gap:16px;text-align:left;width:100%;padding:19px 24px;border:0;border-top:1px solid #e9e1e0;background:white;cursor:pointer;color:#2d1a26}
  .bmig-track:hover{background:#f9f1ef}.bmig-track.bmig-selected{background:#f9e7e7;border-left:5px solid #8c2045;padding-left:19px}
  .bmig-number{font-family:Georgia,serif;font-size:1.4rem;color:#9c6679}.bmig-tracktext{flex:1;display:grid;gap:3px}.bmig-tracktext strong{font-size:1.04rem}.bmig-tracktext small{font-size:.8rem;color:#796971}.bmig-length{font-size:.8rem;font-weight:800;color:#745b68}
  .bmig-tracks-foot{padding:25px 28px;background:#f8f4ed;color:#594954;font-size:.89rem;line-height:1.75}
  .bmig-story{padding:clamp(65px,7vw,100px) 0;background:#211526}.bmig-story-grid{display:grid;grid-template-columns:1fr .8fr;gap:70px}
  .bmig-story h2{color:#fffaf3}.bmig-story p{color:#e4d7d6}.bmig-cta{padding:32px;border:1px solid #c48c9c6b;border-radius:10px;background:#ffffff0a}
  .bmig-cta strong{font-family:Georgia,serif;font-size:1.6rem;color:#ffead7}.bmig-cta a{display:inline-block;background:#efc78f;color:#211526;text-decoration:none;border-radius:4px;font-weight:900;padding:12px 17px;margin:14px 0}
  .bmig-cta small{display:block;color:#cebcbc;font-size:.75rem;line-height:1.5}
  .bmig-visually-hidden{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
  .bmig :focus-visible{outline:3px solid #d79c52;outline-offset:4px}
  @media(max-width:850px){.bmig-hero-grid,.bmig-listening,.bmig-story-grid{grid-template-columns:1fr}.bmig-record{max-width:480px;justify-self:center;width:100%}.bmig-section-head{align-items:start;flex-direction:column}.bmig-hero{padding:58px 0}.bmig-story-grid{gap:20px}.bmig-hero h1{font-size:clamp(3.8rem,11vw,6rem)}}
  @media(max-width:520px){.bmig-inner{width:min(100% - 30px,1140px)}.bmig-record{max-width:360px}.bmig-tags{gap:9px}.bmig-player-top{font-size:.64rem;padding:12px 18px}.bmig-player-main{padding:25px 21px}.bmig-extras{gap:9px}.bmig-track{gap:10px;padding:17px 15px}.bmig-track.bmig-selected{padding-left:10px}.bmig-length{font-size:.75rem}.bmig-tracks-heading{padding:23px}.bmig-story{padding:60px 0}}
  @media(prefers-reduced-motion:reduce){.bmig *{scroll-behavior:auto!important;transition:none!important}}
</style>
<style is:global>
  .bmig-embed{width:100%;background:#fff3;border:1px solid #ffffff30;border-radius:12px;overflow:hidden;margin:27px 0 13px}
  .bmig-embed iframe{display:block;width:100%;height:220px;border:0;background:#281825;color:white}
  .bmig-player-note{font-size:.82rem!important;color:#dec7d2;margin:8px 0 22px!important}
  .bmig-extras{justify-content:end}
  @media(max-width:520px){.bmig-embed iframe{height:210px}}
</style>
<script is:inline>
(() => {
  const root = document.querySelector('[data-bmig]'); if (!root) return;
  const songs = [
    { title:'Florida Edition',sub:'October 10, 2026 · Gamecock football',id:'889f70df-b662-4115-a5cb-2c58faa77315' },
    { title:'Kentucky Edition',sub:'October 2026 · Gamecock football',id:'8358d720-39cd-41d6-8d3f-6204ccb40163' },
    { title:'The Original',sub:'September 26, 2026 · Where it started',id:'bc0ef21c-9db7-41da-a788-67abe51822c4' }
  ];
  const frame = root.querySelector('[data-bmig-frame]');
  const title = root.querySelector('[data-title]'), subtitle = root.querySelector('[data-subtitle]');
  const suno = root.querySelector('[data-suno]'), notice=root.querySelector('[data-status]');
  const rows=[...root.querySelectorAll('[data-track]')];
  function select(i){
    if(i<0||i>=songs.length)return;
    const song=songs[i];frame.src='https://suno.com/embed/'+song.id;
    frame.title='Suno player for Bury Me in Garnet '+song.title;
    title.textContent=song.title;subtitle.textContent=song.sub;
    suno.href='https://suno.com/song/'+song.id;notice.textContent='';
    rows.forEach((row,index)=>{row.classList.toggle('bmig-selected',index===i);row.setAttribute('aria-pressed',String(index===i));});
  }
  rows.forEach(row=>row.addEventListener('click',()=>select(Number(row.dataset.track))));
  root.querySelector('[data-share]').addEventListener('click',async()=>{
    const url='https://4dogsentertainment.com/bury-me-in-garnet/';
    try{if(navigator.share)await navigator.share({title:'Bury Me in Garnet',url});else if(navigator.clipboard?.writeText){await navigator.clipboard.writeText(url);notice.textContent='Link copied to clipboard.';}else notice.textContent=url;}
    catch(e){if(e.name!=='AbortError')notice.textContent=url;}
  });
})();
</script>
